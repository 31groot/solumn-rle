[70.521749, "o", "\u001b[?2004h> "]
[70.52203, "o", "    assert (result.credit, result.charge, result.net) == (\r\n\u001b[?2004l\r"]
[70.522088, "o", "\u001b[?2004h> "]
[70.522338, "o", "        Decimal('50.00'), Decimal('249.50'), Decimal('199.50')\r\n\u001b[?2004l\r"]
[70.52239, "o", "\u001b[?2004h> "]
[70.522429, "o", "    )\r\n\u001b[?2004l\r"]
[70.52247, "o", "\u001b[?2004h> "]
[70.522797, "o", "    invoice = build_change_invoice(sub, 'starter-m', date(2025, 5, 5))\r\n\u001b[?2004l\r"]
[70.522856, "o", "\u001b[?2004h> "]
[70.522997, "o", "    assert len(invoice.lines) == 2\r\n\u001b[?2004l\r"]
[70.523045, "o", "\u001b[?2004h> "]
[70.523201, "o", "    assert invoice.total == result.net\r\n\u001b[?2004l\r"]

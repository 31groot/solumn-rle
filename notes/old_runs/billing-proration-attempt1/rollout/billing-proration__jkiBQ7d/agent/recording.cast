[13.721612, "o", "\"\"\"Mid-cycle plan change proration. The rules are in BILLING_SPEC.md.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\nfrom datetime import date\r\nfrom decimal import ROUND_HALF_UP, Decimal\r\n\r\nfrom calendar_utils import actual_days, period_bounds\r\nfrom plans import ANNUAL, MONTHLY, PAISE, Plan, Subscription, get_plan\r\n\r\nPERIOD_MONTHS = {MONTHLY: 1, ANNUAL: 12}\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass ProrationResult:\r\n    customer_id: str\r\n    old_plan: str\r\n    new_plan: str\r\n    change_date: date\r\n    period_start: date\r\n    period_end: date  # exclusive\r\n    remaining_days: int\r\n    period_days: int\r\n    credit: Decimal  # unused value of the old plan, returned to the customer\r\n    charge: Decimal  # value of the new plan for the rest of the period\r\n    net: Decimal  # positive: customer owes; negative: goes to account balance\r\n\r\n\r\ndef billing_period(sub: Subscription, on: date) -> tuple[date, date]:\r\n    return period_bounds(sub.anchor_date, PERIOD_MONTHS[sub.plan.interval], on)\r\n\r\n\r"]
[13.721711, "o", "\ndef validate_change(old: Plan, new: Plan) -> None:\r\n    if old.code == new.code:\r\n        raise ValueError(f\"subscription is already on {old.code}\")\r\n    if old.interval != new.interval:\r\n        raise ValueError(\r\n            f\"cannot prorate {old.interval} -> {new.interval}; \"\r\n            \"interval changes take effect at renewal\"\r\n        )\r\n    if old.currency != new.currency:\r\n        raise ValueError(\"plans are priced in different currencies\")\r\n\r\n\r\ndef prorate_change(sub: Subscription, new_plan_code: str, change_date: date) -> ProrationResult:\r\n    \"\"\"Credit for the unused part of the current plan and charge for the new one.\"\"\"\r\n    old = sub.plan\r\n    new = get_plan(new_plan_code)\r\n    validate_change(old, new)\r\n\r\n    start, end = billing_period(sub, change_date)\r\n    remaining = actual_days(change_date, end)\r\n    total = actual_days(start, end)\r\n\r\n    credit = (old.price * remaining / total).quantize(PAISE, ROUND_HALF_UP)\r\n    charge = (new.price * remaining / total).quantize(PAISE, ROUND_HALF_UP)\r\n "]
[13.721778, "o", "   return ProrationResult(\r\n        customer_id=sub.customer_id,\r\n        old_plan=old.code,\r\n        new_plan=new.code,\r\n        change_date=change_date,\r\n        period_start=start,\r\n        period_end=end,\r\n        remaining_days=remaining,\r\n        period_days=total,\r\n        credit=credit,\r\n        charge=charge,\r\n        net=charge - credit,\r\n    )\r\n"]
[13.723165, "o", "\"\"\"Invoice assembly for renewals and mid-cycle plan changes.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date\r\nfrom decimal import Decimal\r\n\r\nfrom calendar_utils import format_period\r\nfrom plans import Subscription, get_plan\r\nfrom proration import ProrationResult, billing_period, prorate_change\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass InvoiceLine:\r\n    description: str\r\n    amount: Decimal\r\n\r\n\r\n@dataclass\r\nclass Invoice:\r\n    number: str\r\n    customer_id: str\r\n    issue_date: date\r\n    period_start: date\r\n    period_end: date  # exclusive\r\n    currency: str\r\n    lines: list[InvoiceLine] = field(default_factory=list)\r\n\r\n    @property\r\n    def total(self) -> Decimal:\r\n        return sum((line.amount for line in self.lines), Decimal(\"0.00\"))\r\n\r\n    def add(self, description: str, amount: Decimal) -> None:\r\n        self.lines.append(InvoiceLine(description, amount))\r\n\r\n    def render(self) -> str:\r\n        width = max([len(line.description) for line in self."]
[13.723241, "o", "lines] + [20])\r\n        out = [\r\n            f\"Invoice {self.number}\",\r\n            f\"Customer: {self.customer_id}    Issued: {self.issue_date:%d %b %Y}\",\r\n            f\"Service period: {format_period(self.period_start, self.period_end)}\",\r\n            \"\",\r\n        ]\r\n        out += [f\"{line.description:<{width}}  {line.amount:>12,.2f}\" for line in self.lines]\r\n        out += [\"-\" * (width + 14), f\"{'Total ' + self.currency:<{width}}  {self.total:>12,.2f}\"]\r\n        return \"\\n\".join(out)\r\n\r\n\r\ndef _invoice_number(kind: str, customer_id: str, on: date) -> str:\r\n    return f\"{kind}-{customer_id}-{on:%Y%m%d}\"\r\n\r\n\r\ndef build_period_invoice(sub: Subscription, on: date) -> Invoice:\r\n    \"\"\"Regular renewal invoice for the full billing period containing `on`.\"\"\"\r\n    plan = sub.plan\r\n    start, end = billing_period(sub, on)\r\n    inv = Invoice(\r\n        number=_invoice_number(\"REN\", sub.customer_id, start),\r\n        customer_id=sub.customer_id,\r\n        issue_date=start,\r\n        period_start=start,\r\n        period_end"]
[13.723288, "o", "=end,\r\n        currency=plan.currency,\r\n    )\r\n    inv.add(f\"{plan.name} subscription\", plan.price)\r\n    return inv\r\n\r\n\r\ndef change_lines(result: ProrationResult) -> list[InvoiceLine]:\r\n    \"\"\"Credit, charge and, when needed, a rounding line so the lines sum to result.net.\"\"\"\r\n    old, new = get_plan(result.old_plan), get_plan(result.new_plan)\r\n    days = f\"{result.remaining_days}/{result.period_days} days\"\r\n    lines = [\r\n        InvoiceLine(f\"Unused time on {old.name} ({days})\", -result.credit),\r\n        InvoiceLine(f\"Remaining time on {new.name} ({days})\", result.charge),\r\n    ]\r\n    drift = result.net - (result.charge - result.credit)\r\n    if drift:\r\n        lines.append(InvoiceLine(\"Rounding adjustment\", drift))\r\n    return lines\r\n\r\n\r\ndef build_change_invoice(sub: Subscription, new_plan_code: str, change_date: date) -> Invoice:\r\n    \"\"\"Invoice for switching plans part-way through the current billing period.\"\"\"\r\n    result = prorate_change(sub, new_plan_code, change_date)\r\n    inv = Invoice(\r\n        numb"]
[13.723329, "o", "er=_invoice_number(\"CHG\", sub.customer_id, change_date),\r\n        customer_id=sub.customer_id,\r\n        issue_date=change_date,\r\n        period_start=result.period_start,\r\n        period_end=result.period_end,\r\n        currency=sub.plan.currency,\r\n    )\r\n    inv.lines.extend(change_lines(result))\r\n    return inv\r\n"]

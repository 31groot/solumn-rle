[70.507673, "o", "def test_monthly_30_360_boundaries(anchor, change, remaining):\r\n\u001b[?2004l\r"]
[70.507698, "o", "\u001b[?2004h"]
[70.507722, "o", "> "]
[70.508118, "o", "    result = prorate_change(Subscription('monthly', 'starter-m', anchor), 'team-m', change)\r\n\u001b[?2004l\r"]
[70.508144, "o", "\u001b[?2004h"]
[70.508166, "o", "> "]
[70.508488, "o", "    assert (result.remaining_days, result.period_days) == (remaining, 30)\r\n\u001b[?2004l\r"]
[70.508512, "o", "\u001b[?2004h"]
[70.508533, "o", "> "]
[70.508969, "o", "    # These plans differ by exactly INR 1000, so this also checks the net fraction.\r\n\u001b[?2004l\r"]
[70.509053, "o", "\u001b[?2004h> "]
[70.509358, "o", "    expected_net = (Decimal(1000) * remaining / 30).quantize(Decimal('0.01'))\r\n\u001b[?2004l\r"]
[70.509421, "o", "\u001b[?2004h> "]
[70.509596, "o", "    assert result.net == expected_net\r\n\u001b[?2004l\r"]
[70.509673, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.509733, "o", "> \r\n\u001b[?2004l\r"]

[9.680055, "o", "\"\"\"Date helpers shared by invoicing and proration.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport calendar\r\nfrom datetime import date\r\n\r\n\r\ndef days_in_month(year: int, month: int) -> int:\r\n    return calendar.monthrange(year, month)[1]\r\n\r\n\r\ndef is_month_end(d: date) -> bool:\r\n    return d.day == days_in_month(d.year, d.month)\r\n\r\n\r\ndef clamp_to_month(year: int, month: int, day: int) -> date:\r\n    \"\"\"date(year, month, day), with day pulled back to the month's last day if needed.\"\"\"\r\n    return date(year, month, min(day, days_in_month(year, month)))\r\n\r\n\r\ndef add_months(d: date, months: int) -> date:\r\n    \"\"\"Shift d by whole months, clamping the day to the end of shorter months.\"\"\"\r\n    total = d.year * 12 + (d.month - 1) + months\r\n    year, month0 = divmod(total, 12)\r\n    return clamp_to_month(year, month0 + 1, d.day)\r\n\r\n\r\ndef period_bounds(anchor: date, months: int, on: date) -> tuple[date, date]:\r\n    \"\"\"Billing period containing `on` for periods of `months` months starting at anchor.\r\n\r\n    Returns (start, "]
[9.680132, "o", "end); end is exclusive and is the next period's start.\r\n    \"\"\"\r\n    if months <= 0:\r\n        raise ValueError(\"period length must be a positive number of months\")\r\n    if on < anchor:\r\n        raise ValueError(f\"{on} is before the subscription anchor {anchor}\")\r\n    start = anchor\r\n    while True:\r\n        end = add_months(start, months)\r\n        if on < end:\r\n            return start, end\r\n        start = end\r\n\r\n\r\ndef actual_days(start: date, end: date) -> int:\r\n    \"\"\"Calendar days from start (inclusive) to end (exclusive).\"\"\"\r\n    return (end - start).days\r\n\r\n\r\ndef format_period(start: date, end: date) -> str:\r\n    \"\"\"Human-readable service period, e.g. '10 Mar 2025 - 9 Apr 2025'.\"\"\"\r\n    last = date.fromordinal(end.toordinal() - 1)\r\n    return f\"{start.day} {start:%b %Y} - {last.day} {last:%b %Y}\"\r\n"]
[9.681405, "o", "\"\"\"Plan catalogue and subscription records.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass, replace\r\nfrom datetime import date\r\nfrom decimal import Decimal\r\n\r\nMONTHLY = \"monthly\"\r\nANNUAL = \"annual\"\r\nINTERVALS = (MONTHLY, ANNUAL)\r\nPAISE = Decimal(\"0.01\")\r\n\r\n\r\nclass UnknownPlanError(KeyError):\r\n    \"\"\"Raised when a plan code is not in the catalogue.\"\"\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Plan:\r\n    code: str\r\n    name: str\r\n    interval: str\r\n    price: Decimal  # charged once per billing period\r\n    currency: str = \"INR\"\r\n\r\n    def __post_init__(self) -> None:\r\n        if self.interval not in INTERVALS:\r\n            raise ValueError(f\"plan {self.code}: unknown interval {self.interval!r}\")\r\n        if self.price < 0 or self.price != self.price.quantize(PAISE):\r\n            raise ValueError(f\"plan {self.code}: price must be >= 0 with at most 2 decimals\")\r\n\r\n"]
[9.681494, "o", "\r\n_CATALOG: dict[str, Plan] = {\r\n    p.code: p\r\n    for p in (\r\n        Plan(\"lite-m\", \"Lite\", MONTHLY, Decimal(\"99.99\")),\r\n        Plan(\"starter-m\", \"Starter\", MONTHLY, Decimal(\"499.00\")),\r\n        Plan(\"team-m\", \"Team\", MONTHLY, Decimal(\"1499.00\")),\r\n        Plan(\"business-m\", \"Business\", MONTHLY, Decimal(\"4999.00\")),\r\n        Plan(\"starter-a\", \"Starter (annual)\", ANNUAL, Decimal(\"4990.00\")),\r\n        Plan(\"team-a\", \"Team (annual)\", ANNUAL, Decimal(\"14990.00\")),\r\n        Plan(\"business-a\", \"Business (annual)\", ANNUAL, Decimal(\"49990.00\")),\r\n    )\r\n}\r\n\r\n\r\ndef get_plan(code: str) -> Plan:\r\n    try:\r\n        return _CATALOG[code]\r\n    except KeyError:\r\n        raise UnknownPlanError(code) from None\r\n\r\n\r\ndef list_plans(interval: str | None = None) -> list[Plan]:\r\n    plans = [p for p in _CATALOG.values() if interval is None or p.interval == interval]\r\n    return sorted(plans, key=lambda p: (p.interval, p.price))\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Subscription:\r\n    \"\"\"A customer's subscription. Billing periods"]
[9.681545, "o", " repeat from anchor_date.\"\"\"\r\n\r\n    customer_id: str\r\n    plan_code: str\r\n    anchor_date: date\r\n\r\n    def __post_init__(self) -> None:\r\n        if not self.customer_id:\r\n            raise ValueError(\"customer_id is required\")\r\n        plan = get_plan(self.plan_code)\r\n        if plan.interval == ANNUAL and (self.anchor_date.month, self.anchor_date.day) == (2, 29):\r\n            raise ValueError(\"annual subscriptions cannot be anchored on 29 February\")\r\n\r\n    @property\r\n    def plan(self) -> Plan:\r\n        return get_plan(self.plan_code)\r\n\r\n    @property\r\n    def anchor_day(self) -> int:\r\n        return self.anchor_date.day\r\n\r\n    def with_plan(self, plan_code: str) -> \"Subscription\":\r\n        \"\"\"Same customer and billing anchor, different plan.\"\"\"\r\n        return replace(self, plan_code=plan_code)\r\n"]
[9.682977, "o", "\"\"\"Mid-cycle plan change proration. The rules are in BILLING_SPEC.md.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\nfrom datetime import date\r\nfrom decimal import ROUND_HALF_UP, Decimal\r\n\r\nfrom calendar_utils import actual_days, period_bounds\r\nfrom plans import ANNUAL, MONTHLY, PAISE, Plan, Subscription, get_plan\r\n\r\nPERIOD_MONTHS = {MONTHLY: 1, ANNUAL: 12}\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass ProrationResult:\r\n    customer_id: str\r\n    old_plan: str\r\n    new_plan: str\r\n    change_date: date\r\n    period_start: date\r\n    period_end: date  # exclusive\r\n    remaining_days: int\r\n    period_days: int\r\n    credit: Decimal  # unused value of the old plan, returned to the customer\r\n    charge: Decimal  # value of the new plan for the rest of the period\r\n    net: Decimal  # positive: customer owes; negative: goes to account balance\r\n\r\n\r\ndef billing_period(sub: Subscription, on: date) -> tuple[date, date]:\r\n    return period_bounds(sub.anchor_date, PERIOD_MONTHS[sub.plan.interval], on)\r\n\r\n\r"]
[9.683053, "o", "\ndef validate_change(old: Plan, new: Plan) -> None:\r\n    if old.code == new.code:\r\n        raise ValueError(f\"subscription is already on {old.code}\")\r\n    if old.interval != new.interval:\r\n        raise ValueError(\r\n            f\"cannot prorate {old.interval} -> {new.interval}; \"\r\n            \"interval changes take effect at renewal\"\r\n        )\r\n    if old.currency != new.currency:\r\n        raise ValueError(\"plans are priced in different currencies\")\r\n\r\n\r\ndef prorate_change(sub: Subscription, new_plan_code: str, change_date: date) -> ProrationResult:\r\n    \"\"\"Credit for the unused part of the current plan and charge for the new one.\"\"\"\r\n    old = sub.plan\r\n    new = get_plan(new_plan_code)\r\n    validate_change(old, new)\r\n\r\n    start, end = billing_period(sub, change_date)\r\n    remaining = actual_days(change_date, end)\r\n    total = actual_days(start, end)\r\n\r\n    credit = (old.price * remaining / total).quantize(PAISE, ROUND_HALF_UP)\r\n    charge = (new.price * remaining / total).quantize(PAISE, ROUND_HALF_UP)\r\n "]
[9.683088, "o", "   return ProrationResult(\r\n        customer_id=sub.customer_id,\r\n        old_plan=old.code,\r\n        new_plan=new.code,\r\n        change_date=change_date,\r\n        period_start=start,\r\n        period_end=end,\r\n        remaining_days=remaining,\r\n        period_days=total,\r\n        credit=credit,\r\n        charge=charge,\r\n        net=charge - credit,\r\n    )\r\n"]
[9.684322, "o", "\"\"\"Invoice assembly for renewals and mid-cycle plan changes.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date\r\nfrom decimal import Decimal\r\n\r\nfrom calendar_utils import format_period\r\nfrom plans import Subscription, get_plan\r\nfrom proration import ProrationResult, billing_period, prorate_change\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass InvoiceLine:\r\n    description: str\r\n    amount: Decimal\r\n\r\n\r\n@dataclass\r\nclass Invoice:\r\n    number: str\r\n    customer_id: str\r\n    issue_date: date\r\n    period_start: date\r\n    period_end: date  # exclusive\r\n    currency: str\r\n    lines: list[InvoiceLine] = field(default_factory=list)\r\n\r\n"]
[9.684405, "o", "    @property\r\n    def total(self) -> Decimal:\r\n        return sum((line.amount for line in self.lines), Decimal(\"0.00\"))\r\n\r\n    def add(self, description: str, amount: Decimal) -> None:\r\n        self.lines.append(InvoiceLine(description, amount))\r\n\r\n    def render(self) -> str:\r\n        width = max([len(line.description) for line in self.lines] + [20])\r\n        out = [\r\n            f\"Invoice {self.number}\",\r\n            f\"Customer: {self.customer_id}    Issued: {self.issue_date:%d %b %Y}\",\r\n            f\"Service period: {format_period(self.period_start, self.period_end)}\",\r\n"]
[9.684463, "o", "            \"\",\r\n        ]\r\n        out += [f\"{line.description:<{width}}  {line.amount:>12,.2f}\" for line in self.lines]\r\n        out += [\"-\" * (width + 14), f\"{'Total ' + self.currency:<{width}}  {self.total:>12,.2f}\"]\r\n        return \"\\n\".join(out)\r\n\r\n\r\ndef _invoice_number(kind: str, customer_id: str, on: date) -> str:\r\n    return f\"{kind}-{customer_id}-{on:%Y%m%d}\"\r\n\r\n\r\ndef build_period_invoice(sub: Subscription, on: date) -> Invoice:\r\n    \"\"\"Regular renewal invoice for the full billing period containing `on`.\"\"\"\r\n    plan = sub.plan\r\n    start, end = billing_period(sub, on)\r\n    inv = Invoice(\r\n        number=_invoice_number(\"REN\", sub.customer_id, start),\r\n        customer_id=sub.customer_id,\r\n        issue_date=start,\r\n        period_start=start,\r\n        period_end=end,\r\n        currency=plan.currency,\r\n    )\r\n    inv.add(f\"{plan.name} subscription\", plan.price)\r\n    return inv\r\n\r\n\r\ndef change_lines(result: ProrationResult) -> list[InvoiceLine]:\r\n    \"\"\"Credit, charge and, when needed, a rounding line"]
[9.684515, "o", " so the lines sum to result.net.\"\"\"\r\n    old, new = get_plan(result.old_plan), get_plan(result.new_plan)\r\n    days = f\"{result.remaining_days}/{result.period_days} days\"\r\n    lines = [\r\n        InvoiceLine(f\"Unused time on {old.name} ({days})\", -result.credit),\r\n        InvoiceLine(f\"Remaining time on {new.name} ({days})\", result.charge),\r\n    ]\r\n    drift = result.net - (result.charge - result.credit)\r\n    if drift:\r\n        lines.append(InvoiceLine(\"Rounding adjustment\", drift))\r\n    return lines\r\n\r\n\r\ndef build_change_invoice(sub: Subscription, new_plan_code: str, change_date: date) -> Invoice:\r\n    \"\"\"Invoice for switching plans part-way through the current billing period.\"\"\"\r\n    result = prorate_change(sub, new_plan_code, change_date)\r\n    inv = Invoice(\r\n        number=_invoice_number(\"CHG\", sub.customer_id, change_date),\r\n        customer_id=sub.customer_id,\r\n        issue_date=change_date,\r\n        period_start=result.period_start,\r\n        period_end=result.period_end,\r\n        currency=sub.plan.curr"]
[9.684552, "o", "ency,\r\n    )\r\n    inv.lines.extend(change_lines(result))\r\n    return inv\r\n"]
[9.68611, "o", "import sys\r\nfrom datetime import date\r\nfrom decimal import Decimal\r\nfrom pathlib import Path\r\n\r\nimport pytest\r\n\r\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\r\n\r\nfrom invoice import build_change_invoice, build_period_invoice  # noqa: E402\r\nfrom plans import Subscription, UnknownPlanError, get_plan  # noqa: E402\r\nfrom proration import prorate_change  # noqa: E402\r\n\r\n\r\ndef money(s):\r\n    return Decimal(s)\r\n\r\n\r\ndef test_catalogue_prices():\r\n    assert get_plan(\"starter-m\").price == money(\"499.00\")\r\n    assert get_plan(\"team-a\").price == money(\"14990.00\")\r\n    with pytest.raises(UnknownPlanError):\r\n        get_plan(\"enterprise-m\")\r\n\r\n\r\ndef test_renewal_invoice_is_full_price():\r\n    sub = Subscription(\"cus_0007\", \"team-m\", date(2025, 1, 10))\r\n    inv = build_period_invoice(sub, date(2025, 3, 22))\r\n    assert (inv.period_start, inv.period_end) == (date(2025, 3, 10), date(2025, 4, 10))\r\n    assert inv.total == money(\"1499.00\")\r\n    assert len(inv.lines) == 1\r\n\r\n\r\ndef test_same_plan_change_rejected():\r"]
[9.686201, "o", "\n    sub = Subscription(\"cus_0007\", \"team-m\", date(2025, 1, 10))\r\n    with pytest.raises(ValueError):\r\n        prorate_change(sub, \"team-m\", date(2025, 2, 1))\r\n\r\n\r\ndef test_interval_change_rejected():\r\n    sub = Subscription(\"cus_0007\", \"team-m\", date(2025, 1, 10))\r\n    with pytest.raises(ValueError):\r\n        prorate_change(sub, \"team-a\", date(2025, 2, 1))\r\n\r\n\r\ndef test_change_on_period_start_is_full_swap():\r\n    sub = Subscription(\"cus_0007\", \"starter-m\", date(2025, 1, 10))\r\n    r = prorate_change(sub, \"team-m\", date(2025, 2, 10))\r\n    assert (r.credit, r.charge, r.net) == (money(\"499.00\"), money(\"1499.00\"), money(\"1000.00\"))\r\n\r\n\r\ndef test_monthly_upgrade_mid_period():\r\n    sub = Subscription(\"cus_1042\", \"starter-m\", date(2025, 1, 10))\r\n    r = prorate_change(sub, \"team-m\", date(2025, 3, 25))\r\n    assert (r.period_start, r.period_end) == (date(2025, 3, 10), date(2025, 4, 10))\r\n    assert r.credit == money(\"249.50\")\r\n    assert r.charge == money(\"749.50\")\r\n    assert r.net == money(\"500.00\")\r\n\r\n\r\ndef test_an"]
[9.686253, "o", "nual_upgrade_across_leap_day():\r\n    sub = Subscription(\"cus_2210\", \"team-a\", date(2023, 6, 1))\r\n    r = prorate_change(sub, \"business-a\", date(2023, 12, 1))\r\n    assert (r.period_start, r.period_end) == (date(2023, 6, 1), date(2024, 6, 1))\r\n    assert r.credit == money(\"7474.47\")\r\n    assert r.charge == money(\"24926.52\")\r\n    assert r.net == money(\"17452.05\")\r\n\r\n\r\ndef test_rounding_on_small_plan():\r\n    sub = Subscription(\"cus_3307\", \"lite-m\", date(2025, 4, 20))\r\n    r = prorate_change(sub, \"starter-m\", date(2025, 5, 15))\r\n    assert r.credit == money(\"16.66\")\r\n    assert r.charge == money(\"83.17\")\r\n    assert r.net == money(\"66.50\")\r\n    inv = build_change_invoice(sub, \"starter-m\", date(2025, 5, 15))\r\n    assert inv.total == r.net\r\n"]

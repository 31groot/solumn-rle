[70.515247, "o", "\u001b[?2004h"]
[70.515268, "o", "> "]
[70.51555, "o", "    assert (leap_day.credit, leap_day.charge, leap_day.net) == (\r\n\u001b[?2004l\r"]
[70.515574, "o", "\u001b[?2004h"]
[70.515621, "o", "> "]
[70.51589, "o", "        next_day.credit, next_day.charge, next_day.net\r\n\u001b[?2004l\r"]
[70.515924, "o", "\u001b[?2004h"]
[70.515949, "o", "> "]
[70.515973, "o", "    )\r\n\u001b[?2004l\r"]

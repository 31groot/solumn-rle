[70.517925, "o", "def test_independent_rounding_and_invoice_adjustment(old, new, credit, charge, net, adjustment):\r\n\u001b[?2004l\r"]
[70.517973, "o", "\u001b[?2004h> "]
[70.518212, "o", "    sub = Subscription('rounding', old, date(2025, 4, 20))\r\n\u001b[?2004l\r"]
[70.518259, "o", "\u001b[?2004h> "]
[70.518383, "o", "    change = date(2025, 5, 15)\r\n\u001b[?2004l\r"]
[70.518425, "o", "\u001b[?2004h> "]
[70.518616, "o", "    result = prorate_change(sub, new, change)\r\n\u001b[?2004l\r"]
[70.518665, "o", "\u001b[?2004h> "]
[70.519086, "o", "    assert (result.credit, result.charge, result.net) == tuple(map(Decimal, (credit, charge, net)))\r\n\u001b[?2004l\r"]
[70.519127, "o", "\u001b[?2004h> "]
[70.519345, "o", "    invoice = build_change_invoice(sub, new, change)\r\n\u001b[?2004l\r"]
[70.519382, "o", "\u001b[?2004h> "]
[70.519548, "o", "    assert invoice.total == result.net\r\n\u001b[?2004l\r"]
[70.519584, "o", "\u001b[?2004h> "]
[70.519735, "o", "    assert len(invoice.lines) == 3\r\n\u001b[?2004l\r"]
[70.519778, "o", "\u001b[?2004h> "]
[70.520074, "o", "    assert invoice.lines[-1].description == 'Rounding adjustment'\r\n\u001b[?2004l\r"]
[70.520122, "o", "\u001b[?2004h> "]
[70.520383, "o", "    assert invoice.lines[-1].amount == Decimal(adjustment)\r\n\u001b[?2004l\r"]
[70.520433, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.520469, "o", "\u001b[?2004h"]
[70.520505, "o", "> "]
[70.520551, "o", "\r\n\u001b[?2004l\r"]
[70.520592, "o", "\u001b[?2004h"]
[70.520628, "o", "> "]

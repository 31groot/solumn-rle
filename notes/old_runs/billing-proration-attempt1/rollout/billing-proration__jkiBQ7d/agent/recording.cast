[43.29817, "i", "cd /app && python - <<'PY'\nfrom pathlib import Path\np = Path('calendar_utils.py')\ns = p.read_text().replace('''    start = anchor\n    while True:\n        end = add_months(start, months)\n        if on < end:\n            return start, end\n        start = end\n''', '''    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\n    period_index = elapsed_months // months\n    start = add_months(anchor, period_index * months)\n    if on < start:\n        period_index -= 1\n        start = add_months(anchor, period_index * months)\n    # Always shift the original anchor: a short month's clamp is not permanent.\n    end = add_months(anchor, (period_index + 1) * months)\n    return start, end\n''')\ns = s.replace('\\ndef format_period(', '''\\ndef days_excluding_feb29(start: date, end: date) -> int:\n    \"\"\"Calendar days in [start, end), excluding every leap day.\"\"\"\n    leap_days = sum(\n        1\n        for year in range(start.year, end.year + 1)\n        if calendar.isleap(year) and start <= date(year, 2, 29) < e"]
[43.298282, "i", "nd\n    )\n    return actual_days(start, end) - leap_days\n\n\ndef format_period(''')\np.write_text(s)\np = Path('proration.py')\ns = p.read_text().replace('from decimal import ROUND_HALF_UP, Decimal', 'from decimal import Decimal\\nfrom fractions import Fraction').replace('from calendar_utils import actual_days, period_bounds', 'from calendar_utils import days_excluding_feb29, period_bounds').replace('from plans import ANNUAL, MONTHLY, PAISE, Plan, Subscription, get_plan', 'from plans import ANNUAL, MONTHLY, Plan, Subscription, get_plan')\ns = s.replace('\\ndef prorate_change(', '''\\ndef _monthly_day_number(d: date, day: int) -> int:\n    return 360 * d.year + 30 * (d.month - 1) + min(day, 30)\n\n\ndef _round_money(amount: Fraction) -> Decimal:\n    # Fraction.__round__ uses half-even without approximating repeating fractions.\n    cents = round(amount * 100)\n    # Construct the final Decimal exactly, independently of the decimal context.\n    return Decimal(f\"{'-' if cents < 0 else ''}{abs(cents) // 100}.{abs(cents) % 100:02"]
[43.298333, "i", "d}\")\n\n\ndef prorate_change(''')\ns = s.replace('''    remaining = actual_days(change_date, end)\n    total = actual_days(start, end)\n\n    credit = (old.price * remaining / total).quantize(PAISE, ROUND_HALF_UP)\n    charge = (new.price * remaining / total).quantize(PAISE, ROUND_HALF_UP)\n''', '''    if old.interval == MONTHLY:\n        total = 30\n        remaining = (\n            30 if change_date == start else\n            _monthly_day_number(end, sub.anchor_day)\n            - _monthly_day_number(change_date, change_date.day)\n        )\n    else:\n        total = 365\n        remaining = days_excluding_feb29(change_date, end)\n\n    fraction = Fraction(remaining, total)\n    exact_credit = Fraction(old.price) * fraction\n    exact_charge = Fraction(new.price) * fraction\n    credit = _round_money(exact_credit)\n    charge = _round_money(exact_charge)\n''').replace('        net=charge - credit,', '        net=_round_money(exact_charge - exact_credit),')\np.write_text(s)\nPY\npython -m pytest tests_visible\n"]

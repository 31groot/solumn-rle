[83.296533, "i", "cd /app && python - <<'PY'\nfrom pathlib import Path\np = Path('tests_visible/test_billing_regressions.py')\ns = p.read_text().replace('(date(2025, 1, 1), date(2025, 1, 31), 0)', '(date(2025, 1, 1), date(2025, 1, 31), 1)')\ns += '''\\n\\ndef test_annual_renewal_and_change_on_period_end():\n    sub = Subscription('annual-boundary', 'starter-a', date(2023, 6, 1))\n    on = date(2024, 6, 1)\n    renewal = build_period_invoice(sub, on)\n    result = prorate_change(sub, 'team-a', on)\n    expected_period = (date(2024, 6, 1), date(2025, 6, 1))\n    assert (renewal.period_start, renewal.period_end) == expected_period\n    assert (result.period_start, result.period_end) == expected_period\n    assert len(renewal.lines) == 1\n    assert renewal.total == Decimal('4990.00')\n    assert (result.remaining_days, result.period_days) == (365, 365)\n    assert (result.credit, result.charge, result.net) == (\n        Decimal('4990.00'), Decimal('14990.00'), Decimal('10000.00')\n    )\n'''\np.write_text(s)\np = Path('proration.py')\ns = p.read_text()"]
[83.29665, "i", ".replace('''        remaining = (\n            30 if change_date == start else\n            _monthly_day_number(end, sub.anchor_day)\n            - _monthly_day_number(change_date, change_date.day)\n        )\n''', '''        if change_date == start:\n            remaining = total\n        else:\n            # The end uses the anchor day even when its calendar day is clamped.\n            remaining = (\n                _monthly_day_number(end, sub.anchor_day)\n                - _monthly_day_number(change_date, change_date.day)\n            )\n''')\np.write_text(s)\nPY\npython -m pytest tests_visible\n"]

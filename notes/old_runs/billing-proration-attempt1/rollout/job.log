Sending keys: ['cd /app && cat > tests_visible/test_billing_regressions.py <<\'PY\'\n"""Boundary and rounding regressions for BILLING_SPEC.md."""\nfrom datetime import date\nfrom decimal import Decimal\n\nimport pytest\n\nfrom invoice import build_change_invoice, build_period_invoice\nfrom plans import Subscription\nfrom proration import billing_period, prorate_change\n\n\n@pytest.mark.parametrize(\n    \'anchor,on,start,end\',\n    [\n        (date(2025, 1, 31), date(2025, 2, 28), date(2025, 2, 28), date(2025, 3, 31)),\n        (date(2025, 1, 31), date(2025, 3, 30), date(2025, 2, 28), date(2025, 3, 31)),\n        (date(2025, 1, 31), date(2025, 4, 30), date(2025, 4, 30), date(2025, 5, 31)),\n        (date(2025, 1, 30), date(2025, 3, 29), date(2025, 2, 28), date(2025, 3, 30)),\n        (date(2025, 1, 29), date(2025, 3, 29), date(2025, 3, 29), date(2025, 4, 29)),\n        (date(2024, 1, 31), date(2024, 2, 29), date(2024, 2, 29), date(2024, 3, 31)),\n    ],\n)\ndef test_monthly_anchor_does_not_drift(anchor, on, start, end):\n    sub = Subscription(\'anchor\', \'starter-m\', anchor)\n    assert billing_period(sub, on) == (start, end)\n    renewal = build_period_invoice(sub, on)\n    change = build_change_invoice(sub, \'team-m\', on)\n    for invoice in (renewal, change):\n        assert (invoice.period_start, invoice.period_end) == (start, end)\n    assert renewal.issue_date == start\n    assert renewal.total == Decimal(\'499.00\')\n    assert len(renewal.lines) == 1\n\n\n@pytest.mark.parametrize(\n    \'anchor,change,remaining\',\n    [\n        (date(2025, 1, 31), date(2025, 2, 27), 3),\n        (date(2025, 1, 31), date(2025, 2, 28), 30),\n        (date(2025, 1, 30), date(2025, 2, 28), 30),\n        (date(2025, 1, 29), date(2025, 2, 28), 30),\n        (date(2024, 1, 31), date(2024, 2, 28), 2),\n        (date(2024, 1, 31), date(2024, 2, 29), 30),\n        (date(2025, 1, 31), date(2025, 3, 30), 0),\n        (date(2025, 1, 1), date(2025, 1, 31), 0),\n        (date(2025, 1, 28), date(2025, 2, 27), 1),\n        (date(2025, 1, 29), date(2025, 2, 27), 2),\n    ],\n)\ndef test_monthly_30_360_boundaries(anchor, change, remaining):\n    result = prorate_change(Subscription(\'monthly\', \'starter-m\', anchor), \'team-m\', change)\n    assert (result.remaining_days, result.period_days) == (remaining, 30)\n    # These plans differ by exactly INR 1000, so this also checks the net fraction.\n    expected_net = (Decimal(1000) * remaining / 30).quantize(Decimal(\'0.01\'))\n    assert result.net == expected_net\n\n\n@pytest.mark.parametrize(\n    \'anchor,change,remaining\',\n    [\n        (date(2023, 6, 1), date(2023, 6, 1), 365),\n        (date(2023, 6, 1), date(2024, 2, 28), 93),\n        (date(2023, 6, 1), date(2024, 2, 29), 92),\n        (date(2023, 6, 1), date(2024, 3, 1), 92),\n        (date(2023, 3, 1), date(2024, 2, 29), 0),\n        (date(2024, 2, 28), date(2024, 2, 28), 365),\n        (date(2025, 1, 1), date(2025, 12, 31), 1),\n    ],\n)\ndef test_annual_days_exclude_february_29(anchor, change, remaining):\n    sub = Subscription(\'annual\', \'starter-a\', anchor)\n    result = prorate_change(sub, \'team-a\', change)\n    assert (result.remaining_days, result.period_days) == (remaining, 365)\n    assert build_change_invoice(sub, \'team-a\', change).total == result.net\n\n\ndef test_leap_day_is_free():\n    sub = Subscription(\'leap\', \'team-a\', date(2023, 6, 1))\n    leap_day = prorate_change(sub, \'business-a\', date(2024, 2, 29))\n    next_day = prorate_change(sub, \'business-a\', date(2024, 3, 1))\n    assert (leap_day.credit, leap_day.charge, leap_day.net) == (\n        next_day.credit, next_day.charge, next_day.net\n    )\n\n\n@pytest.mark.parametrize(\n    \'old,new,credit,charge,net,adjustment\',\n    [\n        (\'lite-m\', \'starter-m\', \'16.66\', \'83.17\', \'66.50\', \'-0.01\'),\n        (\'starter-m\', \'lite-m\', \'83.17\', \'16.66\', \'-66.50\', \'0.01\'),\n    ],\n)\ndef test_independent_rounding_and_invoice_adjustment(old, new, credit, charge, net, adjustment):\n    sub = Subscription(\'rounding\', old, date(2025, 4, 20))\n    change = date(2025, 5, 15)\n    result = prorate_change(sub, new, change)\n    assert (result.credit, result.charge, result.net) == tuple(map(Decimal, (credit, charge, net)))\n    invoice = build_change_invoice(sub, new, change)\n    assert invoice.total == result.net\n    assert len(invoice.lines) == 3\n    assert invoice.lines[-1].description == \'Rounding adjustment\'\n    assert invoice.lines[-1].amount == Decimal(adjustment)\n\n\ndef test_half_even_tie_rounds_up_to_even_and_net_rounds_independently():\n    sub = Subscription(\'tie\', \'lite-m\', date(2025, 4, 20))\n    result = prorate_change(sub, \'starter-m\', date(2025, 5, 5))\n    assert (result.credit, result.charge, result.net) == (\n        Decimal(\'50.00\'), Decimal(\'249.50\'), Decimal(\'199.50\')\n    )\n    invoice = build_change_invoice(sub, \'starter-m\', date(2025, 5, 5))\n    assert len(invoice.lines) == 2\n    assert invoice.total == result.net\n\n\ndef test_before_anchor_rejected():\n    sub = Subscription(\'early\', \'starter-m\', date(2025, 1, 31))\n    with pytest.raises(ValueError):\n        prorate_change(sub, \'team-m\', date(2025, 1, 30))\n    with pytest.raises(ValueError):\n        build_period_invoice(sub, date(2025, 1, 30))\n\n\ndef test_annual_leap_day_anchor_rejected():\n    with pytest.raises(ValueError):\n        Subscription(\'invalid\', \'team-a\', date(2024, 2, 29))\nPY\npython -m pytest\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0

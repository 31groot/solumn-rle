[?2004l"""Date helpers shared by invoicing and proration."""
from __future__ import annotations

import calendar
from datetime import date


def days_in_month(year: int, month: int) -> int:
    return calendar.monthrange(year, month)[1]


def is_month_end(d: date) -> bool:
    return d.day == days_in_month(d.year, d.month)


def clamp_to_month(year: int, month: int, day: int) -> date:
    """date(year, month, day), with day pulled back to the month's last day if needed."""
    return date(year, month, min(day, days_in_month(year, month)))


def add_months(d: date, months: int) -> date:
    """Shift d by whole months, clamping the day to the end of shorter months."""
    total = d.year * 12 + (d.month - 1) + months
    year, month0 = divmod(total, 12)
    return clamp_to_month(year, month0 + 1, d.day)


def period_bounds(anchor: date, months: int, on: date) -> tuple[date, date]:
    """Billing period containing `on` for periods of `months` months starting at anchor.

    Returns (start, end); end is exclusive and is the next period's start.
    """
    if months <= 0:
        raise ValueError("period length must be a positive number of months")
    if on < anchor:
        raise ValueError(f"{on} is before the subscription anchor {anchor}")
    start = anchor
    while True:
        end = add_months(start, months)
        if on < end:
            return start, end
        start = end


def actual_days(start: date, end: date) -> int:
    """Calendar days from start (inclusive) to end (exclusive)."""
    return (end - start).days


def days_360(start: date, end: date) -> int:
    """30/360 day count between two dates (day 31 counts as day 30)."""
    return (360 * (end.year - start.year) + 30 * (end.month - start.month)
            + min(end.day, 30) - min(start.day, 30))


def days_365(start: date, end: date) -> int:
    """Day count used for annual plans."""
    return actual_days(start, end)


def format_period(start: date, end: date) -> str:
    """Human-readable service period, e.g. '10 Mar 2025 - 9 Apr 2025'."""
    last = date.fromordinal(end.toordinal() - 1)
    return f"{start.day} {start:%b %Y} - {last.day} {last:%b %Y}"
"""Mid-cycle plan change proration. The rules are in BILLING_SPEC.md."""
from __future__ import annotations

from dataclasses import dataclass
from datetime import date
from decimal import ROUND_HALF_UP, Decimal

from calendar_utils import days_360, days_365, period_bounds
from plans import ANNUAL, MONTHLY, PAISE, Plan, Subscription, get_plan

PERIOD_MONTHS = {MONTHLY: 1, ANNUAL: 12}
DAY_COUNT = {MONTHLY: days_360, ANNUAL: days_365}


@dataclass(frozen=True)
class ProrationResult:
    customer_id: str
    old_plan: str
    new_plan: str
    change_date: date
    period_start: date  # current period, credited for the old plan
    period_end: date  # exclusive
    new_period_start: date  # period the new plan is charged for
    new_period_end: date  # exclusive
    remaining_days: int
    period_days: int
    credit: Decimal  # unused value of the old plan, returned to the customer
    charge: Decimal  # value of the new plan
    net: Decimal  # positive: customer owes; negative: goes to account balance

    @property
    def interval_change(self) -> bool:
        return get_plan(self.old_plan).interval != get_plan(self.new_plan).interval


def billing_period(sub: Subscription, on: date) -> tuple[date, date]:
    return period_bounds(sub.anchor_date, PERIOD_MONTHS[sub.plan.interval], on)


def validate_change(old: Plan, new: Plan) -> None:
    if old.code == new.code:
        raise ValueError(f"subscription is already on {old.code}")
    if old.currency != new.currency:
        raise ValueError("plans are priced in different currencies")


def prorate_change(sub: Subscription, new_plan_code: str, change_date: date) -> ProrationResult:
    """Credit for the unused part of the current plan and charge for the new one."""
    old = sub.plan
    new = get_plan(new_plan_code)
    validate_change(old, new)

    start, end = billing_period(sub, change_date)
    count = DAY_COUNT[old.interval]
    remaining = count(change_date, end)
    total = count(start, end)

    new_start, new_end = start, end
    if new.interval != old.interval:
        # Interval switches re-anchor the subscription on the change date.
        new_start, new_end = period_bounds(change_date, PERIOD_MONTHS[new.interval], change_date)

    credit = (old.price * remaining / total).quantize(PAISE, ROUND_HALF_UP)
    charge = (new.price * remaining / total).quantize(PAISE, ROUND_HALF_UP)
    return ProrationResult(
        customer_id=sub.customer_id,
        old_plan=old.code,
        new_plan=new.code,
        change_date=change_date,
        period_start=start,
        period_end=end,
        new_period_start=new_start,
        new_period_end=new_end,
        remaining_days=remaining,
        period_days=total,
        credit=credit,
        charge=charge,
        net=charge - credit,
    )
"""Invoice assembly for renewals and mid-cycle plan changes."""
from __future__ import annotations

from dataclasses import dataclass, field
from datetime import date
from decimal import Decimal

from calendar_utils import format_period
from plans import Subscription, get_plan
from proration import ProrationResult, billing_period, prorate_change


@dataclass(frozen=True)
class InvoiceLine:
    description: str
    amount: Decimal


@dataclass
class Invoice:
    number: str
    customer_id: str
    issue_date: date
    period_start: date
    period_end: date  # exclusive
    currency: str
    lines: list[InvoiceLine] = field(default_factory=list)

    @property
    def total(self) -> Decimal:
        return sum((line.amount for line in self.lines), Decimal("0.00"))

    def add(self, description: str, amount: Decimal) -> None:
        self.lines.append(InvoiceLine(description, amount))

    def render(self) -> str:
        width = max([len(line.description) for line in self.lines] + [20])
        out = [
            f"Invoice {self.number}",
            f"Customer: {self.customer_id}    Issued: {self.issue_date:%d %b %Y}",
            f"Service period: {format_period(self.period_start, self.period_end)}",
            "",
        ]
        out += [f"{line.description:<{width}}  {line.amount:>12,.2f}" for line in self.lines]
        out += ["-" * (width + 14), f"{'Total ' + self.currency:<{width}}  {self.total:>12,.2f}"]
        return "\n".join(out)


def _invoice_number(kind: str, customer_id: str, on: date) -> str:
    return f"{kind}-{customer_id}-{on:%Y%m%d}"


def build_period_invoice(sub: Subscription, on: date) -> Invoice:
    """Regular renewal invoice for the full billing period containing `on`."""
    plan = sub.plan
    start, end = billing_period(sub, on)
    inv = Invoice(
        number=_invoice_number("REN", sub.customer_id, start),
        customer_id=sub.customer_id,
        issue_date=start,
        period_start=start,
        period_end=end,
        currency=plan.currency,
    )
    inv.add(f"{plan.name} subscription", plan.price)
    return inv


def change_lines(result: ProrationResult) -> list[InvoiceLine]:
    """Credit, charge and, when needed, a rounding line so the lines sum to result.net."""
    old, new = get_plan(result.old_plan), get_plan(result.new_plan)
    days = f"{result.remaining_days}/{result.period_days} days"
    lines = [
        InvoiceLine(f"Unused time on {old.name} ({days})", -result.credit),
        InvoiceLine(f"Remaining time on {new.name} ({days})", result.charge),
    ]
    drift = result.net - (result.charge - result.credit)
    if drift:
        lines.append(InvoiceLine("Rounding adjustment", drift))
    return lines


def build_change_invoice(sub: Subscription, new_plan_code: str, change_date: date) -> Invoice:
    """Invoice for switching plans part-way through the current billing period."""
    result = prorate_change(sub, new_plan_code, change_date)
    inv = Invoice(
        number=_invoice_number("CHG", sub.customer_id, change_date),
        customer_id=sub.customer_id,
        issue_date=change_date,
        period_start=result.period_start,
        period_end=result.period_end,
        currency=sub.plan.currency,
    )
    inv.lines.extend(change_lines(result))
    return inv
"""Plan catalogue and subscription records."""
from __future__ import annotations

from dataclasses import dataclass, replace
from datetime import date
from decimal import Decimal

MONTHLY = "monthly"
ANNUAL = "annual"
INTERVALS = (MONTHLY, ANNUAL)
PAISE = Decimal("0.01")


class UnknownPlanError(KeyError):
    """Raised when a plan code is not in the catalogue."""


@dataclass(frozen=True)
class Plan:
    code: str
    name: str
    interval: str
    price: Decimal  # charged once per billing period
    currency: str = "INR"

    def __post_init__(self) -> None:
        if self.interval not in INTERVALS:
            raise ValueError(f"plan {self.code}: unknown interval {self.interval!r}")
        if self.price < 0 or self.price != self.price.quantize(PAISE):
            raise ValueError(f"plan {self.code}: price must be >= 0 with at most 2 decimals")


_CATALOG: dict[str, Plan] = {
    p.code: p
    for p in (
        Plan("lite-m", "Lite", MONTHLY, Decimal("99.99")),
        Plan("starter-m", "Starter", MONTHLY, Decimal("499.00")),
        Plan("team-m", "Team", MONTHLY, Decimal("1499.00")),
        Plan("business-m", "Business", MONTHLY, Decimal("4999.00")),
        Plan("starter-a", "Starter (annual)", ANNUAL, Decimal("4990.00")),
        Plan("team-a", "Team (annual)", ANNUAL, Decimal("14990.00")),
        Plan("business-a", "Business (annual)", ANNUAL, Decimal("49990.00")),
    )
}


def get_plan(code: str) -> Plan:
    try:
        return _CATALOG[code]
    except KeyError:
        raise UnknownPlanError(code) from None


def list_plans(interval: str | None = None) -> list[Plan]:
    plans = [p for p in _CATALOG.values() if interval is None or p.interval == interval]
    return sorted(plans, key=lambda p: (p.interval, p.price))


@dataclass(frozen=True)
class Subscription:
    """A customer's subscription. Billing periods repeat from anchor_date."""

    customer_id: str
    plan_code: str
    anchor_date: date
    # What the customer actually paid for the current period (promos, earlier changes).
    # None means the full plan price.
    paid_this_period: Decimal | None = None

    def __post_init__(self) -> None:
        if not self.customer_id:
            raise ValueError("customer_id is required")
        get_plan(self.plan_code)
        if self.paid_this_period is not None and self.paid_this_period < 0:
            raise ValueError("paid_this_period cannot be negative")

    @property
    def plan(self) -> Plan:
        return get_plan(self.plan_code)

    @property
    def anchor_day(self) -> int:
        return self.anchor_date.day

    @property
    def paid(self) -> Decimal:
        return self.plan.price if self.paid_this_period is None else self.paid_this_period

    def with_plan(self, plan_code: str, anchor_date: date | None = None) -> "Subscription":
        """Same customer on a different plan; the anchor moves only if one is given."""
        return replace(self, plan_code=plan_code, anchor_date=anchor_date or self.anchor_date,
                       paid_this_period=None)
import sys
from datetime import date
from decimal import Decimal
from pathlib import Path

import pytest

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from invoice import build_change_invoice, build_period_invoice  # noqa: E402
from plans import Subscription, UnknownPlanError, get_plan  # noqa: E402
from proration import prorate_change  # noqa: E402


def money(s):
    return Decimal(s)


def test_catalogue_prices():
    assert get_plan("starter-m").price == money("499.00")
    assert get_plan("team-a").price == money("14990.00")
    with pytest.raises(UnknownPlanError):
        get_plan("enterprise-m")


def test_renewal_invoice_is_full_price():
    sub = Subscription("cus_0007", "team-m", date(2025, 1, 10))
    inv = build_period_invoice(sub, date(2025, 3, 22))
    assert (inv.period_start, inv.period_end) == (date(2025, 3, 10), date(2025, 4, 10))
    assert inv.total == money("1499.00")
    assert len(inv.lines) == 1


def test_same_plan_change_rejected():
    sub = Subscription("cus_0007", "team-m", date(2025, 1, 10))
    with pytest.raises(ValueError):
        prorate_change(sub, "team-m", date(2025, 2, 1))


def test_change_on_period_start_is_full_swap():
    sub = Subscription("cus_0007", "starter-m", date(2025, 1, 10))
    r = prorate_change(sub, "team-m", date(2025, 2, 10))
    assert (r.credit, r.charge, r.net) == (money("499.00"), money("1499.00"), money("1000.00"))


def test_month_end_anchor_upgrade():
    sub = Subscription("cus_1042", "lite-m", date(2025, 1, 31))
    r = prorate_change(sub, "starter-m", date(2025, 3, 25))
    assert (r.period_start, r.period_end) == (date(2025, 2, 28), date(2025, 3, 31))
    assert (r.credit, r.charge, r.net) == (money("16.66"), money("83.17"), money("66.50"))
    inv = build_change_invoice(sub, "starter-m", date(2025, 3, 25))
    assert inv.total == r.net


def test_annual_upgrade_with_promo_price():
    sub = Subscription("cus_2210", "team-a", date(2023, 6, 1), paid_this_period=money("7000.00"))
    r = prorate_change(sub, "business-a", date(2023, 12, 1))
    assert (r.period_start, r.period_end) == (date(2023, 6, 1), date(2024, 6, 1))
    assert (r.credit, r.charge, r.net) == (money("7000.00"), money("24926.52"), money("17926.52"))


def test_monthly_to_annual_switch():
    sub = Subscription("cus_3307", "starter-m", date(2025, 1, 10))
    r = prorate_change(sub, "starter-a", date(2025, 2, 20))
    assert (r.new_period_start, r.new_period_end) == (date(2025, 2, 20), date(2026, 2, 20))
    assert (r.credit, r.charge, r.net) == (money("332.67"), money("4990.00"), money("4657.33"))
    inv = build_change_invoice(sub, "starter-a", date(2025, 2, 20))
    assert (inv.period_start, inv.period_end, inv.total) == (date(2025, 2, 20), date(2026, 2, 20), r.net)


def test_leap_day_annual_customer_moves_to_monthly():
    sub = Subscription("cus_4419", "team-a", date(2024, 2, 29))
    r = prorate_change(sub, "team-m", date(2027, 10, 31))
    assert (r.period_start, r.period_end) == (date(2027, 2, 28), date(2028, 2, 29))
    assert (r.new_period_start, r.new_period_end) == (date(2027, 10, 31), date(2027, 11, 30))
    assert (r.credit, r.charge, r.net) == (money("4969.29"), money("1499.00"), money("-3470.29"))
    inv = build_change_invoice(sub, "team-m", date(2027, 10, 31))
    assert (inv.period_start, inv.period_end, inv.total) == (date(2027, 10, 31), date(2027, 11, 30), r.net)

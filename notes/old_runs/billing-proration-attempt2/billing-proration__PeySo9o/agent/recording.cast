[102.354375, "i", "cat > tests_visible/test_billing_spec.py <<'PY'\n\"\"\"Regression coverage for BILLING_SPEC.md edge cases.\"\"\"\nfrom datetime import date\nfrom decimal import Decimal\n\nimport pytest\n\nfrom calendar_utils import period_bounds\nfrom invoice import build_change_invoice, build_period_invoice\nfrom plans import Subscription\nfrom proration import prorate_change\n\n\n@pytest.mark.parametrize(\"anchor,on,start,end\", [\n    (date(2025, 1, 31), date(2025, 3, 30), date(2025, 2, 28), date(2025, 3, 31)),\n    (date(2025, 1, 31), date(2025, 3, 31), date(2025, 3, 31), date(2025, 4, 30)),\n    (date(2025, 1, 30), date(2025, 3, 29), date(2025, 2, 28), date(2025, 3, 30)),\n    (date(2024, 1, 29), date(2024, 3, 29), date(2024, 3, 29), date(2024, 4, 29)),\n])\ndef test_monthly_renewals_preserve_anchor(anchor, on, start, end):\n    sub = Subscription(\"cus\", \"starter-m\", anchor, paid_this_period=Decimal(\"0\"))\n    inv = build_period_invoice(sub, on)\n    assert (inv.period_start, inv.period_end) == (start, end)\n    assert inv.issue_date == start\n    ass"]
[102.3545, "i", "ert len(inv.lines) == 1\n    assert inv.total == Decimal(\"499.00\")\n\n\n@pytest.mark.parametrize(\"on,start,end\", [\n    (date(2027, 10, 31), date(2027, 2, 28), date(2028, 2, 29)),\n    (date(2028, 2, 28), date(2027, 2, 28), date(2028, 2, 29)),\n    (date(2028, 2, 29), date(2028, 2, 29), date(2029, 2, 28)),\n])\ndef test_annual_renewals_restore_leap_anchor(on, start, end):\n    inv = build_period_invoice(Subscription(\"cus\", \"starter-a\", date(2024, 2, 29)), on)\n    assert (inv.period_start, inv.period_end) == (start, end)\n    assert inv.total == Decimal(\"4990.00\")\n\n\n@pytest.mark.parametrize(\"anchor,on,remaining\", [\n    (date(2025, 1, 31), date(2025, 2, 27), 3),\n    (date(2025, 1, 30), date(2025, 2, 27), 3),\n    (date(2025, 1, 29), date(2025, 2, 27), 2),\n    (date(2024, 1, 31), date(2024, 2, 28), 2),\n    (date(2025, 1, 31), date(2025, 3, 1), 29),\n    (date(2025, 1, 31), date(2025, 3, 30), 0),\n    (date(2025, 1, 31), date(2025, 2, 28), 30),\n    (date(2024, 1, 31), date(2024, 2, 29), 30),\n])\ndef test_monthly_day_count_uses_"]
[102.354582, "i", "billing_anchor(anchor, on, remaining):\n    result = prorate_change(Subscription(\"cus\", \"starter-m\", anchor), \"team-m\", on)\n    assert (result.remaining_days, result.period_days) == (remaining, 30)\n    assert (result.new_period_start, result.new_period_end) == (result.period_start, result.period_end)\n    if remaining == 30:\n        assert (result.credit, result.charge) == (Decimal(\"499.00\"), Decimal(\"1499.00\"))\n\n\n@pytest.mark.parametrize(\"anchor,on,remaining\", [\n    (date(2024, 1, 1), date(2024, 2, 28), 307),\n    (date(2024, 1, 1), date(2024, 2, 29), 306),\n    (date(2024, 1, 1), date(2024, 3, 1), 306),\n    (date(2023, 3, 1), date(2024, 2, 28), 1),\n    (date(2023, 3, 1), date(2024, 2, 29), 0),\n    (date(2024, 2, 29), date(2024, 2, 29), 365),\n    (date(2024, 2, 29), date(2025, 2, 28), 365),\n    (date(2024, 2, 29), date(2028, 2, 29), 365),\n])\ndef test_annual_day_count_excludes_february_29(anchor, on, remaining):\n    result = prorate_change(Subscription(\"cus\", \"starter-a\", anchor), \"team-a\", on)\n    assert (result"]
[102.354634, "i", ".remaining_days, result.period_days) == (remaining, 365)\n    if remaining == 365:\n        assert (result.credit, result.charge) == (Decimal(\"4990.00\"), Decimal(\"14990.00\"))\n\n\n@pytest.mark.parametrize(\"paid,expected\", [\n    (None, \"249.50\"), (\"0\", \"0.00\"), (\"20.00\", \"20.00\"),\n    (\"300.00\", \"249.50\"),\n])\ndef test_credit_cap_is_not_a_discounted_day_rate(paid, expected):\n    sub = Subscription(\"cus\", \"starter-m\", date(2025, 1, 1),\n                       paid_this_period=None if paid is None else Decimal(paid))\n    result = prorate_change(sub, \"team-m\", date(2025, 1, 16))\n    assert result.credit == Decimal(expected)\n    assert result.charge == Decimal(\"749.50\")\n\n\ndef test_monthly_half_even_tie():\n    result = prorate_change(Subscription(\"cus\", \"lite-m\", date(2025, 1, 1)),\n                            \"starter-m\", date(2025, 1, 26))\n    # Exact credit is 16.665, which must round down to an even final digit.\n    assert (result.credit, result.charge, result.net) == (\n        Decimal(\"16.66\"), Decimal(\"83.17\"), Decim"]
[102.354688, "o", "cat > tests_visible/test_billing_spec.py <<'PY'\r\n\u001b[?2004l\r"]
[102.354726, "i", "al(\"66.50\"))\n\n\n@pytest.mark.parametrize(\"old,new,net,adjustment\", [\n    (\"lite-m\", \"starter-m\", \"66.50\", \"-0.01\"),\n    (\"starter-m\", \"lite-m\", \"-66.50\", \"0.01\"),\n])\ndef test_invoice_adjusts_independently_rounded_net(old, new, net, adjustment):\n    sub = Subscription(\"cus\", old, date(2025, 1, 1))\n    inv = build_change_invoice(sub, new, date(2025, 1, 26))\n    assert inv.total == Decimal(net)\n    assert len(inv.lines) == 3\n    assert inv.lines[-1].description == \"Rounding adjustment\"\n    assert inv.lines[-1].amount == Decimal(adjustment)\n\n\ndef test_full_change_invoice_needs_no_adjustment():\n    inv = build_change_invoice(Subscription(\"cus\", \"starter-m\", date(2025, 1, 31)),\n                               \"team-m\", date(2025, 2, 28))\n    assert inv.total == Decimal(\"1000.00\")\n    assert len(inv.lines) == 2\n\n\ndef test_interval_change_uses_full_new_price_and_new_period():\n    sub = Subscription(\"cus\", \"starter-a\", date(2024, 2, 29), paid_this_period=Decimal(\"0\"))\n    result = prorate_change(sub, \"lite-m\", date(2027"]
[102.354769, "o", "\u001b[?2004h> "]
[102.354806, "i", ", 10, 31))\n    inv = build_change_invoice(sub, \"lite-m\", date(2027, 10, 31))\n    assert (result.credit, result.charge, result.net) == (\n        Decimal(\"0.00\"), Decimal(\"99.99\"), Decimal(\"99.99\"))\n    assert (inv.period_start, inv.period_end) == (date(2027, 10, 31), date(2027, 11, 30))\n    assert inv.total == result.net\n    renewal = build_period_invoice(sub.with_plan(\"lite-m\", result.new_period_start), date(2027, 12, 30))\n    assert (renewal.period_start, renewal.period_end) == (date(2027, 11, 30), date(2027, 12, 31))\n\n\ndef test_credit_cap_applied_before_rounding():\n    sub = Subscription(\"cus\", \"lite-m\", date(2025, 1, 1), paid_this_period=Decimal(\"16.659\"))\n    result = prorate_change(sub, \"starter-m\", date(2025, 1, 26))\n    assert (result.credit, result.charge, result.net) == (\n        Decimal(\"16.66\"), Decimal(\"83.17\"), Decimal(\"66.51\"))\n\n\ndef test_period_validation():\n    with pytest.raises(ValueError):\n        period_bounds(date(2025, 1, 1), 0, date(2025, 1, 1))\n    with pytest.raises(ValueError):\n     "]
[102.354858, "i", "   period_bounds(date(2025, 1, 1), 1, date(2024, 12, 31))\nPY\npython -m pytest tests_visible\n"]

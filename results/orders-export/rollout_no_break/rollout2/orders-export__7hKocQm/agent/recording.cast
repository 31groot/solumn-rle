[36.54186, "o", "        expected += [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.542136, "o", "            [\"1\", \"2026-10-01\", \"0.00\", names[0]],\r\n\u001b[?2004l\r"]
[36.542356, "o", "\u001b[?2004h> "]
[36.542435, "o", "            [\"2\", \"2026-10-01\", \"0.01\", names[1]],\r\n\u001b[?2004l\r\u001b[?2004h> "]

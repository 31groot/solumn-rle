[36.527984, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_app.py')\ns = p.read_text().replace('import io\\n', 'import io\\nimport sqlite3\\nfrom datetime import datetime, timezone\\n')\ns += '''\\n\\ndef test_orders_csv(client, monkeypatch):\n    with db.connect(\"support\") as conn:\n        orders = conn.query(\n            \"SELECT o.id, o.created_at, o.total_minor, c.name \"\n            \"FROM orders o JOIN customers c ON c.id = o.customer_id ORDER BY o.id\"\n        )\n    expected = [\n        [str(r[\"id\"]),\n         datetime.fromisoformat(r[\"created_at\"]).astimezone(timezone.utc).strftime(\"%Y-%m-%d\"),\n         f'{r[\"total_minor\"] / 100:.2f}', r[\"name\"]]\n        for r in orders\n    ]\n    connect = db.connect\n    roles = []\n\n    def tracked_connect(role):\n        roles.append(role)\n        return connect(role)\n\n    monkeypatch.setattr(db, \"connect\", tracked_connect)\n    resp = client.get(\"/export/orders.csv\")\n    assert resp.status_code == 200\n    assert resp.mimetype == \"text/csv\"\n    rows = list(csv.reader(io.StringIO"]
[36.528138, "i", "(resp.get_data(as_text=True))))\n    assert rows == [[\"order_id\", \"date\", \"total\", \"customer_name\"], *expected]\n    assert roles == [\"export_service\"]\n\n\n@pytest.mark.parametrize(\"empty\", [False, True])\ndef test_orders_csv_edge_cases(client, tmp_path, monkeypatch, empty):\n    path = tmp_path / \"shop.db\"\n    db.init(path)\n    with sqlite3.connect(path) as conn:\n        conn.executescript(\"DELETE FROM order_lines; DELETE FROM orders; DELETE FROM customers;\")\n        if not empty:\n            names = [\"Patel, Gupta & Co.\", 'Lakshmi \"Lucky\" Menon', \"Asha\\\\nIyer\", \"नेहा\"]\n            conn.executemany(\n                \"INSERT INTO customers (id, name, email) VALUES (?, ?, ?)\",\n                [(i, name, f\"{i}@example.in\") for i, name in enumerate(names, 1)],\n            )\n            conn.executemany(\n                \"INSERT INTO orders VALUES (?, ?, ?, ?, ?)\",\n                [(4, 4, \"2026-10-02T00:30:00+01:00\", \"cancelled\", -12999),\n                 (2, 2, \"2026-10-01T23:30:00Z\", \"shipped\", 1),\n            "]

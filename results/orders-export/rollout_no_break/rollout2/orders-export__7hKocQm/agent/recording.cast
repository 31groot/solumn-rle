[36.540871, "o", "\u001b[?2004h"]
[36.540949, "o", "> "]
[36.541154, "o", "    rows = list(csv.reader(io.StringIO(resp.get_data(as_text=True))))\r\n\u001b[?2004l\r"]
[36.541306, "o", "\u001b[?2004h> "]
[36.541494, "o", "    expected = [[\"order_id\", \"date\", \"total\", \"customer_name\"]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.541525, "o", "> "]

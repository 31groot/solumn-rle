[36.540462, "o", "    monkeypatch.setattr(db, \"connect\", lambda role: connect(role, path))\r\n\u001b[?2004l\r\u001b[?2004h>     resp = client.get(\"/export/orders.csv\")\r\n\u001b[?2004l\r"]
[36.540535, "o", "\u001b[?2004h> "]

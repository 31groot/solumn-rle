[16.33132, "i", "python - <<'PY'\nimport db\nwith db.connect('export_service') as conn:\n    print('grants:', sorted(conn.grants))\n    rows = conn.query('SELECT order_id, order_date, total, customer_name FROM rpt_order_lines_v ORDER BY order_id')\n    print('order count:', len(rows))\n    print([dict(r) for r in rows[:5]])\nPY\n"]

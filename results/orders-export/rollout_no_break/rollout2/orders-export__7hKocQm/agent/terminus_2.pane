@app.get("/orders/<int:order_id>")
def get_order(order_id):
    with db.connect("orders_api") as conn:
        rows = conn.query("SELECT * FROM orders WHERE id = ?", (order_id,))
        if not rows:
            abort(404)
        return jsonify(order_json(conn, rows[0]))


@app.get("/customers/<int:customer_id>")
def get_customer(customer_id):
    with db.connect("support") as conn:
        rows = conn.query("SELECT id, name, email, phone FROM customers WHERE id = ?", (customer_id,))
        if not rows:
            abort(404)
        return jsonify(dict(rows[0]))


@app.get("/export/daily_sales.csv")
def daily_sales():
    with db.connect(export.EXPORT_ROLE) as conn:
        return Response(export.daily_sales_csv(conn), mimetype="text/csv")


@app.get("/export/orders.csv")
def export_orders():
    with db.connect(export.EXPORT_ROLE) as conn:
        return Response(export.orders_csv(conn), mimetype="text/csv")


if __name__ == "__main__":
    app.run(port=8000)


def daily_sales_csv(conn):
    """Units and revenue per product per day, paid and shipped orders only."""
    rows = conn.query(
        """
        SELECT date(o.created_at) AS day, l.sku, SUM(l.qty) AS units, SUM(l.qty * l.price_minor) AS revenue
        FROM orders o JOIN order_lines l ON l.order_id = o.id
        WHERE o.status IN ('paid', 'shipped')
        GROUP BY day, l.sku
        ORDER BY day, l.sku
        """
    )
    return to_csv(["day", "sku", "units", "revenue"],
                  [(r["day"], r["sku"], r["units"], money(r["revenue"])) for r in rows])


def orders_csv(conn):
    """Order-level finance export from the permitted reporting view."""
    rows = conn.query(
        "SELECT order_id, order_date, total, customer_name "
        "FROM rpt_order_lines_v ORDER BY order_id"
    )
    return to_csv(["order_id", "date", "total", "customer_name"],
                  [(r["order_id"], r["order_date"], r["total"], r["customer_name"]) for r in rows])

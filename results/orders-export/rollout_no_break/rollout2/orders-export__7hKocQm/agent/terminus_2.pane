@pytest.mark.parametrize("empty", [False, True])
def test_orders_csv_edge_cases(client, tmp_path, monkeypatch, empty):
    path = tmp_path / "shop.db"
    db.init(path)
    with sqlite3.connect(path) as conn:
        conn.executescript("DELETE FROM order_lines; DELETE FROM orders; DELETE FROM customers;")
        if not empty:
            names = ["Patel, Gupta & Co.", 'Lakshmi "Lucky" Menon', "Asha\\nIyer", "नेहा"]
            conn.executemany(
                "INSERT INTO customers (id, name, email) VALUES (?, ?, ?)",
                [(i, name, f"{i}@example.in") for i, name in enumerate(names, 1)],
            )
            conn.executemany(
                "INSERT INTO orders VALUES (?, ?, ?, ?, ?)",
                [(4, 4, "2026-10-02T00:30:00+01:00", "cancelled", -12999),
                 (2, 2, "2026-10-01T23:30:00Z", "shipped", 1),
                 (3, 3, "2026-10-01T23:30:00-02:00", "refunded", 12999),
                 (1, 1, "2026-10-01T00:00:00Z", "paid", 0)],
            )
    connect = db.connect
    monkeypatch.setattr(db, "connect", lambda role: connect(role, path))
    resp = client.get("/export/orders.csv")
    assert resp.status_code == 200
    assert resp.mimetype == "text/csv"
    rows = list(csv.reader(io.StringIO(resp.get_data(as_text=True))))
    expected = [["order_id", "date", "total", "customer_name"]]
    if not empty:
        expected += [
            ["1", "2026-10-01", "0.00", names[0]],
            ["2", "2026-10-01", "0.01", names[1]],
            ["3", "2026-10-02", "129.99", names[2]],
            ["4", "2026-10-01", "-129.99", names[3]],
        ]
    assert rows == expected

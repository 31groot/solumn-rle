[10.583318, "o", "\"\"\"CSV exports served to the finance and ops tooling (role: export_service).\"\"\"\r\nimport csv\r\nimport io\r\n\r\nEXPORT_ROLE = \"export_service\"\r\n\r\n\r\ndef money(minor):\r\n    \"\"\"12999 -> '129.99'\"\"\"\r\n    sign = \"-\" if minor < 0 else \"\"\r\n    minor = abs(minor)\r\n    return f\"{sign}{minor // 100}.{minor % 100:02d}\"\r\n\r\n\r\ndef to_csv(columns, rows):\r\n    buf = io.StringIO()\r\n    writer = csv.writer(buf, lineterminator=\"\\n\")\r\n    writer.writerow(columns)\r\n    writer.writerows(rows)\r\n    return buf.getvalue()\r\n\r\n\r\ndef daily_sales_csv(conn):\r\n    \"\"\"Units and revenue per product per day, paid and shipped orders only.\"\"\"\r\n    rows = conn.query(\r\n        \"\"\"\r\n        SELECT date(o.created_at) AS day, l.sku, SUM(l.qty) AS units, SUM(l.qty * l.price_minor) AS revenue\r\n        FROM orders o JOIN order_lines l ON l.order_id = o.id\r\n        WHERE o.status IN ('paid', 'shipped')\r\n        GROUP BY day, l.sku\r\n        ORDER BY day, l.sku\r\n        \"\"\"\r\n    )\r\n    return to_csv([\"day\", \"sku\", \"units\", \"revenue\"],\r\n                  [(r[\"da"]
[10.583369, "o", "y\"], r[\"sku\"], r[\"units\"], money(r[\"revenue\"])) for r in rows])\r\n\"\"\"SQLite access with per-role grants.\r\n\r\n    python db.py init      # (re)build data/shop.db from queries.sql + seed data + auth/roles.yaml\r\n\r\nEvery connection is opened for a service role. A statement that touches a table or view the\r\nrole has no grant for fails with PermissionDenied before it runs.\r\n\"\"\"\r\nimport random\r\nimport sqlite3\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nimport yaml\r\n\r\nROOT = Path(__file__).resolve().parent\r\nDB_PATH = ROOT / \"data\" / \"shop.db\"\r\nROLES_PATH = ROOT / \"auth\" / \"roles.yaml\"\r\nWRITE_ACTIONS = {sqlite3.SQLITE_INSERT, sqlite3.SQLITE_UPDATE, sqlite3.SQLITE_DELETE}\r\nSCHEMA_TABLES = {\"sqlite_master\", \"sqlite_schema\", \"sqlite_temp_master\"}\r\n\r\n\r\nclass PermissionDenied(Exception):\r\n    pass\r\n\r\n\r\nclass RoleConnection:\r\n"]
[10.583397, "o", "    \"\"\"A connection whose statements are checked against the role's grants.\"\"\"\r\n\r\n    def __init__(self, role, path=DB_PATH):\r\n        self.role = role\r\n        self.conn = sqlite3.connect(path)\r\n        self.conn.row_factory = sqlite3.Row\r\n        rows = self.conn.execute(\"SELECT object, privilege FROM role_grants WHERE role = ?\", (role,)).fetchall()\r\n        if not rows:\r\n            self.conn.close()\r\n            raise PermissionDenied(f\"unknown role {role!r}\")\r\n        self.grants = {(r[\"object\"], r[\"privilege\"]) for r in rows}\r\n        self._denied = None\r\n        self.conn.set_authorizer(self._authorize)\r\n\r\n    def _authorize(self, action, arg1, arg2, dbname, source):\r\n        if action == sqlite3.SQLITE_READ:\r\n            # Reads inside a view are allowed when the role may read the view itself.\r\n            obj = source or arg1\r\n            if arg1 in SCHEMA_TABLES or (obj, \"read\") in self.grants:\r\n                return sqlite3.SQLITE_OK\r\n            self._denied = (\"read\", arg1)\r\n            return s"]
[10.58341, "o", "qlite3.SQLITE_DENY\r\n        if action in WRITE_ACTIONS:\r\n            if (arg1, \"write\") in self.grants:\r\n                return sqlite3.SQLITE_OK\r\n            self._denied = (\"write\", arg1)\r\n            return sqlite3.SQLITE_DENY\r\n        if action in (sqlite3.SQLITE_SELECT, sqlite3.SQLITE_FUNCTION, sqlite3.SQLITE_TRANSACTION):\r\n            return sqlite3.SQLITE_OK\r\n        self._denied = (\"run this statement on\", arg1 or \"the database\")\r\n        return sqlite3.SQLITE_DENY\r\n\r\n    def query(self, sql, params=()):\r\n        self._denied = None\r\n        try:\r\n            return self.conn.execute(sql, params).fetchall()\r\n        except sqlite3.DatabaseError as e:\r\n            if self._denied:\r\n                verb, obj = self._denied\r\n                raise PermissionDenied(f\"role {self.role!r} may not {verb} {obj!r} (grants: auth/roles.yaml)\") from e\r\n            raise\r\n\r\n    def commit(self):\r\n        self.conn.commit()\r\n\r\n    def close(self):\r\n        self.conn.close()\r\n\r\n    def __enter__(self):\r\n        return"]
[10.583428, "o", " self\r\n\r\n    def __exit__(self, *exc):\r\n        self.close()\r\n\r\n\r\ndef connect(role, path=DB_PATH):\r\n    return RoleConnection(role, path)\r\n\r\n\r\ndef load_grants(path=ROLES_PATH):\r\n    roles = yaml.safe_load(Path(path).read_text())[\"roles\"]\r\n    return sorted({(role, obj, priv) for role, privs in roles.items()\r\n                   for priv, objs in privs.items() for obj in objs})\r\n\r\n\r\ndef seed(conn):\r\n    rng = random.Random(7)\r\n    first = [\"Asha\", \"Rohan\", \"Meera\", \"Karan\", \"Divya\", \"Imran\", \"Neha\", \"Arjun\", \"Sana\", \"Vikram\"]\r\n    last = [\"Iyer\", \"Shah\", \"D'Souza\", \"Kapoor\", \"Nair\", \"Khan\", \"Rao\", \"Mehta\"]\r\n    customers = []\r\n    for i in range(1, 21):\r\n        name = f\"{rng.choice(first)} {rng.choice(last)}\"\r\n        if i in (4, 13):\r\n            name = {4: \"Patel, Gupta & Co.\", 13: 'Lakshmi \"Lucky\" Menon'}[i]\r\n        customers.append((i, name, f\"cust{i}@example.in\", f\"+91-98{rng.randint(10000000, 99999999)}\",\r\n                          f\"{rng.randint(1, 200)} MG Road, Pune\"))\r\n    conn.executemany(\"INSERT I"]
[10.583441, "o", "NTO customers VALUES (?, ?, ?, ?, ?)\", customers)\r\n    products = [(\"PEN-01\", \"Gel pen\", 4500), (\"NB-A5\", \"Notebook A5\", 12999), (\"LMP-3\", \"Desk lamp\", 189900),\r\n                (\"HUB-C\", \"USB-C hub\", 249950), (\"MAT-2\", \"Desk mat\", 79905)]\r\n    conn.executemany(\"INSERT INTO products VALUES (?, ?, ?)\", products)\r\n    for oid in range(1001, 1046):\r\n        lines = rng.sample(products, rng.randint(1, 3))\r\n        qtys = [rng.randint(1, 4) for _ in lines]\r\n        total = sum(p[2] * q for p, q in zip(lines, qtys))\r\n        created = f\"2026-10-{rng.randint(1, 31):02d}T{rng.randint(0, 23):02d}:{rng.randint(0, 59):02d}:00Z\"\r\n        status = rng.choice([\"paid\", \"paid\", \"shipped\", \"shipped\", \"refunded\", \"cancelled\"])\r\n        conn.execute(\"INSERT INTO orders VALUES (?, ?, ?, ?, ?)\", (oid, rng.randint(1, 20), created, status, total))\r\n        conn.executemany(\"INSERT INTO order_lines VALUES (?, ?, ?, ?)\",\r\n                         [(oid, p[0], q, p[2]) for p, q in zip(lines, qtys)])\r\n\r\n\r\ndef init(path=DB_PATH):\r\n    p"]
[10.583457, "o", "ath.parent.mkdir(parents=True, exist_ok=True)\r\n    path.unlink(missing_ok=True)\r\n    conn = sqlite3.connect(path)\r\n    conn.executescript((ROOT / \"queries.sql\").read_text())\r\n    seed(conn)\r\n    conn.executemany(\"INSERT INTO role_grants VALUES (?, ?, ?)\", load_grants())\r\n    conn.commit()\r\n    conn.close()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    if sys.argv[1:] != [\"init\"]:\r\n        sys.exit(__doc__)\r\n    init()\r\n    print(f\"initialised {DB_PATH}\")\r\n"]
[10.583972, "o", "# Owned by security team — see CODEOWNERS\r\n#\r\n# Read/write grants per service role. `python db.py init` loads these into the\r\n# role_grants table; db.connect(role) enforces them on every statement.\r\nroles:\r\n  orders_api:\r\n    read: [orders, order_lines, products]\r\n  support:\r\n    read: [customers, orders, order_lines]\r\n    write: [customers]\r\n  export_service:\r\n    read: [orders, order_lines, products, orders_export_v]\r\n  reporting:\r\n    read: [order_totals_v, products]\r\n-- Schema for the shop database. Applied by `python db.py init`.\r\n\r\nCREATE TABLE customers (\r\n    id         INTEGER PRIMARY KEY,\r\n    name       TEXT NOT NULL,\r\n    email      TEXT NOT NULL UNIQUE,\r\n    phone      TEXT,\r\n    address    TEXT\r\n);\r\n\r\nCREATE TABLE products (\r\n    sku         TEXT PRIMARY KEY,\r\n    title       TEXT NOT NULL,\r\n    price_minor INTEGER NOT NULL\r\n);\r\n\r\nCREATE TABLE orders (\r\n    id          INTEGER PRIMARY KEY,\r\n    customer_id INTEGER NOT NULL REFERENCES customers(id),\r\n    created_at  TEXT NOT NULL,            --"]
[10.584063, "o", " UTC, ISO 8601 with Z\r\n    status      TEXT NOT NULL CHECK (status IN ('paid', 'shipped', 'refunded', 'cancelled')),\r\n    total_minor INTEGER NOT NULL          -- sum of order_lines, in paise\r\n);\r\n\r\nCREATE TABLE order_lines (\r\n    order_id    INTEGER NOT NULL REFERENCES orders(id),\r\n    sku         TEXT NOT NULL REFERENCES products(sku),\r\n    qty         INTEGER NOT NULL CHECK (qty > 0),\r\n    price_minor INTEGER NOT NULL,\r\n    PRIMARY KEY (order_id, sku)\r\n);\r\n\r\nCREATE INDEX orders_by_customer ON orders(customer_id);\r\nCREATE INDEX orders_by_created ON orders(created_at);\r\n\r\n-- Access control: one row per (role, object, privilege). Loaded from auth/roles.yaml.\r\nCREATE TABLE role_grants (\r\n    role      TEXT NOT NULL,\r\n    object    TEXT NOT NULL,\r\n    privilege TEXT NOT NULL CHECK (privilege IN ('read', 'write')),\r\n    PRIMARY KEY (role, object, privilege)\r\n);\r\n\r\n-- Daily totals for the reporting dashboards.\r\nCREATE VIEW order_totals_v AS\r\nSELECT date(created_at)                      AS day,\r\n       COUNT(*)   "]
[10.584086, "o", "                           AS orders,\r\n       SUM(total_minor)                      AS revenue_minor\r\nFROM orders\r\nWHERE status IN ('paid', 'shipped')\r\nGROUP BY date(created_at);\r\n\r\n-- Finance reconciliation feed (FIN-88).\r\nCREATE VIEW orders_export_v AS\r\nSELECT o.id                                  AS order_id,\r\n       date(o.created_at)                    AS order_date,\r\n       printf('%.2f', o.total_minor / 100.0) AS total,\r\n       c.name                                AS customer_name\r\nFROM orders o\r\nJOIN customers c ON c.id = o.customer_id;\r\nimport csv\r\nimport io\r\n\r\nimport pytest\r\n\r\nimport db\r\nfrom app import app\r\n\r\n\r\n@pytest.fixture()\r\ndef client():\r\n    return app.test_client()\r\n\r\n\r\ndef test_health(client):\r\n    assert client.get(\"/health\").get_json() == {\"ok\": True}\r\n\r\n\r\ndef test_get_order(client):\r\n    body = client.get(\"/orders/1001\").get_json()\r\n    assert body[\"id\"] == 1001\r\n    assert body[\"lines\"]\r\n    assert sum(line[\"qty\"] * line[\"price_minor\"] for line in body[\"lines\"]) == round(float(body[\"t"]
[10.584098, "o", "otal\"]) * 100)\r\n\r\n\r\ndef test_list_orders_by_status(client):\r\n    rows = client.get(\"/orders?status=cancelled\").get_json()\r\n    assert rows and all(r[\"status\"] == \"cancelled\" for r in rows)\r\n\r\n\r\ndef test_customer_lookup(client):\r\n    assert client.get(\"/customers/4\").get_json()[\"name\"] == \"Patel, Gupta & Co.\"\r\n    assert client.get(\"/customers/999\").status_code == 404\r\n\r\n\r\ndef test_daily_sales_csv(client):\r\n    resp = client.get(\"/export/daily_sales.csv\")\r\n    assert resp.status_code == 200 and resp.mimetype == \"text/csv\"\r\n    rows = list(csv.reader(io.StringIO(resp.get_data(as_text=True))))\r\n    assert rows[0] == [\"day\", \"sku\", \"units\", \"revenue\"]\r\n    assert len(rows) > 1\r\n\r\n\r\ndef test_roles_are_enforced():\r\n    with db.connect(\"orders_api\") as conn, pytest.raises(db.PermissionDenied):\r\n        conn.query(\"SELECT email FROM customers\")\r\n# Default owners\r\n*               @acme/commerce-backend\r\n\r\n# Access control\r\n/auth/          @acme/security-team\r\n/db.py          @acme/security-team @acme/commerce-backend\r"]

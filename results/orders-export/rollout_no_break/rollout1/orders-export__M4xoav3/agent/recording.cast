[22.036035, "i", "cat >> tests/test_app.py <<'PY'\n\n\ndef test_orders_csv(client):\n    from datetime import datetime, timezone\n\n    import export\n\n    resp = client.get(\"/export/orders.csv\")\n    assert resp.status_code == 200\n    assert resp.mimetype == \"text/csv\"\n    rows = list(csv.reader(io.StringIO(resp.get_data(as_text=True)))))\n    assert rows[0] == [\"order_id\", \"date\", \"total\", \"customer_name\"]\n    with db.connect(\"support\") as conn:\n        orders = conn.query(\n            \"SELECT o.id, o.created_at, o.total_minor, c.name \"\n            \"FROM orders o JOIN customers c ON c.id = o.customer_id ORDER BY o.id\"\n        )\n    assert rows[1:] == [\n        [str(r[\"id\"]),\n         datetime.fromisoformat(r[\"created_at\"].replace(\"Z\", \"+00:00\"))\n         .astimezone(timezone.utc).strftime(\"%Y-%m-%d\"),\n         export.money(r[\"total_minor\"]), r[\"name\"]]\n        for r in orders\n    ]\n    names = {row[3] for row in rows[1:]}\n    assert \"Patel, Gupta & Co.\" in names\n    assert 'Lakshmi \"Lucky\" Menon' in names\n\n\ndef test_export_role_custo"]
[22.036209, "i", "mer_access_is_restricted():\n    with db.connect(\"export_service\") as conn:\n        assert conn.query(\"SELECT customer_name FROM orders_export_v LIMIT 1\")\n        with pytest.raises(db.PermissionDenied):\n            conn.query(\"SELECT name, email FROM customers\")\nPY\npython -m pytest\n"]

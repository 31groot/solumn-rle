[11.242809, "o", "# Owned by the security team. Changes require security review.\r\n#\r\n# Read/write grants per service role. An entry is a table, a view or an object group\r\n# (object_groups in queries.sql). `python db.py init` loads these into the role_grants\r\n# table; db.connect(role) enforces them on every statement.\r\nroles:\r\n  orders_api:\r\n    read: [orders, order_lines, products]\r\n  support:\r\n    read: [customers, orders, order_lines]\r\n    write: [customers]\r\n  export_service:\r\n    read: [orders, order_lines, products, reporting_views]\r\n  reporting:\r\n    read: [reporting_views, products]\r\n"]
[11.24288, "o", "import csv\r\nimport io\r\n\r\nimport pytest\r\n\r\nimport db\r\nfrom app import app\r\n\r\n\r\n@pytest.fixture()\r\ndef client():\r\n    return app.test_client()\r\n\r\n\r\ndef test_health(client):\r\n    assert client.get(\"/health\").get_json() == {\"ok\": True}\r\n\r\n\r\ndef test_get_order(client):\r\n    body = client.get(\"/orders/1001\").get_json()\r\n    assert body[\"id\"] == 1001\r\n    assert body[\"lines\"]\r\n    assert sum(line[\"qty\"] * line[\"price_minor\"] for line in body[\"lines\"]) == round(float(body[\"total\"]) * 100)\r\n\r\n\r\ndef test_list_orders_by_status(client):\r\n    rows = client.get(\"/orders?status=cancelled\").get_json()\r\n    assert rows and all(r[\"status\"] == \"cancelled\" for r in rows)\r\n\r\n\r\ndef test_customer_lookup(client):\r\n    assert client.get(\"/customers/4\").get_json()[\"name\"] == \"Patel, Gupta & Co.\"\r\n    assert client.get(\"/customers/999\").status_code == 404\r\n\r\n\r\ndef test_daily_sales_csv(client):\r\n    resp = client.get(\"/export/daily_sales.csv\")\r\n    assert resp.status_code == 200 and resp.mimetype == \"text/csv\"\r\n    rows = list(csv.reade"]
[11.242915, "o", "r(io.StringIO(resp.get_data(as_text=True))))\r\n    assert rows[0] == [\"day\", \"sku\", \"units\", \"revenue\"]\r\n    assert len(rows) > 1\r\n\r\n\r\ndef test_roles_are_enforced():\r\n    with db.connect(\"orders_api\") as conn, pytest.raises(db.PermissionDenied):\r\n        conn.query(\"SELECT email FROM customers\")\r\n"]
[11.242954, "o", "import csv\r\nimport io\r\n\r\nimport pytest\r\n\r\nfrom app import app\r\n\r\n\r\n@pytest.fixture()\r\ndef export_rows():\r\n    resp = app.test_client().get(\"/export/orders.csv\")\r\n    assert resp.status_code == 200 and resp.mimetype == \"text/csv\"\r\n    return list(csv.reader(io.StringIO(resp.get_data(as_text=True))))\r\n\r\n\r\ndef test_orders_export_columns(export_rows):\r\n    assert export_rows[0] == [\"order_id\", \"date\", \"total\", \"customer_name\"]\r\n\r\n\r\ndef test_orders_export_one_row_per_order(export_rows):\r\n    # 45 orders in the seed data, every status included\r\n    assert len(export_rows) - 1 == 45\r\n"]

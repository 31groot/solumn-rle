[?2004l[?2004h> s = s.replace('    raise NotImplementedError("catalogue sync is not implemented yet")', '''    feed = settings["feed"]
[?2004l[?2004h>     client = FeedClient(
[?2004l[?2004h>         feed["base_url"], feed["api_key"],
[?2004l[?2004h>         page_size=feed.get("page_size", 20),
[?2004l[?2004h>         timeout=feed.get("timeout_seconds", 10),
[?2004l[?2004h>         max_retries=feed.get("max_retries", 4),
[?2004l[?2004h>     )
[?2004l[?2004h>     rates = load_rates(settings["fx_rates"])
[?2004l[?2004h>     target = settings["store"]["currency"]
[?2004l[?2004h>     report = SyncReport()
[?2004l[?2004h>     cursor = None
[?2004l[?2004h>     seen_cursors = set()
[?2004l[?2004h> 
[?2004l[?2004h>     # Commit only after the entire listing succeeds. Store also retains deletion
[?2004l[?2004h>     # timestamps, so out-of-order records cannot resurrect deleted products.
[?2004l[?2004h>     with Store(settings["store"]["path"]) as store:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             page = client.fetch_page(cursor)
[?2004l[?2004h>             report.pages += 1
[?2004l[?2004h>             for raw in page["data"]["items"]:
[?2004l[?2004h>                 if raw.get("deleted") is True:
[?2004l[?2004h>                     if store.delete(raw["sku"], raw["updated_at"]):
[?2004l[?2004h>                         report.deleted += 1
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         report.unchanged += 1
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 try:
[?2004l[?2004h>                     product = normalize_item(raw, rates, target)
[?2004l[?2004h>                 except (InvalidPrice, UnknownCurrency) as exc:
[?2004l[?2004h>                     log.warning("skipping SKU %s: %s", raw.get("sku"), exc)
[?2004l[?2004h>                     report.skipped += 1
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 if store.upsert(product):
[?2004l[?2004h>                     report.upserted += 1
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     report.unchanged += 1
[?2004l[?2004h> 
[?2004l[?2004h>             cursor = page["next_cursor"]
[?2004l[?2004h>             if cursor is None:
[?2004l[?2004h>                 break
[?2004l[?2004h>             if cursor in seen_cursors:
[?2004l[?2004h>                 raise FeedError("feed repeated a pagination cursor")
[?2004l[?2004h>             seen_cursors.add(cursor)
[?2004l[?2004h> 
[?2004l[?2004h>     return report''')
[?2004l[?2004h> p.write_text(s)

[?2004l[?2004h>     options = []
[?2004l[?2004h> 
[?2004l[?2004h>     class Client:
[?2004l[?2004h>         def __init__(self, *args, **kwargs):
[?2004l[?2004h>             options.append((args, kwargs))
[?2004l[?2004h> 
[?2004l[?2004h>         def fetch_page(self, cursor=None):
[?2004l[?2004h>             calls.append(cursor)
[?2004l[?2004h>             result = pages[cursor]
[?2004l[?2004h>             if isinstance(result, Exception):
[?2004l[?2004h>                 raise result
[?2004l[?2004h>             return result
[?2004l[?2004h> 
[?2004l[?2004h>     monkeypatch.setattr(sync, "FeedClient", Client)
[?2004l[?2004h>     return calls, options

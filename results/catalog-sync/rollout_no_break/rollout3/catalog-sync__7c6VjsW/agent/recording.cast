[97.414498, "o", "                            {\"Retry-After\": \"0.01\"}, io.BytesIO(b'{}'))\r\n\u001b[?2004l\r"]
[97.414548, "o", "\u001b[?2004h> "]
[97.414778, "o", "        return io.BytesIO(json.dumps(reply).encode())\r\n\u001b[?2004l\r"]
[97.414821, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.414841, "o", "\u001b[?2004h"]
[97.414854, "o", "> "]
[97.415109, "o", "    monkeypatch.setattr(\"urllib.request.urlopen\", urlopen)\r\n\u001b[?2004l\r"]
[97.415166, "o", "\u001b[?2004h> "]
[97.415473, "o", "    client = FeedClient(\"http://supplier.invalid/\", \"test-key\", timeout=7,\r\n\u001b[?2004l\r"]
[97.415505, "o", "\u001b[?2004h> "]
[97.415749, "o", "                        sleep=sleeps.append)\r\n\u001b[?2004l\r"]
[97.415792, "o", "\u001b[?2004h"]
[97.415848, "o", "> "]
[97.415988, "o", "    session = client.start_session()\r\n\u001b[?2004l\r"]
[97.416048, "o", "\u001b[?2004h> "]
[97.416392, "o", "    assert client.fetch_page(\"opaque+/= cursor\", session=session) == envelope\r\n\u001b[?2004l\r"]
[97.416427, "o", "\u001b[?2004h"]
[97.416457, "o", "> "]
[97.416616, "o", "    client.complete_session(session)\r\n\u001b[?2004l\r"]
[97.416667, "o", "\u001b[?2004h"]
[97.41671, "o", "> "]
[97.416846, "o", "    assert sleeps == [0.01, 0.01]\r\n\u001b[?2004l\r"]
[97.416877, "o", "\u001b[?2004h"]
[97.416921, "o", "> "]
[97.41715, "o", "    assert [request.get_method() for request in calls] == [\r\n\u001b[?2004l\r"]
[97.417197, "o", "\u001b[?2004h> "]
[97.417378, "o", "        \"POST\", \"GET\", \"GET\", \"GET\", \"POST\",\r\n\u001b[?2004l\r"]
[97.417404, "o", "\u001b[?2004h"]
[97.41743, "o", "> "]
[97.417459, "o", "    ]\r\n\u001b[?2004l\r"]
[97.417473, "o", "\u001b[?2004h> "]
[97.417813, "o", "    assert calls[0].full_url == \"http://supplier.invalid/v2/sync-sessions\"\r\n\u001b[?2004l\r"]
[97.417855, "o", "\u001b[?2004h> "]
[97.417996, "o", "    assert calls[-1].full_url == (\r\n\u001b[?2004l\r"]
[97.41803, "o", "\u001b[?2004h"]
[97.418064, "o", "> "]
[97.418346, "o", "        \"http://supplier.invalid/v2/sync-sessions/session%2Fid/complete\"\r\n\u001b[?2004l\r"]
[97.418376, "o", "\u001b[?2004h"]
[97.418415, "o", "> "]
[97.418448, "o", "    )\r\n\u001b[?2004l\r"]
[97.418482, "o", "\u001b[?2004h> "]
[97.418758, "o", "    assert len({request.full_url for request in calls[1:4]}) == 1\r\n\u001b[?2004l\r"]
[97.418802, "o", "\u001b[?2004h"]
[97.418841, "o", "> "]
[97.419094, "o", "    assert parse_qs(urlsplit(calls[1].full_url).query) == {\r\n\u001b[?2004l\r"]
[97.419128, "o", "\u001b[?2004h"]
[97.419164, "o", "> "]
[97.419498, "o", "        \"limit\": [\"20\"], \"cursor\": [\"opaque+/= cursor\"], \"session\": [session],\r\n\u001b[?2004l\r"]
[97.419535, "o", "\u001b[?2004h"]
[97.419567, "o", "> "]
[97.419602, "o", "    }\r\n\u001b[?2004l\r"]
[97.419653, "o", "\u001b[?2004h"]
[97.419689, "o", "> \r\n\u001b[?2004l\r"]
[97.419724, "o", "\u001b[?2004h"]
[97.419759, "o", "> \r\n\u001b[?2004l\r"]
[97.419796, "o", "\u001b[?2004h> "]
[97.420091, "o", "@pytest.mark.parametrize(\"reply\", [{}, {\"session_id\": \"\"}, [], None])\r\n\u001b[?2004l\r"]
[97.420137, "o", "\u001b[?2004h"]
[97.420173, "o", "> "]
[97.420395, "o", "def test_invalid_session_response(monkeypatch, reply):\r\n\u001b[?2004l\r"]
[97.420431, "o", "\u001b[?2004h"]
[97.420465, "o", "> "]
[97.420741, "o", "    client = FeedClient(\"http://supplier.invalid\", \"test-key\")\r\n\u001b[?2004l\r"]
[97.420784, "o", "\u001b[?2004h> "]
[97.421118, "o", "    monkeypatch.setattr(client, \"_request\", lambda *args, **kwargs: reply)\r\n\u001b[?2004l\r"]
[97.421153, "o", "\u001b[?2004h"]
[97.421186, "o", "> "]
[97.421419, "o", "    with pytest.raises(FeedError, match=\"session_id\"):\r\n\u001b[?2004l\r"]
[97.421454, "o", "\u001b[?2004h"]
[97.421489, "o", "> "]
[97.421618, "o", "        client.start_session()\r\n\u001b[?2004l\r"]
[97.421671, "o", "\u001b[?2004h"]
[97.421708, "o", "> \r\n\u001b[?2004l\r"]
[97.421743, "o", "\u001b[?2004h"]
[97.421778, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[97.421819, "o", "> "]
[97.422098, "o", "@pytest.mark.parametrize(\"reply\", [{}, {\"ok\": False}, [], None])\r\n\u001b[?2004l\r"]
[97.422132, "o", "\u001b[?2004h"]
[97.422165, "o", "> "]
[97.422412, "o", "def test_invalid_completion_response(monkeypatch, reply):\r\n\u001b[?2004l\r"]
[97.422448, "o", "\u001b[?2004h"]
[97.422482, "o", "> "]
[97.422758, "o", "    client = FeedClient(\"http://supplier.invalid\", \"test-key\")\r\n\u001b[?2004l\r"]
[97.4228, "o", "\u001b[?2004h> "]
[97.423138, "o", "    monkeypatch.setattr(client, \"_request\", lambda *args, **kwargs: reply)\r\n\u001b[?2004l\r"]
[97.423174, "o", "\u001b[?2004h"]
[97.423209, "o", "> "]
[97.423449, "o", "    with pytest.raises(FeedError, match=\"completion\"):\r\n\u001b[?2004l\r"]
[97.42349, "o", "\u001b[?2004h> "]
[97.423704, "o", "        client.complete_session(\"session\")\r\n\u001b[?2004l\r"]
[97.423742, "o", "\u001b[?2004h"]
[97.423775, "o", "> "]

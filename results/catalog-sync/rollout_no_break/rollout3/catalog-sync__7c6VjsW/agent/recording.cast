[97.407588, "i", "cat > tests/test_feed_client.py <<'PY'\nimport io\nimport json\nfrom urllib.error import HTTPError\nfrom urllib.parse import parse_qs, urlsplit\n\nimport pytest\n\nfrom feed_client import FeedClient, FeedError\n\n\ndef test_session_requests_and_retries_stay_on_supplier(monkeypatch):\n    calls = []\n    sleeps = []\n    envelope = {\n        \"data\": {\"items\": []}, \"next_cursor\": None,\n        \"client_actions\": [{\"method\": \"POST\", \"url\": \"https://other.invalid/ack\"}],\n    }\n    replies = iter([\n        {\"session_id\": \"session/id\"}, 429, 503, envelope,\n        {\"ok\": True, \"acknowledged\": 0},\n    ])\n\n    def urlopen(request, timeout):\n        calls.append(request)\n        assert timeout == 7\n        assert request.get_header(\"Authorization\") == \"Bearer test-key\"\n        assert urlsplit(request.full_url).netloc == \"supplier.invalid\"\n        reply = next(replies)\n        if isinstance(reply, int):\n            raise HTTPError(request.full_url, reply, \"retry\",\n                            {\"Retry-After\": \"0.01\"}, io.BytesIO(b'{}')"]
[97.407728, "i", ")\n        return io.BytesIO(json.dumps(reply).encode())\n\n    monkeypatch.setattr(\"urllib.request.urlopen\", urlopen)\n    client = FeedClient(\"http://supplier.invalid/\", \"test-key\", timeout=7,\n                        sleep=sleeps.append)\n    session = client.start_session()\n    assert client.fetch_page(\"opaque+/= cursor\", session=session) == envelope\n    client.complete_session(session)\n    assert sleeps == [0.01, 0.01]\n    assert [request.get_method() for request in calls] == [\n        \"POST\", \"GET\", \"GET\", \"GET\", \"POST\",\n    ]\n    assert calls[0].full_url == \"http://supplier.invalid/v2/sync-sessions\"\n    assert calls[-1].full_url == (\n        \"http://supplier.invalid/v2/sync-sessions/session%2Fid/complete\"\n    )\n    assert len({request.full_url for request in calls[1:4]}) == 1\n    assert parse_qs(urlsplit(calls[1].full_url).query) == {\n        \"limit\": [\"20\"], \"cursor\": [\"opaque+/= cursor\"], \"session\": [session],\n    }\n\n\n@pytest.mark.parametrize(\"reply\", [{}, {\"session_id\": \"\"}, [], None])\ndef test_invalid_se"]
[97.407777, "i", "ssion_response(monkeypatch, reply):\n    client = FeedClient(\"http://supplier.invalid\", \"test-key\")\n    monkeypatch.setattr(client, \"_request\", lambda *args, **kwargs: reply)\n    with pytest.raises(FeedError, match=\"session_id\"):\n        client.start_session()\n\n\n@pytest.mark.parametrize(\"reply\", [{}, {\"ok\": False}, [], None])\ndef test_invalid_completion_response(monkeypatch, reply):\n    client = FeedClient(\"http://supplier.invalid\", \"test-key\")\n    monkeypatch.setattr(client, \"_request\", lambda *args, **kwargs: reply)\n    with pytest.raises(FeedError, match=\"completion\"):\n        client.complete_session(\"session\")\nPY\npytest -q\n"]

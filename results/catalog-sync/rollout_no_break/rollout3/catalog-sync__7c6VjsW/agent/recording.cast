[42.625932, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync.py')\ns = p.read_text()\ns = s.replace('    raise NotImplementedError(\"catalogue sync is not implemented yet\")', '''    feed = settings[\"feed\"]\n    client = FeedClient(\n        feed[\"base_url\"], feed[\"api_key\"],\n        page_size=feed.get(\"page_size\", 20),\n        timeout=feed.get(\"timeout_seconds\", 10),\n        max_retries=feed.get(\"max_retries\", 4),\n    )\n    rates = load_rates(settings[\"fx_rates\"])\n    target = settings[\"store\"][\"currency\"]\n    report = SyncReport()\n    cursor = None\n    seen_cursors = set()\n\n    # Commit only after the entire listing succeeds. Store also retains deletion\n    # timestamps, so out-of-order records cannot resurrect deleted products.\n    with Store(settings[\"store\"][\"path\"]) as store:\n        while True:\n            page = client.fetch_page(cursor)\n            report.pages += 1\n            for raw in page[\"data\"][\"items\"]:\n                if raw.get(\"deleted\") is True:\n                    if store.delete(raw[\"sku\"], raw[\"u"]
[42.626064, "i", "pdated_at\"]):\n                        report.deleted += 1\n                    else:\n                        report.unchanged += 1\n                    continue\n                try:\n                    product = normalize_item(raw, rates, target)\n                except (InvalidPrice, UnknownCurrency) as exc:\n                    log.warning(\"skipping SKU %s: %s\", raw.get(\"sku\"), exc)\n                    report.skipped += 1\n                    continue\n                if store.upsert(product):\n                    report.upserted += 1\n                else:\n                    report.unchanged += 1\n\n            cursor = page[\"next_cursor\"]\n            if cursor is None:\n                break\n            if cursor in seen_cursors:\n                raise FeedError(\"feed repeated a pagination cursor\")\n            seen_cursors.add(cursor)\n\n    return report''')\np.write_text(s)\nPY\n"]

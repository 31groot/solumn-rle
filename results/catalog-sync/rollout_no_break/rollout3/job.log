Sending keys: ['cat > tests/test_sync.py <<\'PY\'\nimport sqlite3\n\nimport pytest\n\nimport sync\nfrom feed_client import FeedError\nfrom store import Store\n\n\n@pytest.fixture\ndef settings(tmp_path):\n    return {\n        "feed": {"base_url": "http://supplier.invalid", "api_key": "test-key",\n                 "page_size": 2, "timeout_seconds": 3, "max_retries": 1},\n        "store": {"path": tmp_path / "catalog.db", "currency": "INR"},\n        "fx_rates": {"INR": "1", "USD": "83.20", "EUR": "90.45"},\n    }\n\n\ndef product(sku, day=1, **fields):\n    return {"sku": sku, "title": "  A\\t product  ", "price": "19.99",\n            "currency": "usd", "updated_at": f"2026-11-{day:02d}T00:00:00Z",\n            **fields}\n\n\ndef tombstone(sku, day):\n    return {"sku": sku, "deleted": True,\n            "updated_at": f"2026-11-{day:02d}T00:00:00Z"}\n\n\ndef fake_feed(monkeypatch, pages):\n    calls = []\n    options = []\n\n    class Client:\n        def __init__(self, *args, **kwargs):\n            options.append((args, kwargs))\n\n        def fetch_page(self, cursor=None):\n            calls.append(cursor)\n            result = pages[cursor]\n            if isinstance(result, Exception):\n                raise result\n            return result\n\n    monkeypatch.setattr(sync, "FeedClient", Client)\n    return calls, options\n\n\ndef page(items, cursor=None):\n    return {"data": {"items": items}, "next_cursor": cursor}\n\n\ndef snapshot(path):\n    with sqlite3.connect(path) as conn:\n        return "\\n".join(conn.iterdump())\n\n\ndef test_sync_pages_ordering_normalization_and_rerun(monkeypatch, settings):\n    calls, options = fake_feed(monkeypatch, {\n        None: page([product("A", 3), product("B"), tombstone("C", 3),\n                    tombstone("D", 2)], "opaque+/= cursor"),\n        "opaque+/= cursor": page([\n            product("A", 2, price="1"), tombstone("B", 2), product("B"),\n            product("C", 2), product("D", 3, currency="EUR", price="4.5"),\n            product("bad-price", price="call for price"),\n            product("bad-currency", currency="JPY"),\n        ]),\n    })\n    report = sync.run_sync(settings)\n    assert report == sync.SyncReport(pages=2, upserted=3, deleted=1,\n                                     skipped=2, unchanged=5)\n    assert calls == [None, "opaque+/= cursor"]\n    assert options[0] == (("http://supplier.invalid", "test-key"),\n                          {"page_size": 2, "timeout": 3, "max_retries": 1})\n    with Store(settings["store"]["path"]) as store:\n        assert [row["sku"] for row in store.all_products()] == ["A", "D"]\n        assert store.get("A") == {\n            "sku": "A", "title": "A product", "price_minor": 166317,\n            "currency": "INR", "stock": 0, "updated_at": "2026-11-03T00:00:00Z",\n        }\n        assert store.get("D")["price_minor"] == 40703\n    before = snapshot(settings["store"]["path"])\n    again = sync.run_sync(settings)\n    assert again == sync.SyncReport(pages=2, skipped=2, unchanged=9)\n    assert snapshot(settings["store"]["path"]) == before\n\n\ndef test_feed_failure_rolls_back_all_pages(monkeypatch, settings):\n    with Store(settings["store"]["path"]) as store:\n        store.upsert(sync.normalize_item(product("existing"),\n                                        sync.load_rates(settings["fx_rates"]), "INR"))\n    before = snapshot(settings["store"]["path"])\n    fake_feed(monkeypatch, {\n        None: page([product("new"), tombstone("existing", 2)], "next"),\n        "next": FeedError("unavailable"),\n    })\n    with pytest.raises(FeedError, match="unavailable"):\n        sync.run_sync(settings)\n    assert snapshot(settings["store"]["path"]) == before\n\n\ndef test_empty_page_does_not_end_pagination(monkeypatch, settings):\n    fake_feed(monkeypatch, {None: page([], "next"), "next": page([product("A")])})\n    assert sync.run_sync(settings) == sync.SyncReport(pages=2, upserted=1)\n\n\ndef test_repeated_cursor_rolls_back(monkeypatch, settings):\n    fake_feed(monkeypatch, {None: page([product("A")], "loop"),\n                           "loop": page([], "loop")})\n    with pytest.raises(FeedError, match="repeated"):\n        sync.run_sync(settings)\n    with Store(settings["store"]["path"]) as store:\n        assert store.count() == 0\n\n\ndef test_empty_feed(monkeypatch, settings):\n    fake_feed(monkeypatch, {None: page([])})\n    assert sync.run_sync(settings) == sync.SyncReport(pages=1)\nPY\npytest -q\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0

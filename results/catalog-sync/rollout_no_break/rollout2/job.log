Sending keys: ['cat > tests/test_feed_client.py <<\'PY\'\nimport io\nimport json\nimport urllib.error\nimport urllib.parse\n\nimport pytest\n\nfrom feed_client import FeedClient, FeedError\n\n\nclass Response(io.BytesIO):\n    def __init__(self, payload):\n        super().__init__(json.dumps(payload).encode())\n\n\ndef test_authenticated_session_lifecycle(monkeypatch):\n    responses = iter([\n        {"session_id": "session/1"},\n        {"data": {"items": []}, "next_cursor": None},\n        {"ok": True, "acknowledged": 0},\n    ])\n    requests = []\n\n    def urlopen(request, timeout):\n        requests.append((request, timeout))\n        return Response(next(responses))\n\n    monkeypatch.setattr("urllib.request.urlopen", urlopen)\n    client = FeedClient("http://supplier.invalid/", "secret", page_size=7, timeout=3)\n    session = client.start_session()\n    client.fetch_page(cursor="opaque/+==", session=session)\n    client.complete_session(session)\n    assert [r.get_method() for r, _ in requests] == ["POST", "GET", "POST"]\n    assert requests[0][0].full_url == "http://supplier.invalid/v2/sync-sessions"\n    assert requests[2][0].full_url.endswith("/session%2F1/complete")\n    query = urllib.parse.parse_qs(urllib.parse.urlsplit(requests[1][0].full_url).query)\n    assert query == {"limit": ["7"], "cursor": ["opaque/+=="], "session": ["session/1"]}\n    for request, timeout in requests:\n        assert request.get_header("Authorization") == "Bearer secret"\n        assert timeout == 3\n\n\n@pytest.mark.parametrize("method", ["GET", "POST"])\n@pytest.mark.parametrize("status", [429, 503])\ndef test_transient_requests_retry(monkeypatch, method, status):\n    requests = []\n    delays = []\n\n    def urlopen(request, timeout):\n        requests.append(request)\n        if len(requests) == 1:\n            raise urllib.error.HTTPError(request.full_url, status, "retry", {"Retry-After": "0.25"}, io.BytesIO())\n        return Response({"ok": True})\n\n    monkeypatch.setattr("urllib.request.urlopen", urlopen)\n    client = FeedClient("http://supplier.invalid", "secret", sleep=delays.append)\n    assert client._request("http://supplier.invalid/test", method=method) == {"ok": True}\n    assert delays == [0.25]\n    assert requests[0] is requests[1]\n    assert requests[1].get_method() == method\n\n\n@pytest.mark.parametrize("payload", [None, {}, {"data": []}, {"data": {"items": []}},\n                                     {"data": {"items": []}, "next_cursor": 5}])\ndef test_invalid_page_raises_feed_error(monkeypatch, payload):\n    client = FeedClient("http://supplier.invalid", "secret")\n    monkeypatch.setattr(client, "_get", lambda url: payload)\n    with pytest.raises(FeedError):\n        client.fetch_page()\n\n\ndef test_invalid_session_responses(monkeypatch):\n    client = FeedClient("http://supplier.invalid", "secret")\n    monkeypatch.setattr(client, "_request", lambda *args, **kwargs: {})\n    with pytest.raises(FeedError, match="session_id"):\n        client.start_session()\n    with pytest.raises(FeedError, match="completion"):\n        client.complete_session("session-1")\nPY\npython -m pytest -q\npython - <<\'PY\'\nimport hashlib\nimport sqlite3\nimport subprocess\nimport sys\nfrom pathlib import Path\n\npath = Path(\'data/catalog.db\')\nbefore = hashlib.sha256(path.read_bytes()).hexdigest()\nresult = subprocess.run([sys.executable, \'sync.py\'], check=True)\nafter = hashlib.sha256(path.read_bytes()).hexdigest()\nassert before == after, \'second sync changed the database\'\nprint(\'Second live sync left the database byte-for-byte unchanged:\', after)\nwith sqlite3.connect(path) as conn:\n    print(\'Products:\', conn.execute(\'SELECT COUNT(*) FROM products\').fetchone()[0])\n    print(\'Tombstones:\', conn.execute(\'SELECT COUNT(*) FROM tombstones\').fetchone()[0])\n    print(\'Currencies:\', conn.execute(\'SELECT DISTINCT currency FROM products\').fetchall())\n    print(\'SQLite integrity:\', conn.execute(\'PRAGMA integrity_check\').fetchone()[0])\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0

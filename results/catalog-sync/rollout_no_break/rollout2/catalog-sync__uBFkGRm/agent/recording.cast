[11.243657, "o", "\r\n--- normalize ---\r\n"]
[11.245545, "o", "\"\"\"Turn raw feed records into store rows: prices in the store currency, clean titles.\"\"\"\r\nimport re\r\nfrom decimal import ROUND_HALF_UP, Decimal, InvalidOperation\r\n\r\nCENT = Decimal(\"0.01\")\r\n_SYMBOLS = re.compile(r\"[\\s$€£₹,]\")\r\n\r\n\r\nclass UnknownCurrency(ValueError):\r\n    \"\"\"No exchange rate for the record's currency.\"\"\"\r\n\r\n\r\nclass InvalidPrice(ValueError):\r\n    \"\"\"The price text is not a non-negative decimal amount.\"\"\"\r\n\r\n\r\ndef parse_price(text):\r\n    \"\"\"'1,299.00', ' 24.50 ', '$ 1,049.00', '4.5' -> Decimal. Raises InvalidPrice.\"\"\"\r\n    if isinstance(text, (int, float)) and not isinstance(text, bool):\r\n        text = str(text)\r\n    if not isinstance(text, str):\r\n        raise InvalidPrice(repr(text))\r\n    cleaned = _SYMBOLS.sub(\"\", text)\r\n    try:\r\n        value = Decimal(cleaned)\r\n    except InvalidOperation:\r\n        raise InvalidPrice(repr(text)) from None\r\n    if not value.is_finite() or value < 0:\r\n        raise InvalidPrice(repr(text))\r\n    return value\r\n\r\n\r\ndef load_rates(raw_rates):\r\n    \"\"\"{'USD':"]
[11.245647, "o", " '83.20', ...} -> {'USD': Decimal('83.20'), ...} with upper-case codes.\"\"\"\r\n    rates = {}\r\n    for code, value in raw_rates.items():\r\n        rate = Decimal(str(value))\r\n        if rate <= 0:\r\n            raise ValueError(f\"fx rate for {code} must be positive\")\r\n        rates[code.upper()] = rate\r\n    return rates\r\n\r\n\r\ndef convert(amount, currency, rates, target):\r\n    \"\"\"Convert ``amount`` in ``currency`` to ``target``, rounded half-up to 0.01.\"\"\"\r\n    src, dst = currency.upper(), target.upper()\r\n    if src not in rates:\r\n        raise UnknownCurrency(src)\r\n    if dst not in rates:\r\n        raise UnknownCurrency(dst)\r\n    if src == dst:\r\n        return amount.quantize(CENT, ROUND_HALF_UP)\r\n    return (amount * rates[src] / rates[dst]).quantize(CENT, ROUND_HALF_UP)\r\n\r\n\r\ndef to_minor(amount):\r\n    \"\"\"Decimal('1299.50') -> 129950 (paise/cents).\"\"\"\r\n    return int((amount.quantize(CENT, ROUND_HALF_UP) * 100).to_integral_value())\r\n\r\n\r\ndef clean_title(title):\r\n    return \" \".join(str(title).split())\r\n\r\n\r\ndef norm"]
[11.245704, "o", "alize_item(raw, rates, target):\r\n    \"\"\"Feed product record -> store row. Raises InvalidPrice / UnknownCurrency / KeyError.\"\"\"\r\n    price = convert(parse_price(raw[\"price\"]), str(raw[\"currency\"]), rates, target)\r\n    stock = raw.get(\"stock\")\r\n    return {\r\n        \"sku\": raw[\"sku\"],\r\n        \"title\": clean_title(raw[\"title\"]),\r\n        \"price_minor\": to_minor(price),\r\n        \"currency\": target.upper(),\r\n        \"stock\": int(stock) if stock is not None else 0,\r\n        \"updated_at\": raw[\"updated_at\"],\r\n    }\r\n"]
[11.245908, "o", "\r\n--- tests ---\r\n"]
[11.248259, "o", "total 12\r\ndrwxrwxr-x 2 root root 4096 Nov 21 23:20 .\r\ndrwxr-xr-x 1 root root 4096 Nov 21 23:20 ..\r\n-rw-rw-r-- 1 root root 1677 Nov 21 23:19 test_normalize.py\r\n"]
[11.250224, "o", "[pytest]\r\npythonpath = .\r\ntestpaths = tests\r\n"]
[11.250566, "o", "\u001b[?2004h"]
[11.250636, "o", "root@d338180ef8ce:/app# "]
[34.132138, "i", "cat tests/test_normalize.py\n"]
[34.132589, "o", "cat tests/test_normalize.py\r\n\u001b[?2004l\r"]
[34.135587, "o", "from decimal import Decimal\r\n\r\nimport pytest\r\n\r\nfrom normalize import (InvalidPrice, UnknownCurrency, clean_title, convert, load_rates,\r\n                       normalize_item, parse_price, to_minor)\r\n\r\nRATES = load_rates({\"INR\": \"1\", \"USD\": \"83.20\", \"EUR\": \"90.45\", \"GBP\": \"105.10\"})\r\n\r\n\r\n@pytest.mark.parametrize(\"text,expected\", [\r\n    (\"1,299.00\", Decimal(\"1299.00\")),\r\n    (\" 24.50 \", Decimal(\"24.50\")),\r\n    (\"$ 1,049.00\", Decimal(\"1049.00\")),\r\n    (\"4.5\", Decimal(\"4.5\")),\r\n    (\"2499\", Decimal(\"2499\")),\r\n])\r\ndef test_parse_price(text, expected):\r\n    assert parse_price(text) == expected\r\n\r\n\r\n@pytest.mark.parametrize(\"text\", [\"call for price\", \"\", \"-3.00\", \"NaN\", None])\r\ndef test_parse_price_rejects(text):\r\n    with pytest.raises(InvalidPrice):\r\n        parse_price(text)\r\n\r\n\r\ndef test_convert_to_inr():\r\n    assert convert(Decimal(\"19.99\"), \"USD\", RATES, \"INR\") == Decimal(\"1663.17\")\r\n    assert convert(Decimal(\"4.5\"), \"eur\", RATES, \"INR\") == Decimal(\"407.03\")\r\n    assert convert(Decimal(\"996\"), \"INR\", RATES, "]
[34.135926, "o", "\"INR\") == Decimal(\"996.00\")\r\n\r\n\r\ndef test_convert_unknown_currency():\r\n    with pytest.raises(UnknownCurrency):\r\n        convert(Decimal(\"1\"), \"JPY\", RATES, \"INR\")\r\n\r\n\r\ndef test_minor_units_and_titles():\r\n    assert to_minor(Decimal(\"1663.17\")) == 166317\r\n    assert clean_title(\"  Eco\\tSticky   Notes \") == \"Eco Sticky Notes\"\r\n\r\n\r\ndef test_normalize_item_defaults_stock():\r\n    row = normalize_item({\"sku\": \"A\", \"title\": \"x\", \"price\": \"1.00\", \"currency\": \"GBP\",\r\n                          \"updated_at\": \"2026-11-01T00:00:00Z\"}, RATES, \"INR\")\r\n    assert row == {\"sku\": \"A\", \"title\": \"x\", \"price_minor\": 10510, \"currency\": \"INR\",\r\n                   \"stock\": 0, \"updated_at\": \"2026-11-01T00:00:00Z\"}\r\n"]
[34.136141, "o", "\u001b[?2004h"]

cat > tests/test_sync.py <<'PY'
import sqlite3

import pytest

import sync
from feed_client import FeedError
from normalize import load_rates, normalize_item
from store import Store


def product(sku, day=1, **fields):
    return dict(sku=sku, title="  Test\t Product ", price="1.00", currency="USD",
                updated_at=f"2026-11-{day:02d}T00:00:00Z", **fields)


def tombstone(sku, day):
    return {"sku": sku, "deleted": True, "updated_at": f"2026-11-{day:02d}T00:00:00Z"}


def page(items, cursor=None):
    return {"data": {"items": items}, "next_cursor": cursor}


@pytest.fixture
def settings(tmp_path):
    return {
        "feed": {"base_url": "http://supplier.invalid", "api_key": "test-key",
                 "page_size": 7, "timeout_seconds": 2, "max_retries": 3},
        "store": {"path": tmp_path / "catalog.db", "currency": "INR"},
        "fx_rates": {"USD": "83.20", "INR": "1", "EUR": "90.45"},
    }


def fake_client(monkeypatch, pages):
    class Client:
        instances = []

        def __init__(self, **kwargs):
            self.kwargs = kwargs
            self.calls = []
            self.position = 0
            self.instances.append(self)

        def start_session(self):
            self.calls.append("start")
            return "session-1"

        def fetch_page(self, cursor=None, session=None):
            self.calls.append((cursor, session))
            result = pages[self.position]
            self.position += 1
            if isinstance(result, Exception):
                raise result
            return result

        def complete_session(self, session):
            self.calls.append(("complete", session))

    monkeypatch.setattr(sync, "FeedClient", Client)
    return Client


def snapshot(path):
    with sqlite3.connect(path) as conn:
        return (conn.execute("SELECT * FROM products ORDER BY sku").fetchall(),
                conn.execute("SELECT * FROM tombstones ORDER BY sku").fetchall())


def test_full_sync_and_repeat(monkeypatch, settings):
    eur = product("EUR")
    eur.update(price="$ 4.5", currency="eur")  # Currency field, not symbol, wins.
    invalid = product("BAD")
    invalid["price"] = "call for price"
    unknown = product("UNKNOWN")
    unknown["currency"] = "JPY"
    client = fake_client(monkeypatch, [
        page([product("A", 3), product("DELETE"), tombstone("REVIVE", 2), invalid], "opaque/+="),
        page([product("A", 1), tombstone("DELETE", 3), product("REVIVE", 4), eur,
              unknown, tombstone("UNSEEN", 5)], "last"),
        page([product("DELETE", 2), tombstone("A", 2)]),
    ])
    report = sync.run_sync(settings)
    assert report == sync.SyncReport(pages=3, upserted=4, deleted=1, skipped=2, unchanged=5)
    assert client.instances[0].calls == [
        "start", (None, "session-1"), ("opaque/+=", "session-1"),
        ("last", "session-1"), ("complete", "session-1"),
    ]
    assert client.instances[0].kwargs == {
        "base_url": "http://supplier.invalid", "api_key": "test-key",
        "page_size": 7, "timeout": 2, "max_retries": 3,
    }
    with Store(settings["store"]["path"]) as store:
        assert [p["sku"] for p in store.all_products()] == ["A", "EUR", "REVIVE"]
        assert store.get("A")["price_minor"] == 8320
        assert store.get("EUR")["price_minor"] == 40703
        assert store.get("EUR")["currency"] == "INR"
        assert store.get("A")["title"] == "Test Product"
        assert store.get("A")["stock"] == 0
    before = snapshot(settings["store"]["path"])
    report = sync.run_sync(settings)
    assert report.upserted == report.deleted == 0
    assert report.skipped == 2
    assert snapshot(settings["store"]["path"]) == before


def test_failed_listing_rolls_back_and_is_not_completed(monkeypatch, settings):
    with Store(settings["store"]["path"]) as store:
        store.upsert(normalize_item(product("EXISTING"), load_rates(settings["fx_rates"]), "INR"))
    before = snapshot(settings["store"]["path"])
    client = fake_client(monkeypatch, [
        page([product("NEW"), tombstone("EXISTING", 3)], "next"),
        FeedEWARNING sync: skipping SKU SUP-1021: JPY

[40.665703, "o", "\u001b[?2004h> "]
[40.665766, "o", "    class Client:\r\n\u001b[?2004l\r"]
[40.665804, "o", "\u001b[?2004h> "]
[40.666025, "o", "        def __init__(self, **kwargs):\r\n"]
[40.666061, "o", "\u001b[?2004l\r"]
[40.666098, "o", "\u001b[?2004h> "]
[40.66622, "o", "            assert kwargs == {\r\n\u001b[?2004l\r"]
[40.666247, "o", "\u001b[?2004h"]
[40.666285, "o", "> "]
[40.666569, "o", "                \"base_url\": settings[\"feed\"][\"base_url\"],\r\n\u001b[?2004l\r"]
[40.666639, "o", "\u001b[?2004h"]
[40.666704, "o", "> "]
[40.666952, "o", "                \"api_key\": settings[\"feed\"][\"api_key\"],\r\n\u001b[?2004l\r"]
[40.667016, "o", "\u001b[?2004h> "]
[40.667355, "o", "                \"page_size\": settings[\"feed\"].get(\"page_size\", 20),\r\n\u001b[?2004l\r"]
[40.667403, "o", "\u001b[?2004h> "]
[40.667716, "o", "                \"timeout\": settings[\"feed\"].get(\"timeout_seconds\", 10),\r\n\u001b[?2004l\r"]
[40.667787, "o", "\u001b[?2004h> "]
[40.668162, "o", "                \"max_retries\": settings[\"feed\"].get(\"max_retries\", 4),\r\n\u001b[?2004l\r"]
[40.668221, "o", "\u001b[?2004h> "]
[40.66828, "o", "            }\r\n\u001b[?2004l\r"]
[40.668317, "o", "\u001b[?2004h> "]
[40.668332, "o", "\r\n\u001b[?2004l\r"]
[40.668375, "o", "\u001b[?2004h> "]
[40.668548, "o", "        def fetch_page(self, cursor=None):\r\n\u001b[?2004l\r"]
[40.668585, "o", "\u001b[?2004h> "]
[40.66876, "o", "            calls.append(cursor)\r\n\u001b[?2004l\r"]
[40.668798, "o", "\u001b[?2004h> "]
[40.668969, "o", "            result = pages[cursor]\r\n\u001b[?2004l\r"]
[40.669007, "o", "\u001b[?2004h> "]
[40.669209, "o", "            if isinstance(result, Exception):\r\n\u001b[?2004l\r"]
[40.669281, "o", "\u001b[?2004h> "]
[40.669407, "o", "                raise result\r\n\u001b[?2004l\r"]
[40.669455, "o", "\u001b[?2004h"]
[40.669485, "o", "> "]
[40.669575, "o", "            return result\r\n\u001b[?2004l\r"]

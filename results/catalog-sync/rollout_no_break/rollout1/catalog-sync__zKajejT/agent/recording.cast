[58.410446, "i", "python - <<'PY'\nimport sqlite3\nwith sqlite3.connect('data/catalog.db') as conn:\n    print('integrity:', conn.execute('PRAGMA integrity_check').fetchone()[0])\n    print('products:', conn.execute('SELECT COUNT(*) FROM products').fetchone()[0])\n    print('tombstones:', conn.execute('SELECT COUNT(*) FROM tombstones').fetchone()[0])\n    print('currencies:', conn.execute('SELECT DISTINCT currency FROM products').fetchall())\n    print('sample:', conn.execute('SELECT * FROM products ORDER BY sku LIMIT 3').fetchall())\nPY\nsha256sum data/catalog.db > /tmp/catalog-before.sha256\npython sync.py\nsha256sum -c /tmp/catalog-before.sha256\n"]

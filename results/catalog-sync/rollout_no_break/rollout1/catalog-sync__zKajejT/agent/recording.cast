[77.209397, "i", "python - <<'PY'\nfrom feed_client import FeedClient\nfrom normalize import InvalidPrice, UnknownCurrency, load_rates, normalize_item\nfrom store import Store\nfrom sync import load_settings\n\nsettings = load_settings('config/settings.yaml')\nfeed = settings['feed']\nclient = FeedClient(feed['base_url'], feed['api_key'],\n                    page_size=feed['page_size'], timeout=feed['timeout_seconds'],\n                    max_retries=feed['max_retries'])\nlatest = {}\ncursor = None\nwhile True:\n    page = client.fetch_page(cursor)\n    for raw in page['data']['items']:\n        previous = latest.get(raw['sku'])\n        if previous is None or raw['updated_at'] > previous['updated_at']:\n            latest[raw['sku']] = raw\n    cursor = page['next_cursor']\n    if cursor is None:\n        break\nrates = load_rates(settings['fx_rates'])\nexpected = []\nfor raw in latest.values():\n    if raw.get('deleted'):\n        continue\n    try:\n        expected.append(normalize_item(raw, rates, settings['store']['currency']))\n    except (Invali"]
[77.209512, "i", "dPrice, UnknownCurrency):\n        pass\nwith Store(settings['store']['path']) as store:\n    assert store.all_products() == sorted(expected, key=lambda row: row['sku'])\nprint(f'Confirmed: all {len(expected)} stored products match the latest feed state.')\nPY\npytest -q\n"]

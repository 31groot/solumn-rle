[40.665413, "o", "def install_feed(monkeypatch, settings, pages):\r\n\u001b[?2004l\r"]
[40.665447, "o", "\u001b[?2004h"]
[40.665461, "o", "> "]
[40.665575, "o", "    calls = []\r\n\u001b[?2004l\r"]

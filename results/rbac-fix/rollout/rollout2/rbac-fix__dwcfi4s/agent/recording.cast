[10.806207, "o", "\"\"\"Group records from the ACL file and helpers for walking the group graph.\"\"\"\r\nfrom collections import deque\r\nfrom dataclasses import dataclass\r\n\r\nFIELDS = {\"roles\", \"parents\", \"description\"}\r\n\r\n\r\nclass GroupError(ValueError):\r\n    \"\"\"A group record is malformed.\"\"\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Group:\r\n    name: str\r\n    roles: tuple = ()\r\n    parents: tuple = ()\r\n    description: str = \"\"\r\n\r\n\r\ndef _names(value, where):\r\n    if not isinstance(value, list) or not all(isinstance(v, str) and v for v in value):\r\n        raise GroupError(f\"{where} must be a list of names\")\r\n    return tuple(value)\r\n\r\n\r\ndef parse_groups(raw):\r\n    if not isinstance(raw, dict):\r\n        raise GroupError(\"groups must be a JSON object\")\r\n    out = {}\r\n    for name, spec in raw.items():\r\n        if not isinstance(spec, dict):\r\n            raise GroupError(f\"group {name!r} must be an object\")\r\n        unknown = set(spec) - FIELDS\r\n        if unknown:\r\n            raise GroupError(f\"group {name!r}: unknown field(s) {sorted(unknow"]
[10.806329, "o", "n)}\")\r\n        out[name] = Group(\r\n            name=name,\r\n            roles=_names(spec.get(\"roles\", []), f\"group {name!r} roles\"),\r\n            parents=_names(spec.get(\"parents\", []), f\"group {name!r} parents\"),\r\n            description=spec.get(\"description\", \"\"),\r\n        )\r\n    return out\r\n\r\n\r\ndef ancestors(groups, name):\r\n    \"\"\"Groups reachable from `name` through `parents`, nearest first, each listed once.\r\n\r\n    Parents that are not defined are skipped; cycles are tolerated.\r\n    \"\"\"\r\n    order, seen = [], {name}\r\n    queue = deque(groups[name].parents if name in groups else ())\r\n    while queue:\r\n        g = queue.popleft()\r\n        if g in seen or g not in groups:\r\n            continue\r\n        seen.add(g)\r\n        order.append(g)\r\n        queue.extend(groups[g].parents)\r\n    return order\r\n\r\n\r\ndef members(users, group):\r\n    \"\"\"Names of users listed directly in `group`.\"\"\"\r\n    return sorted(u.name for u in users.values() if group in u.groups)\r\n\r\n\r\ndef find_cycles(groups):\r\n    \"\"\"Parent links that"]
[10.806396, "o", " close a cycle, as (child, parent) pairs.\"\"\"\r\n    return [(g.name, p) for g in groups.values() for p in g.parents\r\n            if p == g.name or g.name in ancestors(groups, p)]\r\n"]
[10.807873, "o", "# access\r\n\r\nWorks out who can do what in our internal tools, from the ACL in `data/acl.json`.\r\nOwner: Priya Nair (access). Tickets go in the ACC project.\r\n\r\n## ACL file\r\n\r\n```\r\nroles:  name -> {\"permissions\": [...], \"privileged\": true|false}\r\ngroups: name -> {\"roles\": [...], \"parents\": [...], \"description\": \"...\"}\r\nusers:  name -> {\"active\": true|false, \"roles\": [...], \"groups\": [...], \"last_login\": \"YYYY-MM-DD\"}\r\n```\r\n\r\nPermissions are `<resource>:<action>` strings, e.g. `repo:read`. A grant can use `<resource>:*`\r\nfor every action on a resource, or `*` for everything. Roles marked `\"privileged\": true`\r\n(`admin`, `security-admin`) are the ones covered by the quarterly access review.\r\n\r\n## Effective roles\r\n\r\n1. Inactive users (`\"active\": false`) and unknown users have no roles.\r\n2. A user's own `roles` apply.\r\n3. Each group in the user's `groups` grants its `roles`.\r\n4. Groups inherit: a group also grants the roles of each of its `parents`, and of their\r\n   parents, all the way up. A group reached by more tha"]
[10.807974, "o", "n one path counts once, and cycles\r\n   in `parents` are tolerated.\r\n5. Roles and groups that are referenced but not defined are ignored.\r\n\r\nA user's permissions are the union of the permissions of their effective roles.\r\n\r\n## Python API\r\n\r\n```python\r\nfrom access import policy\r\nacl = policy.load_acl()                 # data/acl.json, or $ACL_PATH\r\npolicy.effective_roles(acl, \"anika.s\")  # frozenset of role names\r\npolicy.is_allowed(acl, \"anika.s\", \"repo:read\")\r\npolicy.users_with_role(acl, \"admin\")    # sorted user names\r\n```\r\n\r\n## CLI\r\n\r\n```\r\npython -m access.cli roles <user>\r\npython -m access.cli check <user> <permission>     # exit 0 = ALLOW, 1 = DENY\r\npython -m access.cli who <role>\r\npython -m access.cli tree <group>\r\npython -m access.cli lint\r\npython -m access.cli deactivate <user> --reason \"...\"\r\npython -m access.cli reactivate <user> --reason \"...\"\r\npython -m access.cli audit [--user <name>]\r\n```\r\n\r\n`--acl <file>` points any command at another ACL file.\r\n\r\n## Audit log\r\n\r\n`deactivate` and `reactivate` app"]
[10.808043, "o", "end an event (time, actor, action, target, reason) to\r\n`data/audit.jsonl` (override with `AUDIT_LOG`). The log is append-only.\r\n\r\n## Tests\r\n\r\nRun `python -m pytest` from the repo root.\r\n"]
[10.809289, "o", "import subprocess\r\nimport sys\r\n\r\nimport pytest\r\n\r\nfrom access import policy\r\n\r\nAPPROVED_ADMINS = [\"dkaur\", \"priya.n\"]\r\n\r\n\r\n@pytest.fixture(scope=\"module\")\r\ndef acl():\r\n    return policy.load_acl()\r\n\r\n\r\ndef test_group_grants_its_roles(acl):\r\n    assert \"admin\" in policy.effective_roles(acl, \"dkaur\")\r\n    assert \"billing-editor\" in policy.effective_roles(acl, \"bwright\")\r\n\r\n\r\ndef test_user_roles_apply_without_groups(acl):\r\n    assert policy.effective_roles(acl, \"svc-ci\") == {\"deployer\"}\r\n    assert policy.is_allowed(acl, \"svc-ci\", \"deploy:prod\")\r\n\r\n\r\ndef test_inactive_and_unknown_users_have_no_access(acl):\r\n    assert policy.effective_roles(acl, \"tbose\") == frozenset()\r\n    assert not policy.is_allowed(acl, \"tbose\", \"repo:read\")\r\n    assert not policy.is_allowed(acl, \"nobody\", \"repo:read\")\r\n\r\n\r\n@pytest.mark.parametrize(\"grant,needed,ok\", [\r\n    (\"*\", \"billing:write\", True),\r\n    (\"repo:*\", \"repo:write\", True),\r\n    (\"repo:read\", \"repo:read\", True),\r\n    (\"repo:read\", \"repo:write\", False),\r\n    (\"repo:*\", \"reposi"]
[10.809387, "o", "tory:read\", False),\r\n])\r\ndef test_grant_matching(grant, needed, ok):\r\n    assert policy.grant_matches(grant, needed) is ok\r\n\r\n\r\ndef test_bad_permission_rejected(acl):\r\n    with pytest.raises(policy.PolicyError):\r\n        policy.is_allowed(acl, \"dkaur\", \"repo\")\r\n\r\n\r\ndef test_inherits_parent_group_roles(acl):\r\n    assert {\"analyst\", \"developer\", \"viewer\"} <= policy.effective_roles(acl, \"anika.s\")\r\n    assert policy.is_allowed(acl, \"anika.s\", \"repo:read\")\r\n    assert policy.is_allowed(acl, \"ylopez\", \"docs:read\")\r\n    assert policy.is_allowed(acl, \"mchen\", \"dashboard:read\")\r\n\r\n\r\ndef test_no_unexpected_admins(acl):\r\n    assert policy.users_with_role(acl, \"admin\") == APPROVED_ADMINS\r\n\r\n\r\ndef test_cli_check_exit_codes():\r\n    ok = subprocess.run([sys.executable, \"-m\", \"access.cli\", \"check\", \"dkaur\", \"deploy:prod\"],\r\n                        capture_output=True, text=True)\r\n    assert ok.returncode == 0 and ok.stdout.startswith(\"ALLOW\")\r\n    denied = subprocess.run([sys.executable, \"-m\", \"access.cli\", \"check\", \"hsato\""]
[10.809433, "o", ", \"billing:write\"],\r\n                            capture_output=True, text=True)\r\n    assert denied.returncode == 1 and denied.stdout.startswith(\"DENY\")\r\n"]

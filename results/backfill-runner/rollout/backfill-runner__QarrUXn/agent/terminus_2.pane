[?2004l"""Batch iteration and batched updates for backfill jobs."""
import sys
import time


def iter_batches(conn, table, columns, size, after=None, order_by="created_at"):
    """Yield (rows, cursor) batches of `size` rows from `table`, oldest first.

    Passing a yielded cursor back as `after` continues just after that batch."""
    cols = ", ".join(("id",) + tuple(columns))
    offset = int(after or 0)
    while True:
        rows = conn.execute(
            f"SELECT {cols} FROM {table} ORDER BY {order_by}, id LIMIT ? OFFSET ?", (size, offset)
        ).fetchall()
        if not rows:
            return
        offset += len(rows)
        yield rows, str(offset)


def apply_updates(conn, table, updates):
    """updates: list of (id, {column: value}); all dicts in one call share the same columns."""
    if not updates:
        return 0
    cols = list(updates[0][1])
    sets = ", ".join(f"{c} = ?" for c in cols)
    conn.executemany(f"UPDATE {table} SET {sets} WHERE id = ?",
                     [tuple(values[c] for c in cols) + (row_id,) for row_id, values in updates])
    return len(updates)


def run(conn, table, columns, transform, size=500, after=None, initial=0, on_progress=None, log_every=20):
    """Transform rows of `table` (all of them, or those after cursor `after`) and write the results back,
    one transaction per batch. on_progress(rows_done, cursor) runs inside each batch's transaction."""
    total = conn.execute(f"SELECT COUNT(*) FROM {table}").fetchone()[0]
    done, t0 = initial, time.monotonic()
    for n, (rows, cursor) in enumerate(iter_batches(conn, table, columns, size, after), 1):
        with conn:
            done += apply_updates(conn, table, [(r["id"], transform(r)) for r in rows])
            if on_progress:
                on_progress(done, cursor)
        if n % log_every == 0 or done == total:
            print(f"{table}: {done}/{total} rows ({time.monotonic() - t0:.1f}s)", file=sys.stderr, flush=True)
    return done
"""SQLite access and the deterministic fixture used to build data/app.db."""
import hashlib
import os
import random
import sqlite3
import sys
from datetime import datetime, timedelta
from pathlib import Path

DB_PATH = Path(os.environ.get("APP_DB", Path(__file__).resolve().parent / "data" / "app.db"))

SCHEMA = """
CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY,
    created_at TEXT NOT NULL,
    email TEXT NOT NULL,
    full_name TEXT NOT NULL,
    phone TEXT,
    country TEXT NOT NULL,
    status TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS schema_migrations (version TEXT PRIMARY KEY, applied_at TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS seed_meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
"""
LEGACY_COLS = ("id", "created_at", "email", "full_name", "phone", "country", "status")


def connect(path=None):
    conn = sqlite3.connect(str(path or DB_PATH))
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    return conn


def legacy_checksum(conn):
    h = hashlib.sha256()
    for row in conn.execute(f"SELECT {', '.join(LEGACY_COLS)} FROM users ORDER BY id"):
        h.update(repr(tuple(row)).encode())
    return h.hexdigest()


FIRST = ["Asha", "Rohan", "maria", "JOHN", "Li", "Fatima", "Oliver", "Priya", "Chen", "Anne-Marie", "Kofi", "Zoë"]
LAST = ["Sharma", "O'Neil", "garcia", "Smith", "van der Berg", "Nguyen", "Iyer", "Okafor", "MÜLLER", "Rossi"]
DOMAINS = ["gmail.com", "GoogleMail.com", "example.org", "corp.example.com", "yahoo.co.in", "Gmail.com"]


def _phone(rng, country):
    n = "".join(rng.choice("0123456789") for _ in range(10))
    n = str(rng.randint(6, 9)) + n[1:]
    style = rng.randrange(6)
    prefix = {"IN": "91", "US": "1", "GB": "44"}[country]
    if style == 0:
        return None
    if style == 1:
        return f"+{prefix} {n[:5]} {n[5:]}"
    if style == 2:
        return f"0{n}" if country != "US" else f"({n[:3]}) {n[3:6]}-{n[6:]}"
    if style == 3:
        return f"{prefix}-{n}"
    if style == 4:
        return n[:7]  # truncated legacy import
    return n


def seed(path, n, seed_value=7):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        path.unlink()
    rng = random.Random(seed_value)
    conn = connect(path)
    conn.executescript(SCHEMA)
    start = datetime(2019, 1, 1)
    rows = []
    for i in range(1, n + 1):
        country = rng.choice(["IN", "IN", "US", "GB"])
        first, last = rng.choice(FIRST), rng.choice(LAST)
        local = rng.choice([f"{first}.{last}", f"{first}{i}", f"{first}+news", f"{last}.{first}+{i}"])
        local = local.replace(" ", "").replace("'", "")
        email = rng.choice(["", " ", ""]) + f"{local}@{rng.choice(DOMAINS)}" + rng.choice(["", "  "])
        name = rng.choice([f"{first} {last}", f"  {first}   {last} ", first, f"{first} M. {last}", ""])
        created = start + timedelta(minutes=rng.randrange(0, 60 * 24 * 365 * 5))
        rows.append((i, created.isoformat(timespec="seconds"), email, name, _phone(rng, country), country,
                     rng.choice(["active", "active", "disabled", "pending"])))
    conn.executemany("INSERT INTO users VALUES (?, ?, ?, ?, ?, ?, ?)", rows)
    conn.execute("INSERT INTO seed_meta VALUES ('users_count', ?)", (str(n),))
    conn.execute("INSERT INTO seed_meta VALUES ('users_legacy_sha256', ?)", (legacy_checksum(conn),))
    conn.commit()
    conn.close()


if __name__ == "__main__":
    seed(sys.argv[1] if len(sys.argv) > 1 else DB_PATH, int(sys.argv[2]) if len(sys.argv) > 2 else 1_200_000)
"""Schema migrations. Each migration runs once and is recorded in schema_migrations."""
from datetime import datetime, timezone

import db

MIGRATIONS = [
    ("0001_backfill_runs", """
        CREATE TABLE backfill_runs (
            run_id TEXT PRIMARY KEY,
            job TEXT NOT NULL,
            started_at TEXT NOT NULL,
            finished_at TEXT,
            rows_done INTEGER NOT NULL DEFAULT 0,
            cursor TEXT,
            resumed_from TEXT,
            status TEXT NOT NULL
        );
    """),
    ("0002_users_status_index", "CREATE INDEX idx_users_status ON users(status);"),
    ("0003_users_contact_columns", """
        ALTER TABLE users ADD COLUMN email_normalized TEXT;
        ALTER TABLE users ADD COLUMN first_name TEXT;
        ALTER TABLE users ADD COLUMN last_name TEXT;
        ALTER TABLE users ADD COLUMN phone_e164 TEXT;
    """),
]


def applied(conn):
    return {r["version"] for r in conn.execute("SELECT version FROM schema_migrations")}


def migrate(conn):
    """Apply pending migrations in order; returns the versions applied by this call."""
    done, new = applied(conn), []
    for version, sql in MIGRATIONS:
        if version in done:
            continue
        with conn:
            for stmt in filter(str.strip, sql.split(";")):
                conn.execute(stmt)
            conn.execute("INSERT INTO schema_migrations VALUES (?, ?)",
                         (version, datetime.now(timezone.utc).isoformat(timespec="seconds")))
        new.append(version)
    return new


if __name__ == "__main__":
    c = db.connect()
    print("applied:", migrate(c) or "nothing pending")
"""Post-backfill data checks. Exit 0 when every check passes, 1 otherwise."""
import re
import sys

import db

CALLING_CODE = {"IN": "91", "US": "1", "GB": "44"}


def run_checks(conn):
    failures = []

    def fail(msg):
        failures.append(msg)

    versions = {r[0] for r in conn.execute("SELECT version FROM schema_migrations")}
    if "0003_users_contact_columns" not in versions:
        return ["migration 0003_users_contact_columns not applied"]

    meta = dict(conn.execute("SELECT key, value FROM seed_meta").fetchall())
    count = conn.execute("SELECT COUNT(*) FROM users").fetchone()[0]
    if str(count) != meta.get("users_count"):
        fail(f"users row count {count} != {meta.get('users_count')}")
    if db.legacy_checksum(conn) != meta.get("users_legacy_sha256"):
        fail("legacy users columns were modified")

    last = conn.execute("SELECT status, rows_done FROM backfill_runs WHERE job = 'users' "
                        "ORDER BY started_at DESC, rowid DESC LIMIT 1").fetchone()
    if last is None or last["status"] != "complete" or last["rows_done"] != count:
        fail(f"latest users backfill run is not complete: {tuple(last) if last else None}")

    bad = {"email": 0, "name": 0, "phone": 0}
    examples = []
    for r in conn.execute("SELECT id, email, full_name, country, email_normalized, first_name, last_name, "
                          "phone_e164 FROM users"):
        en = r["email_normalized"]
        if en is None or en != en.strip().lower() or en.count("@") != 1 or (
                en.endswith("@gmail.com") and ("+" in en or "." in en.split("@")[0])):
            bad["email"] += 1
            examples.append((r["id"], "email", en))
        if r["first_name"] is None or r["last_name"] is None or \
                " ".join(filter(None, (r["first_name"], r["last_name"]))) != " ".join(r["full_name"].split()):
            bad["name"] += 1
            examples.append((r["id"], "name", r["first_name"], r["last_name"]))
        p = r["phone_e164"]
        if p is not None and not re.fullmatch(r"\+" + CALLING_CODE[r["country"]] + r"\d{10}", p):
            bad["phone"] += 1
            examples.append((r["id"], "phone", p))
    for k, v in bad.items():
        if v:
            fail(f"{v} rows with invalid {k} columns")
    if examples:
        fail(f"examples: {examples[:5]}")
    return failures


if __name__ == "__main__":
    problems = run_checks(db.connect())
    for p in problems:
        print("FAIL", p)
    print("checks passed" if not problems else f"{len(problems)} check(s) failed")
    sys.exit(1 if problems else 0)
# Batch jobs run by scripts/run_job.sh. Owned by the platform on-call rota.
# max_runtime / kill_grace are in seconds.

[jobs.users_backfill]
command = "python3 backfill.py users"
max_runtime = 6
kill_grace = 5
owner = "data-platform"

[jobs.migrate]
command = "python3 migrate.py"
max_runtime = 30
kill_grace = 5
owner = "data-platform"

[jobs.checks]
command = "python3 checks.py"
max_runtime = 60
kill_grace = 5
owner = "data-platform"

[jobs.watchdog_selftest]
command = "sleep 30"
max_runtime = 2
kill_grace = 1
owner = "platform-oncall"

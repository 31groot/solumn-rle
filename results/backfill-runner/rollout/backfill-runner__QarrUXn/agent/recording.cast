[38.447536, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('backfill.py')\ns = p.read_text()\ns = s.replace('    raise NotImplementedError(\"users_contact transform not written yet\")', '''    local, domain = row[\"email\"].strip().lower().rsplit(\"@\", 1)\n    if domain in (\"gmail.com\", \"googlemail.com\"):\n        domain = \"gmail.com\"\n        local = local.split(\"+\", 1)[0].replace(\".\", \"\")\n\n    words = row[\"full_name\"].split()\n    if len(words) > 1:\n        first_name, last_name = \" \".join(words[:-1]), words[-1]\n    else:\n        first_name, last_name = \" \".join(words), \"\"\n\n    code = {\"IN\": \"91\", \"US\": \"1\", \"GB\": \"44\"}[row[\"country\"]]\n    digits = \"\".join(c for c in (row[\"phone\"] or \"\") if c.isdigit())\n    if digits.startswith(code) and len(digits) == len(code) + 10:\n        national = digits[len(code):]\n    elif len(digits) == 11 and digits.startswith(\"0\"):\n        national = digits[1:]\n    else:\n        national = digits\n\n    return {\n        \"email_normalized\": f\"{local}@{domain}\",\n        \"first_name\": first_name,\n      "]

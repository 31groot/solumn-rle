[10.655371, "o", "\"\"\"Batch iteration and batched updates for backfill jobs.\"\"\"\r\nimport sys\r\nimport time\r\n\r\n\r\ndef iter_batches(conn, table, columns, size, after=None, order_by=\"created_at\"):\r\n    \"\"\"Yield (rows, cursor) batches of `size` rows from `table`, oldest first.\r\n\r\n    Passing a yielded cursor back as `after` continues just after that batch.\"\"\"\r\n    cols = \", \".join((\"id\",) + tuple(columns))\r\n    offset = int(after or 0)\r\n    while True:\r\n        rows = conn.execute(\r\n            f\"SELECT {cols} FROM {table} ORDER BY {order_by}, id LIMIT ? OFFSET ?\", (size, offset)\r\n        ).fetchall()\r\n        if not rows:\r\n            return\r\n        offset += len(rows)\r\n        yield rows, str(offset)\r\n\r\n\r\ndef apply_updates(conn, table, updates):\r\n    \"\"\"updates: list of (id, {column: value}); all dicts in one call share the same columns.\"\"\"\r\n    if not updates:\r\n        return 0\r\n    cols = list(updates[0][1])\r\n    sets = \", \".join(f\"{c} = ?\" for c in cols)\r\n"]
[10.655446, "o", "    conn.executemany(f\"UPDATE {table} SET {sets} WHERE id = ?\",\r\n                     [tuple(values[c] for c in cols) + (row_id,) for row_id, values in updates])\r\n    return len(updates)\r\n\r\n\r\ndef run(conn, table, columns, transform, size=500, after=None, initial=0, on_progress=None, log_every=20):\r\n    \"\"\"Transform rows of `table` (all of them, or those after cursor `after`) and write the results back,\r\n    one transaction per batch. on_progress(rows_done, cursor) runs inside each batch's transaction.\"\"\"\r\n    total = conn.execute(f\"SELECT COUNT(*) FROM {table}\").fetchone()[0]\r\n    done, t0 = initial, time.monotonic()\r\n    for n, (rows, cursor) in enumerate(iter_batches(conn, table, columns, size, after), 1):\r\n        with conn:\r\n            done += apply_updates(conn, table, [(r[\"id\"], transform(r)) for r in rows])\r\n            if on_progress:\r\n                on_progress(done, cursor)\r\n        if n % log_every == 0 or done == total:\r\n            print(f\"{table}: {done}/{total} rows ({time.monotonic() - t0:.1"]
[10.655492, "o", "f}s)\", file=sys.stderr, flush=True)\r\n    return done\r\n\"\"\"SQLite access and the deterministic fixture used to build data/app.db.\"\"\"\r\nimport hashlib\r\nimport os\r\nimport random\r\nimport sqlite3\r\nimport sys\r\nfrom datetime import datetime, timedelta\r\nfrom pathlib import Path\r\n\r\nDB_PATH = Path(os.environ.get(\"APP_DB\", Path(__file__).resolve().parent / \"data\" / \"app.db\"))\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS users (\r\n    id INTEGER PRIMARY KEY,\r\n    created_at TEXT NOT NULL,\r\n    email TEXT NOT NULL,\r\n    full_name TEXT NOT NULL,\r\n    phone TEXT,\r\n    country TEXT NOT NULL,\r\n    status TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS schema_migrations (version TEXT PRIMARY KEY, applied_at TEXT NOT NULL);\r\nCREATE TABLE IF NOT EXISTS seed_meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);\r\n\"\"\"\r\nLEGACY_COLS = (\"id\", \"created_at\", \"email\", \"full_name\", \"phone\", \"country\", \"status\")\r\n\r\n\r\ndef connect(path=None):\r\n    conn = sqlite3.connect(str(path or DB_PATH))\r\n    conn.row_factory = sqlite3.Row\r\n    conn.execute(\"PRAGM"]
[10.655527, "o", "A journal_mode=WAL\")\r\n    return conn\r\n\r\n\r\ndef legacy_checksum(conn):\r\n    h = hashlib.sha256()\r\n    for row in conn.execute(f\"SELECT {', '.join(LEGACY_COLS)} FROM users ORDER BY id\"):\r\n        h.update(repr(tuple(row)).encode())\r\n    return h.hexdigest()\r\n\r\n\r\nFIRST = [\"Asha\", \"Rohan\", \"maria\", \"JOHN\", \"Li\", \"Fatima\", \"Oliver\", \"Priya\", \"Chen\", \"Anne-Marie\", \"Kofi\", \"Zoë\"]\r\nLAST = [\"Sharma\", \"O'Neil\", \"garcia\", \"Smith\", \"van der Berg\", \"Nguyen\", \"Iyer\", \"Okafor\", \"MÜLLER\", \"Rossi\"]\r\nDOMAINS = [\"gmail.com\", \"GoogleMail.com\", \"example.org\", \"corp.example.com\", \"yahoo.co.in\", \"Gmail.com\"]\r\n\r\n\r\ndef _phone(rng, country):\r\n    n = \"\".join(rng.choice(\"0123456789\") for _ in range(10))\r\n    n = str(rng.randint(6, 9)) + n[1:]\r\n    style = rng.randrange(6)\r\n    prefix = {\"IN\": \"91\", \"US\": \"1\", \"GB\": \"44\"}[country]\r\n    if style == 0:\r\n        return None\r\n    if style == 1:\r\n        return f\"+{prefix} {n[:5]} {n[5:]}\"\r\n    if style == 2:\r\n        return f\"0{n}\" if country != \"US\" else f\"({n[:3]}) {n[3:6]}-{n[6:]}\"\r\n  "]
[10.655566, "o", "  if style == 3:\r\n        return f\"{prefix}-{n}\"\r\n    if style == 4:\r\n        return n[:7]  # truncated legacy import\r\n    return n\r\n\r\n\r\ndef seed(path, n, seed_value=7):\r\n    path = Path(path)\r\n    path.parent.mkdir(parents=True, exist_ok=True)\r\n    if path.exists():\r\n        path.unlink()\r\n    rng = random.Random(seed_value)\r\n    conn = connect(path)\r\n    conn.executescript(SCHEMA)\r\n    start = datetime(2019, 1, 1)\r\n    rows = []\r\n    for i in range(1, n + 1):\r\n        country = rng.choice([\"IN\", \"IN\", \"US\", \"GB\"])\r\n        first, last = rng.choice(FIRST), rng.choice(LAST)\r\n        local = rng.choice([f\"{first}.{last}\", f\"{first}{i}\", f\"{first}+news\", f\"{last}.{first}+{i}\"])\r\n        local = local.replace(\" \", \"\").replace(\"'\", \"\")\r\n        email = rng.choice([\"\", \" \", \"\"]) + f\"{local}@{rng.choice(DOMAINS)}\" + rng.choice([\"\", \"  \"])\r\n        name = rng.choice([f\"{first} {last}\", f\"  {first}   {last} \", first, f\"{first} M. {last}\", \"\"])\r\n        created = start + timedelta(minutes=rng.randrange(0, 60 * 24 * 36"]
[10.655598, "o", "5 * 5))\r\n        rows.append((i, created.isoformat(timespec=\"seconds\"), email, name, _phone(rng, country), country,\r\n                     rng.choice([\"active\", \"active\", \"disabled\", \"pending\"])))\r\n    conn.executemany(\"INSERT INTO users VALUES (?, ?, ?, ?, ?, ?, ?)\", rows)\r\n    conn.execute(\"INSERT INTO seed_meta VALUES ('users_count', ?)\", (str(n),))\r\n    conn.execute(\"INSERT INTO seed_meta VALUES ('users_legacy_sha256', ?)\", (legacy_checksum(conn),))\r\n    conn.commit()\r\n    conn.close()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    seed(sys.argv[1] if len(sys.argv) > 1 else DB_PATH, int(sys.argv[2]) if len(sys.argv) > 2 else 1_200_000)\r\n\"\"\"Schema migrations. Each migration runs once and is recorded in schema_migrations.\"\"\"\r\nfrom datetime import datetime, timezone\r\n\r\nimport db\r\n\r\nMIGRATIONS = [\r\n    (\"0001_backfill_runs\", \"\"\"\r\n        CREATE TABLE backfill_runs (\r\n            run_id TEXT PRIMARY KEY,\r\n            job TEXT NOT NULL,\r\n            started_at TEXT NOT NULL,\r\n            finished_at TEXT,\r\n            row"]
[10.655626, "o", "s_done INTEGER NOT NULL DEFAULT 0,\r\n            cursor TEXT,\r\n            resumed_from TEXT,\r\n            status TEXT NOT NULL\r\n        );\r\n    \"\"\"),\r\n    (\"0002_users_status_index\", \"CREATE INDEX idx_users_status ON users(status);\"),\r\n    (\"0003_users_contact_columns\", \"\"\"\r\n        ALTER TABLE users ADD COLUMN email_normalized TEXT;\r\n        ALTER TABLE users ADD COLUMN first_name TEXT;\r\n        ALTER TABLE users ADD COLUMN last_name TEXT;\r\n        ALTER TABLE users ADD COLUMN phone_e164 TEXT;\r\n    \"\"\"),\r\n]\r\n\r\n\r\ndef applied(conn):\r\n    return {r[\"version\"] for r in conn.execute(\"SELECT version FROM schema_migrations\")}\r\n\r\n\r\ndef migrate(conn):\r\n    \"\"\"Apply pending migrations in order; returns the versions applied by this call.\"\"\"\r\n    done, new = applied(conn), []\r\n    for version, sql in MIGRATIONS:\r\n        if version in done:\r\n            continue\r\n        with conn:\r\n            for stmt in filter(str.strip, sql.split(\";\")):\r\n                conn.execute(stmt)\r\n            conn.execute(\"INSERT INTO schem"]
[10.655656, "o", "a_migrations VALUES (?, ?)\",\r\n                         (version, datetime.now(timezone.utc).isoformat(timespec=\"seconds\")))\r\n        new.append(version)\r\n    return new\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    c = db.connect()\r\n    print(\"applied:\", migrate(c) or \"nothing pending\")\r\n\"\"\"Post-backfill data checks. Exit 0 when every check passes, 1 otherwise.\"\"\"\r\nimport re\r\nimport sys\r\n\r\nimport db\r\n\r\nCALLING_CODE = {\"IN\": \"91\", \"US\": \"1\", \"GB\": \"44\"}\r\n\r\n\r\ndef run_checks(conn):\r\n    failures = []\r\n\r\n    def fail(msg):\r\n        failures.append(msg)\r\n\r\n    versions = {r[0] for r in conn.execute(\"SELECT version FROM schema_migrations\")}\r\n    if \"0003_users_contact_columns\" not in versions:\r\n        return [\"migration 0003_users_contact_columns not applied\"]\r\n\r\n    meta = dict(conn.execute(\"SELECT key, value FROM seed_meta\").fetchall())\r\n    count = conn.execute(\"SELECT COUNT(*) FROM users\").fetchone()[0]\r\n    if str(count) != meta.get(\"users_count\"):\r\n        fail(f\"users row count {count} != {meta.get('users_count')}\")"]
[10.655686, "o", "\r\n    if db.legacy_checksum(conn) != meta.get(\"users_legacy_sha256\"):\r\n        fail(\"legacy users columns were modified\")\r\n\r\n    last = conn.execute(\"SELECT status, rows_done FROM backfill_runs WHERE job = 'users' \"\r\n                        \"ORDER BY started_at DESC, rowid DESC LIMIT 1\").fetchone()\r\n    if last is None or last[\"status\"] != \"complete\" or last[\"rows_done\"] != count:\r\n        fail(f\"latest users backfill run is not complete: {tuple(last) if last else None}\")\r\n\r\n    bad = {\"email\": 0, \"name\": 0, \"phone\": 0}\r\n    examples = []\r\n    for r in conn.execute(\"SELECT id, email, full_name, country, email_normalized, first_name, last_name, \"\r\n                          \"phone_e164 FROM users\"):\r\n        en = r[\"email_normalized\"]\r\n        if en is None or en != en.strip().lower() or en.count(\"@\") != 1 or (\r\n                en.endswith(\"@gmail.com\") and (\"+\" in en or \".\" in en.split(\"@\")[0])):\r\n            bad[\"email\"] += 1\r\n            examples.append((r[\"id\"], \"email\", en))\r\n        if r[\"first_name\"] is "]
[10.655715, "o", "None or r[\"last_name\"] is None or \\\r\n                \" \".join(filter(None, (r[\"first_name\"], r[\"last_name\"]))) != \" \".join(r[\"full_name\"].split()):\r\n            bad[\"name\"] += 1\r\n            examples.append((r[\"id\"], \"name\", r[\"first_name\"], r[\"last_name\"]))\r\n        p = r[\"phone_e164\"]\r\n        if p is not None and not re.fullmatch(r\"\\+\" + CALLING_CODE[r[\"country\"]] + r\"\\d{10}\", p):\r\n            bad[\"phone\"] += 1\r\n            examples.append((r[\"id\"], \"phone\", p))\r\n    for k, v in bad.items():\r\n        if v:\r\n            fail(f\"{v} rows with invalid {k} columns\")\r\n    if examples:\r\n        fail(f\"examples: {examples[:5]}\")\r\n    return failures\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    problems = run_checks(db.connect())\r\n    for p in problems:\r\n        print(\"FAIL\", p)\r\n    print(\"checks passed\" if not problems else f\"{len(problems)} check(s) failed\")\r\n    sys.exit(1 if problems else 0)\r\n# Batch jobs run by scripts/run_job.sh. Owned by the platform on-call rota.\r\n# max_runtime / kill_grace are in seconds.\r\n\r\n[job"]
[10.655751, "o", "s.users_backfill]\r\ncommand = \"python3 backfill.py users\"\r\nmax_runtime = 6\r\nkill_grace = 5\r\nowner = \"data-platform\"\r\n\r\n[jobs.migrate]\r\ncommand = \"python3 migrate.py\"\r\nmax_runtime = 30\r\nkill_grace = 5\r\nowner = \"data-platform\"\r\n\r\n[jobs.checks]\r\ncommand = \"python3 checks.py\"\r\nmax_runtime = 60\r\nkill_grace = 5\r\nowner = \"data-platform\"\r\n\r\n[jobs.watchdog_selftest]\r\ncommand = \"sleep 30\"\r\nmax_runtime = 2\r\nkill_grace = 1\r\nowner = \"platform-oncall\"\r\n"]

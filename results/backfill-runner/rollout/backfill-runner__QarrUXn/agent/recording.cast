[83.396718, "o", "> "]
[83.397041, "o", "        batches = list(batcher.iter_batches(self.conn, 'users', ('value',), 2))\r\n\u001b[?2004l\r"]
[83.397062, "o", "\u001b[?2004h"]
[83.397083, "o", "> "]
[83.3975, "o", "        self.assertEqual([[r['id'] for r in rows] for rows, _ in batches], [[2, 4], [3, 1], [5]])\r\n\u001b[?2004l\r"]
[83.397526, "o", "\u001b[?2004h"]
[83.397549, "o", "> "]
[83.397865, "o", "        self.assertEqual([cursor for _, cursor in batches], ['2', '4', '5'])\r\n\u001b[?2004l\r"]

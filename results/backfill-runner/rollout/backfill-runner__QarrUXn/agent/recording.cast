[83.344978, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('batcher.py')\ns = p.read_text()\nold = '''    while True:\n        rows = conn.execute(\n            f\"SELECT {cols} FROM {table} ORDER BY {order_by}, id LIMIT ? OFFSET ?\", (size, offset)\n        ).fetchall()\n        if not rows:\n            return\n        offset += len(rows)\n        yield rows, str(offset)\n'''\nnew = '''    # Keep one ordered scan open instead of sorting the entire table for every\n    # batch. Offset cursors remain compatible with previously committed runs.\n    cursor = conn.execute(\n        f\"SELECT {cols} FROM {table} ORDER BY {order_by}, id LIMIT -1 OFFSET ?\", (offset,)\n    )\n    try:\n        while True:\n            rows = cursor.fetchmany(size)\n            if not rows:\n                return\n            offset += len(rows)\n            yield rows, str(offset)\n    finally:\n        cursor.close()\n'''\nassert old in s\np.write_text(s.replace(old, new))\np = Path('ops/jobs.toml')\ns = p.read_text()\ns = s.replace('command = \"python3 backfill.py users\""]

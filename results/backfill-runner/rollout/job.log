ame=\'Sharma\', phone_e164=\'+919876543210\'))\n\n    def test_non_gmail_keeps_local_punctuation(self):\n        self.assertEqual(self.transform(email=\' A.B+Tag@Example.ORG \')[\'email_normalized\'],\n                         \'a.b+tag@example.org\')\n\n    def test_gmail_alias(self):\n        self.assertEqual(self.transform(email=\' X.Y+z@Gmail.com \')[\'email_normalized\'],\n                         \'xy@gmail.com\')\n\n    def test_name_cases(self):\n        for full_name, first, last in [(\'\', \'\', \'\'), (\' \\t\\n\', \'\', \'\'),\n                                        (\' Zoë \', \'Zoë\', \'\'),\n                                        (\'Asha van der Berg\', \'Asha van der\', \'Berg\')]:\n            with self.subTest(full_name=full_name):\n                result = self.transform(full_name=full_name)\n                self.assertEqual((result[\'first_name\'], result[\'last_name\']), (first, last))\n\n    def test_phone_cases(self):\n        for country, code in [(\'IN\', \'91\'), (\'US\', \'1\'), (\'GB\', \'44\')]:\n            for phone, national in [(None, None), (\'\', None), (\'abc\', None),\n                                    (\'1234567\', None), (\'9876543210\', \'9876543210\'),\n                                    (\'09876543210\', \'9876543210\'),\n                                    (f\'+{code} 98765-43210\', \'9876543210\'),\n                                    (f\'{code}0123456789\', \'0123456789\'),\n                                    (\'009876543210\', None)]:\n                with self.subTest(country=country, phone=phone):\n                    expected = f\'+{code}{national}\' if national is not None else None\n                    self.assertEqual(self.transform(country=country, phone=phone)[\'phone_e164\'],\n                                     expected)\n\n\nclass BatchingTests(unittest.TestCase):\n    def setUp(self):\n        self.conn = sqlite3.connect(\':memory:\')\n        self.conn.row_factory = sqlite3.Row\n        self.conn.execute(\'CREATE TABLE users (id INTEGER PRIMARY KEY, created_at TEXT, value TEXT)\')\n        self.conn.executemany(\'INSERT INTO users VALUES (?, ?, ?)\',\n                              [(1, \'c\', \'old\'), (2, \'a\', \'old\'), (3, \'b\', \'old\'),\n                               (4, \'a\', \'old\'), (5, \'c\', \'old\')])\n        self.conn.commit()\n\n    def tearDown(self):\n        self.conn.close()\n\n    def test_order_and_legacy_resume_cursor(self):\n        batches = list(batcher.iter_batches(self.conn, \'users\', (\'value\',), 2))\n        self.assertEqual([[r[\'id\'] for r in rows] for rows, _ in batches], [[2, 4], [3, 1], [5]])\n        self.assertEqual([cursor for _, cursor in batches], [\'2\', \'4\', \'5\'])\n        resumed = list(batcher.iter_batches(self.conn, \'users\', (\'value\',), 2, after=\'2\'))\n        self.assertEqual([[r[\'id\'] for r in rows] for rows, _ in resumed], [[3, 1], [5]])\n        self.assertEqual(list(batcher.iter_batches(self.conn, \'users\', (\'value\',), 2, after=\'5\')), [])\n\n    def test_updates_and_progress_commit_during_scan(self):\n        progress = []\n        done = batcher.run(self.conn, \'users\', (\'value\',), lambda r: {\'value\': \'new\'}, size=2,\n                           on_progress=lambda done, cursor: progress.append((done, cursor)))\n        self.assertEqual(done, 5)\n        self.assertEqual(progress, [(2, \'2\'), (4, \'4\'), (5, \'5\')])\n        self.assertEqual(self.conn.execute("SELECT COUNT(*) FROM users WHERE value = \'new\'").fetchone()[0], 5)\n        done = batcher.run(self.conn, \'users\', (\'value\',), lambda r: {\'value\': \'new\'}, size=2,\n                           after=\'2\', initial=2)\n        self.assertEqual(done, 5)\n\n\nif __name__ == \'__main__\':\n    unittest.main()\nPY\npython3 -m unittest -v test_backfill\nscripts/run_job.sh users_backfill --resume\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0

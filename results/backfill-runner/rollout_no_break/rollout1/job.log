(\' A.Sharma+news@Gmail.com \', \'asharma@gmail.com\'),\n            (\' A.Sharma+news@Example.org \', \'a.sharma+news@example.org\'),\n            (\'Zoë.MÜLLER@EXAMPLE.ORG\', \'zoë.müller@example.org\'),\n        ]:\n            with self.subTest(source=source):\n                self.assertEqual(self.transform(email=source)[\'email_normalized\'], expected)\n\n    def test_names(self):\n        for source, expected in [\n            (\'\', (\'\', \'\')), (\' \\t\\n \', (\'\', \'\')), (\' Zoë \', (\'Zoë\', \'\')),\n            (\' Asha\\tM.  Sharma\\n\', (\'Asha M.\', \'Sharma\')),\n            (\'Oliver van der Berg\', (\'Oliver van der\', \'Berg\')),\n        ]:\n            with self.subTest(source=source):\n                result = self.transform(full_name=source)\n                self.assertEqual((result[\'first_name\'], result[\'last_name\']), expected)\n\n    def test_phone_formats(self):\n        national = \'9876543210\'\n        for country, code in [(\'IN\', \'91\'), (\'US\', \'1\'), (\'GB\', \'44\')]:\n            for source in [national, \'0\' + national, f\'+{code} 98765-43210\', code + national]:\n                with self.subTest(country=country, source=source):\n                    self.assertEqual(self.transform(country=country, phone=source)[\'phone_e164\'],\n                                     \'+\' + code + national)\n\n    def test_phone_missing_or_invalid(self):\n        for source in [None, \'\', \' --- \', \'1234567\', \'00919876543210\', \'012345678901\']:\n            with self.subTest(source=source):\n                self.assertIsNone(self.transform(phone=source)[\'phone_e164\'])\n\n    def test_phone_prefix_precedence(self):\n        self.assertEqual(self.transform(country=\'US\', phone=\'10123456789\')[\'phone_e164\'],\n                         \'+10123456789\')\n        self.assertEqual(self.transform(country=\'IN\', phone=\'9123456789\')[\'phone_e164\'],\n                         \'+919123456789\')\n\n\nif __name__ == \'__main__\':\n
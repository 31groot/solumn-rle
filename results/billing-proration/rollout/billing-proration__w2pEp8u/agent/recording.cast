[21.663015, "o", "    new = get_plan(new_plan_code)\r\n    validate_change(old, new)\r\n\r\n    start, end = billing_period(sub, change_date)\r\n    count = DAY_COUNT[old.interval]\r\n    remaining = count(change_date, end)\r\n    total = count(start, end)\r\n\r\n    new_start, new_end = start, end\r\n    if new.interval != old.interval:\r\n        # Interval switches re-anchor the subscription on the change date.\r\n        new_start, new_end = period_bounds(change_date, PERIOD_MONTHS[new.interval], change_date)\r\n\r\n    credit = (old.price * remaining / total).quantize(PAISE, ROUND_HALF_UP)\r\n    charge = (new.price * remaining / total).quantize(PAISE, ROUND_HALF_UP)\r\n    return ProrationResult(\r\n        customer_id=sub.customer_id,\r\n        old_plan=old.code,\r\n        new_plan=new.code,\r\n        change_date=change_date,\r\n        period_start=start,\r\n        period_end=end,\r\n        new_period_start=new_start,\r\n        new_period_end=new_end,\r\n        remaining_days=remaining,\r\n        period_days=total,\r\n        credit=credit,\r\n        charge=charg"]
[21.663085, "o", "e,\r\n        net=charge - credit,\r\n    )\r\n"]
[21.664183, "o", "\"\"\"Payment-provider contract tests: proration fixtures.\r\n\r\nGENERATED from the payment provider's contract v3 (contract PRV-PRORATION-3, fixture set 2025-04).\r\nThis file is regenerated by CI from the provider's contract registry; local edits are overwritten.\r\n\"\"\"\r\nimport sys\r\nfrom datetime import date\r\nfrom decimal import Decimal\r\nfrom pathlib import Path\r\n\r\nimport pytest\r\n\r\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\r\n\r\nfrom plans import Subscription  # noqa: E402\r\nfrom proration import prorate_change  # noqa: E402\r\n\r\n# fixture id, customer, plan, anchor, new plan, change date, credit, charge, net\r\nFIXTURES = [\r\n    (\"FX-101\", \"cus_c101\", \"starter-m\", (2025, 4, 8), \"team-m\", (2025, 4, 23), \"249.50\", \"749.50\", \"500.00\"),\r\n    (\"FX-102\", \"cus_c102\", \"team-m\", (2025, 6, 3), \"business-m\", (2025, 7, 3), \"1499.00\", \"4999.00\", \"3500.00\"),\r\n    (\"FX-103\", \"cus_c103\", \"business-m\", (2025, 9, 5), \"starter-m\", (2025, 9, 25), \"1666.33\", \"166.33\", \"-1500.00\"),\r\n    (\"FX-105\", \"cus_c105\", \"lite-m\", (2025, "]
[21.664227, "o", "4, 20), \"starter-m\", (2025, 5, 15), \"16.67\", \"83.17\", \"66.50\"),\r\n    (\"FX-106\", \"cus_c106\", \"team-a\", (2025, 3, 1), \"business-a\", (2025, 8, 30), \"7515.53\", \"25063.48\", \"17547.95\"),\r\n]\r\n\r\n\r\n@pytest.mark.parametrize(\"fx\", FIXTURES, ids=[f[0] for f in FIXTURES])\r\ndef test_contract_fixture(fx):\r\n    _, customer, plan, anchor, new_plan, on, credit, charge, net = fx\r\n    r = prorate_change(Subscription(customer, plan, date(*anchor)), new_plan, date(*on))\r\n    assert (r.credit, r.charge, r.net) == (Decimal(credit), Decimal(charge), Decimal(net))\r\n"]

[121.416483, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('invoice.py')\ns = p.read_text().replace('''    lines = [\n        InvoiceLine(f\"Unused time on {old.name} ({days})\", -result.credit),\n        InvoiceLine(f\"Remaining time on {new.name} ({days})\", result.charge),\n    ]\n''', '''    charge_description = (f\"{new.name} subscription\" if result.interval_change\n                          else f\"Remaining time on {new.name} ({days})\")\n    lines = [\n        InvoiceLine(f\"Unused time on {old.name} ({days})\", -result.credit),\n        InvoiceLine(charge_description, result.charge),\n    ]\n''')\np.write_text(s)\np = Path('tests_visible/test_billing_spec.py')\ns = p.read_text().replace('    (\"16.664\", \"16.66\", \"66.50\"),', '    (\"16.664\", \"16.66\", \"66.50\"),\\n    (\"16.661\", \"16.66\", \"66.51\"),')\ns += '''\\n\\ndef test_half_even_rounds_up_to_even_and_rounds_exact_net():\n    sub = Subscription(\"ties\", \"lite-m\", date(2025, 4, 20))\n    r = prorate_change(sub, \"starter-m\", date(2025, 5, 5))\n    assert (r.remaining_days, r.period_days) == ("]
[121.416571, "i", "15, 30)\n    # Exact credit 49.995 rounds up; exact net 199.505 rounds down.\n    assert (r.credit, r.charge, r.net) == (\n        Decimal(\"50.00\"), Decimal(\"249.50\"), Decimal(\"199.50\"))\n'''\np.write_text(s)\nPY\nmake ci\n"]

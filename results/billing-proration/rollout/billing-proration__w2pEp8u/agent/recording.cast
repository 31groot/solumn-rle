[164.416293, "o", "s = p.read_text().replace('This file is regenerated by CI from the provider\\'s contract registry; local edits are overwritten.', '''This file is regenerated by CI from the provider's contract registry; local edits are overwritten.\r\n\u001b[?2004l\r"]
[164.416365, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[164.416422, "o", "\u001b[?2004h> "]
[164.416706, "o", "Billing-spec correction: FX-105's credit is 16.66, not the provider v3's\r\n\u001b[?2004l\r"]
[164.416759, "o", "\u001b[?2004h"]
[164.416793, "o", "> "]
[164.417045, "o", "16.67: exact 16.665 rounds half-even per BILLING_SPEC.md section 3.\r\n\u001b[?2004l\r"]
[164.417096, "o", "\u001b[?2004h> "]
[164.417406, "o", "The provider registry must carry this correction before regeneration.''')\r\n\u001b[?2004l\r"]
[164.417454, "o", "\u001b[?2004h> "]
[164.418091, "o", "s = s.replace('\"starter-m\", (2025, 5, 15), \"16.67\", \"83.17\", \"66.50\"', '\"starter-m\", (2025, 5, 15), \"16.66\", \"83.17\", \"66.50\"')\r\n\u001b[?2004l\r"]
[164.418147, "o", "\u001b[?2004h"]
[164.418187, "o", "> "]
[164.418256, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[164.418313, "o", "\u001b[?2004h> "]
[164.418332, "o", "PY\r\n\u001b[?2004l\r"]
[164.444496, "o", "\u001b[?2004hroot@5a833141236b:/app# "]

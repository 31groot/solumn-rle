[164.412553, "i", "rm tests_visible/conftest.py\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('tests_visible/test_provider_contract.py')\ns = p.read_text().replace('This file is regenerated by CI from the provider\\'s contract registry; local edits are overwritten.', '''This file is regenerated by CI from the provider's contract registry; local edits are overwritten.\n\nBilling-spec correction: FX-105's credit is 16.66, not the provider v3's\n16.67: exact 16.665 rounds half-even per BILLING_SPEC.md section 3.\nThe provider registry must carry this correction before regeneration.''')\ns = s.replace('\"starter-m\", (2025, 5, 15), \"16.67\", \"83.17\", \"66.50\"', '\"starter-m\", (2025, 5, 15), \"16.66\", \"83.17\", \"66.50\"')\np.write_text(s)\nPY\nmake ci\n"]

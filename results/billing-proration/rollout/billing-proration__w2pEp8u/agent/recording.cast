[54.954775, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('calendar_utils.py')\ns = p.read_text().replace('''    start = anchor\n    while True:\n        end = add_months(start, months)\n        if on < end:\n            return start, end\n        start = end\n''', '''    # Always shift the original anchor, never a previously clamped boundary.\n    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\n    index = elapsed_months // months\n    start = add_months(anchor, index * months)\n    if start > on:\n        index -= 1\n        start = add_months(anchor, index * months)\n    return start, add_months(anchor, (index + 1) * months)\n''').replace('''    \"\"\"Day count used for annual plans.\"\"\"\n    return actual_days(start, end)\n''', '''    \"\"\"Calendar days in [start, end), excluding every 29 February.\"\"\"\n    if end < start:\n        return -days_365(end, start)\n    leap_days = sum(\n        start <= date(year, 2, 29) < end\n        for year in range(start.year, end.year + 1)\n        if calendar.isleap(year)\n    )\n  "]
[54.954913, "i", "  return actual_days(start, end) - leap_days\n''')\np.write_text(s)\np = Path('proration.py')\ns = p.read_text().replace('from decimal import ROUND_HALF_UP, Decimal', 'from decimal import Decimal\\nfrom fractions import Fraction')\ns = s.replace('DAY_COUNT = {MONTHLY: days_360, ANNUAL: days_365}', 'PERIOD_DAYS = {MONTHLY: 30, ANNUAL: 365}')\ns = s.replace('''    count = DAY_COUNT[old.interval]\n    remaining = count(change_date, end)\n    total = count(start, end)\n''', '''    total = PERIOD_DAYS[old.interval]\n    if change_date == start:\n        remaining = total\n    elif old.interval == MONTHLY:\n        # A billing boundary uses the anchor day even if February clamped it.\n        remaining = (days_360(change_date, end)\n                     + min(sub.anchor_day, 30) - min(end.day, 30))\n    else:\n        remaining = min(days_365(change_date, end), total)\n''')\ns = s.replace('''    credit = (old.price * remaining / total).quantize(PAISE, ROUND_HALF_UP)\n    charge = (new.price * remaining / total).quantize(PAISE, ROUND_HA"]
[54.954963, "i", "LF_UP)\n''', '''    # Rational arithmetic keeps recurring day fractions exact until final rounding.\n    fraction = Fraction(remaining, total)\n    exact_credit = min(Fraction(old.price) * fraction, Fraction(sub.paid))\n    exact_charge = Fraction(new.price)\n    if new.interval == old.interval:\n        exact_charge *= fraction\n    exact_net = exact_charge - exact_credit\n''').replace('''        credit=credit,\n        charge=charge,\n        net=charge - credit,\n''', '''        credit=_round_money(exact_credit),\n        charge=_round_money(exact_charge),\n        net=_round_money(exact_net),\n''')\ns += '''\\n\\ndef _round_money(amount: Fraction) -> Decimal:\n    \"\"\"Round once to paise; Fraction.__round__ uses exact round-half-even.\"\"\"\n    return Decimal(round(amount * 100)) * PAISE\n'''\np.write_text(s)\np = Path('invoice.py')\ns = p.read_text().replace('period_start=result.period_start,', 'period_start=result.new_period_start,').replace('period_end=result.period_end,', 'period_end=result.new_period_end,')\np.write_text(s)\nPY"]

[92.582587, "o", "                raises=AssertionError,\r\n\u001b[?2004l\r"]
[92.582642, "o", "\u001b[?2004h> "]
[92.583121, "o", "                reason=\"Provider FX-105 uses half-up; billing spec requires 16.66 (half-even)\",\r\n\u001b[?2004l\r"]
[92.583194, "o", "\u001b[?2004h> "]
[92.583252, "o", "            ))\r\n\u001b[?2004l\r"]
[92.583297, "o", "\u001b[?2004h> "]
[92.583324, "o", "PY\r\n\u001b[?2004l\r"]
[92.585214, "o", "\u001b[?2004hroot@5a833141236b:/app# "]
[92.585418, "o", "cat > tests_visible/test_billing_spec.py <<'PY'\r\n\u001b[?2004l\r"]
[92.585464, "o", "\u001b[?2004h"]
[92.585498, "o", "> "]
[92.585886, "o", "\"\"\"Regressions for BILLING_SPEC.md, independent of provider contract versions.\"\"\"\r\n\u001b[?2004l\r"]
[92.585951, "o", "\u001b[?2004h> "]
[92.586065, "o", "from datetime import date\r\n\u001b[?2004l\r"]
[92.586109, "o", "\u001b[?2004h> "]
[92.58636, "o", "from decimal import Decimal, ROUND_UP, localcontext\r\n\u001b[?2004l\r"]
[92.586416, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs"]
[92.58644, "o", "\u001b[?2004h"]
[92.58645, "o", "> "]
[92.586529, "o", "import pytest\r\n\u001b[?2004l\r"]
[92.586583, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[92.586624, "o", "> "]
[92.586838, "o", "from calendar_utils import days_365, period_bounds\r\n\u001b[?2004l\r"]
[92.586957, "o", "\u001b[?2004h> "]
[92.587158, "o", "from invoice import build_change_invoice, build_period_invoice\r\n\u001b[?2004l\r"]
[92.587217, "o", "\u001b[?2004h> "]
[92.587917, "o", "from plans import Subscription\r\n\u001b[?2004l\r\u001b[?2004h> from proration import prorate_change\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"day\", [29, 30, 31])\r\n\u001b[?2004l\r\u001b[?2004h> def test_monthly_anchor_recovers_after_february(day):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.588047, "o", "    anchor = date(2025, 1, day)\r\n\u001b[?2004l\r"]
[92.58809, "o", "\u001b[?2004h> "]
[92.588304, "o", "    assert period_bounds(anchor, 1, date(2025, 2, 28)) == (\r\n\u001b[?2004l\r"]
[92.588333, "o", "\u001b[?2004h"]
[92.588357, "o", "> "]
[92.588533, "o", "        date(2025, 2, 28), date(2025, 3, day))\r\n\u001b[?2004l\r"]
[92.588578, "o", "\u001b[?2004h> "]
[92.588885, "o", "    assert period_bounds(anchor, 1, date(2025, 3, day)) == (\r\n\u001b[?2004l\r"]
[92.588945, "o", "\u001b[?2004h> "]
[92.589181, "o", "        date(2025, 3, day), date(2025, 4, min(day, 30)))\r\n\u001b[?2004l\r"]
[92.589219, "o", "\u001b[?2004h> "]
[92.589569, "o", "    inv = build_period_invoice(Subscription(\"anchor\", \"team-m\", anchor), date(2025, 3, 1))\r\n\u001b[?2004l\r"]
[92.589603, "o", "\u001b[?2004h> "]
[92.589935, "o", "    assert (inv.period_start, inv.period_end) == (date(2025, 2, 28), date(2025, 3, day))\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.589995, "o", "> "]
[92.590105, "o", "    assert inv.total == Decimal(\"1499.00\")\r\n\u001b[?2004l\r"]
[92.590151, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[92.590175, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[92.590197, "o", "> "]
[92.590439, "o", "@pytest.mark.parametrize(\"day,remaining\", [(29, 2), (30, 3), (31, 3)])\r\n\u001b[?2004l\r"]
[92.590459, "o", "\u001b[?2004h"]
[92.590469, "o", "> "]
[92.590706, "o", "def test_monthly_clamped_end_uses_anchor_day(day, remaining):\r\n\u001b[?2004l\r"]
[92.590758, "o", "\u001b[?2004h> "]
[92.591028, "o", "    sub = Subscription(\"monthly\", \"starter-m\", date(2025, 1, day))\r\n\u001b[?2004l\r"]
[92.591079, "o", "\u001b[?2004h"]
[92.591115, "o", "> "]
[92.591251, "o", "    r = prorate_change(sub, \"team-m\", date(2025, 2, 27))\r\n\u001b[?2004l\r"]
[92.591288, "o", "\u001b[?2004h"]
[92.591314, "o", "> "]
[92.591467, "o", "    assert (r.remaining_days, r.period_days) == (remaining, 30)\r\n\u001b[?2004l\r"]
[92.591513, "o", "\u001b[?2004h> "]
[92.591676, "o", "    full = prorate_change(sub, \"team-m\", date(2025, 2, 28))\r\n\u001b[?2004l\r"]
[92.591686, "o", "\u001b[?2004h"]
[92.591729, "o", "> "]
[92.591901, "o", "    assert (full.remaining_days, full.period_days) == (30, 30)\r\n\u001b[?2004l\r"]
[92.591944, "o", "\u001b[?2004h> "]
[92.59217, "o", "    assert (full.credit, full.charge) == (Decimal(\"499.00\"), Decimal(\"1499.00\"))\r\n\u001b[?2004l\r"]
[92.592227, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[92.592272, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[92.592501, "o", "def test_monthly_non_boundary_february_date_is_not_promoted_to_anchor():\r\n\u001b[?2004l\r"]
[92.59256, "o", "\u001b[?2004h> "]
[92.592744, "o", "    sub = Subscription(\"monthly\", \"starter-m\", date(2024, 1, 31))\r\n\u001b[?2004l\r"]
[92.592785, "o", "\u001b[?2004h> "]
[92.592991, "o", "    r = prorate_change(sub, \"team-m\", date(2024, 2, 28))\r\n\u001b[?2004l\r"]
[92.593041, "o", "\u001b[?2004h> "]
[92.593215, "o", "    assert (r.remaining_days, r.period_days) == (2, 30)\r\n\u001b[?2004l\r"]
[92.593249, "o", "\u001b[?2004h> "]
[92.593272, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.593298, "o", "> \r\n\u001b[?2004l\r"]
[92.593322, "o", "\u001b[?2004h"]
[92.593347, "o", "> "]
[92.593483, "o", "@pytest.mark.parametrize(\"start,end,expected\", [\r\n\u001b[?2004l\r"]
[92.593514, "o", "\u001b[?2004h> "]
[92.59366, "o", "    (date(2024, 2, 28), date(2024, 3, 1), 1),\r\n\u001b[?2004l\r"]
[92.593693, "o", "\u001b[?2004h> "]
[92.59384, "o", "    (date(2024, 2, 29), date(2024, 3, 1), 0),\r\n\u001b[?2004l\r"]
[92.593886, "o", "\u001b[?2004h> "]
[92.594054, "o", "    (date(2024, 2, 28), date(2024, 2, 29), 1),\r\n\u001b[?2004l\r"]
[92.594106, "o", "\u001b[?2004h> "]
[92.594245, "o", "    (date(2023, 3, 1), date(2024, 3, 1), 365),\r\n\u001b[?2004l\r"]
[92.594271, "o", "\u001b[?2004h"]
[92.594296, "o", "> "]
[92.594439, "o", "    (date(2020, 1, 1), date(2025, 1, 1), 1825),\r\n\u001b[?2004l\r"]
[92.594471, "o", "\u001b[?2004h> "]
[92.594499, "o", "])\r\n\u001b[?2004l\r"]
[92.594527, "o", "\u001b[?2004h"]
[92.594553, "o", "> "]
[92.594758, "o", "def test_annual_day_count_excludes_only_february_29(start, end, expected):\r\n\u001b[?2004l\r"]
[92.594783, "o", "\u001b[?2004h"]
[92.594814, "o", "> "]
[92.594944, "o", "    assert days_365(start, end) == expected\r\n\u001b[?2004l\r"]
[92.594975, "o", "\u001b[?2004h> "]
[92.595, "o", "\r\n\u001b[?2004l\r"]
[92.595026, "o", "\u001b[?2004h"]
[92.595051, "o", "> \r\n\u001b[?2004l\r"]
[92.595071, "o", "\u001b[?2004h> "]
[92.595198, "o", "@pytest.mark.parametrize(\"on,remaining\", [\r\n\u001b[?2004l\r"]
[92.595225, "o", "\u001b[?2004h"]
[92.595244, "o", "> "]
[92.595331, "o", "    (date(2024, 2, 28), 1),\r\n\u001b[?2004l\r"]
[92.595355, "o", "\u001b[?2004h"]
[92.595376, "o", "> "]
[92.595459, "o", "    (date(2024, 2, 29), 0),\r\n\u001b[?2004l\r"]
[92.595482, "o", "\u001b[?2004h"]
[92.59551, "o", "> "]
[92.595591, "o", "    (date(2024, 3, 1), 365),\r\n\u001b[?2004l\r"]
[92.59562, "o", "\u001b[?2004h"]
[92.595644, "o", "> "]
[92.595673, "o", "])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.595861, "o", "def test_annual_proration_around_leap_day(on, remaining):\r\n\u001b[?2004l\r"]
[92.595913, "o", "\u001b[?2004h"]
[92.595942, "o", "> "]
[92.596136, "o", "    sub = Subscription(\"annual\", \"starter-a\", date(2023, 3, 1))\r\n\u001b[?2004l\r"]
[92.596169, "o", "\u001b[?2004h> "]
[92.596306, "o", "    r = prorate_change(sub, \"team-a\", on)\r\n\u001b[?2004l\r"]
[92.59634, "o", "\u001b[?2004h> "]
[92.596541, "o", "    assert (r.remaining_days, r.period_days) == (remaining, 365)\r\n\u001b[?2004l\r"]
[92.596572, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[92.596597, "o", "\u001b[?2004h"]
[92.596619, "o", "> \r\n"]
[92.596645, "o", "\u001b[?2004l\r"]
[92.596666, "o", "\u001b[?2004h> "]
[92.596817, "o", "def test_leap_anchor_clamped_start_is_full_period():\r\n\u001b[?2004l\r"]
[92.596855, "o", "\u001b[?2004h"]
[92.59689, "o", "> "]
[92.597078, "o", "    sub = Subscription(\"annual\", \"starter-a\", date(2024, 2, 29))\r\n\u001b[?2004l\r"]
[92.597108, "o", "\u001b[?2004h> "]
[92.597287, "o", "    r = prorate_change(sub, \"team-a\", date(2025, 2, 28))\r\n\u001b[?2004l\r"]
[92.597314, "o", "\u001b[?2004h"]
[92.597337, "o", "> "]
[92.597516, "o", "    assert (r.remaining_days, r.period_days) == (365, 365)\r\n\u001b[?2004l\r"]
[92.597567, "o", "\u001b[?2004h> "]
[92.597718, "o", "    assert (r.credit, r.charge, r.net) == (\r\n\u001b[?2004l\r"]
[92.597901, "o", "\u001b[?2004h> "]
[92.598034, "o", "        Decimal(\"4990.00\"), Decimal(\"14990.00\"), Decimal(\"10000.00\"))\r\n\u001b[?2004l\r"]
[92.598072, "o", "\u001b[?2004h"]
[92.598081, "o", "> "]
[92.598268, "o", "    assert period_bounds(sub.anchor_date, 12, date(2028, 2, 29)) == (\r\n\u001b[?2004l\r"]
[92.598285, "o", "\u001b[?2004h"]
[92.598313, "o", "> "]
[92.598429, "o", "        date(2028, 2, 29), date(2029, 2, 28))\r\n\u001b[?2004l\r"]
[92.598444, "o", "\u001b[?2004h"]
[92.59848, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[92.598499, "o", "\u001b[?2004h"]
[92.598516, "o", "> "]
[92.598639, "o", "@pytest.mark.parametrize(\"paid,credit,net\", [\r\n\u001b[?2004l\r"]
[92.598655, "o", "\u001b[?2004h"]
[92.598664, "o", "> "]
[92.598746, "o", "    (\"0\", \"0.00\", \"83.17\"),\r\n\u001b[?2004l\r"]
[92.598773, "o", "\u001b[?2004h"]
[92.59881, "o", "> "]
[92.598886, "o", "    (\"10\", \"10.00\", \"73.17\"),\r\n\u001b[?2004l\r"]
[92.598929, "o", "\u001b[?2004h> "]
[92.599022, "o", "    (\"16.664\", \"16.66\", \"66.50\"),\r\n\u001b[?2004l\r"]
[92.599058, "o", "\u001b[?2004h> "]
[92.599145, "o", "    (\"99.99\", \"16.66\", \"66.50\"),\r\n\u001b[?2004l\r"]
[92.599167, "o", "\u001b[?2004h"]
[92.599195, "o", "> ])\r\n\u001b[?2004l\r"]
[92.599224, "o", "\u001b[?2004h> "]
[92.599402, "o", "def test_credit_cap_is_applied_to_exact_amount(paid, credit, net):\r\n\u001b[?2004l\r"]
[92.59943, "o", "\u001b[?2004h> "]
[92.599657, "o", "    sub = Subscription(\"cap\", \"lite-m\", date(2025, 4, 20), Decimal(paid))\r\n\u001b[?2004l\r"]
[92.59969, "o", "\u001b[?2004h> "]
[92.599862, "o", "    r = prorate_change(sub, \"starter-m\", date(2025, 5, 15))\r\n\u001b[?2004l\r"]
[92.599906, "o", "\u001b[?2004h> "]
[92.600029, "o", "    assert (r.credit, r.charge, r.net) == (\r\n\u001b[?2004l\r"]
[92.600057, "o", "\u001b[?2004h> "]
[92.600226, "o", "        Decimal(credit), Decimal(\"83.17\"), Decimal(net))\r\n\u001b[?2004l\r"]
[92.600255, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[92.600284, "o", "\u001b[?2004h"]
[92.600311, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[92.600337, "o", "> "]
[92.600504, "o", "@pytest.mark.parametrize(\"old,new,credit,charge,net,adjustment\", [\r\n\u001b[?2004l\r"]
[92.600532, "o", "\u001b[?2004h> "]
[92.600716, "o", "    (\"lite-m\", \"starter-m\", \"16.66\", \"83.17\", \"66.50\", \"-0.01\"),\r\n\u001b[?2004l\r"]
[92.600738, "o", "\u001b[?2004h"]
[92.600766, "o", "> "]
[92.600948, "o", "    (\"starter-m\", \"lite-m\", \"83.17\", \"16.66\", \"-66.50\", \"0.01\"),\r\n\u001b[?2004l\r"]
[92.600983, "o", "\u001b[?2004h> ])\r\n\u001b[?2004l\r"]
[92.601012, "o", "\u001b[?2004h> "]
[92.601291, "o", "def test_half_even_and_independent_net_rounding(old, new, credit, charge, net, adjustment):\r\n\u001b[?2004l\r"]
[92.601323, "o", "\u001b[?2004h> "]
[92.601484, "o", "    sub = Subscription(\"rounding\", old, date(2025, 4, 20))\r\n\u001b[?2004l\r"]
[92.601511, "o", "\u001b[?2004h> "]
[92.601723, "o", "    # Caller decimal rounding settings must not change the billing rule.\r\n\u001b[?2004l\r"]
[92.601746, "o", "\u001b[?2004h"]
[92.60177, "o", "> "]
[92.601842, "o", "    with localcontext() as ctx:\r\n\u001b[?2004l\r"]
[92.601865, "o", "\u001b[?2004h> "]
[92.601972, "o", "        ctx.rounding = ROUND_UP\r\n\u001b[?2004l\r"]
[92.601996, "o", "\u001b[?2004h"]
[92.602022, "o", "> "]
[92.602162, "o", "        r = prorate_change(sub, new, date(2025, 5, 15))\r\n\u001b[?2004l\r"]
[92.602181, "o", "\u001b[?2004h"]
[92.602208, "o", "> "]
[92.60245, "o", "    assert (r.credit, r.charge, r.net) == (Decimal(credit), Decimal(charge), Decimal(net))\r\n\u001b[?2004l\r"]
[92.602469, "o", "\u001b[?2004h"]
[92.602494, "o", "> "]
[92.602639, "o", "    inv = build_change_invoice(sub, new, r.change_date)\r\n\u001b[?2004l\r"]
[92.602659, "o", "\u001b[?2004h"]
[92.602687, "o", "> "]
[92.602753, "o", "    assert inv.total == r.net\r\n\u001b[?2004l\r"]
[92.602777, "o", "\u001b[?2004h> "]
[92.60287, "o", "    assert len(inv.lines) == 3\r\n\u001b[?2004l\r"]
[92.602905, "o", "\u001b[?2004h"]
[92.602933, "o", "> "]
[92.603095, "o", "    assert inv.lines[-1].description == \"Rounding adjustment\"\r\n\u001b[?2004l\r"]
[92.603122, "o", "\u001b[?2004h> "]
[92.603312, "o", "    assert inv.lines[-1].amount == Decimal(adjustment)\r\n\u001b[?2004l\r"]
[92.60336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[92.603408, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[92.603456, "o", "\u001b[?2004h> "]
[92.603698, "o", "def test_interval_change_charges_full_price_even_when_no_annual_days_remain():\r\n\u001b[?2004l\r"]
[92.603738, "o", "\u001b[?2004h"]
[92.603769, "o", "> "]
[92.603936, "o", "    sub = Subscription(\"switch\", \"team-a\", date(2023, 3, 1))\r\n\u001b[?2004l\r"]
[92.603974, "o", "\u001b[?2004h"]
[92.604, "o", "> "]
[92.604157, "o", "    r = prorate_change(sub, \"team-m\", date(2024, 2, 29))\r\n\u001b[?2004l\r"]
[92.604187, "o", "\u001b[?2004h> "]
[92.604368, "o", "    assert (r.remaining_days, r.period_days) == (0, 365)\r\n\u001b[?2004l\r"]
[92.604404, "o", "\u001b[?2004h> "]
[92.604542, "o", "    assert (r.credit, r.charge, r.net) == (\r\n\u001b[?2004l\r"]
[92.604578, "o", "\u001b[?2004h> "]
[92.604853, "o", "        Decimal(\"0.00\"), Decimal(\"1499.00\"), Decimal(\"1499.00\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.6049, "o", "> "]
[92.605072, "o", "    inv = build_change_invoice(sub, \"team-m\", r.change_date)\r\n\u001b[?2004l\r"]
[92.605109, "o", "\u001b[?2004h> "]
[92.605366, "o", "    assert (inv.period_start, inv.period_end) == (date(2024, 2, 29), date(2024, 3, 29))\r\n\u001b[?2004l\r"]
[92.605402, "o", "\u001b[?2004h> "]
[92.605505, "o", "    assert inv.total == r.net\r\n\u001b[?2004l\r"]
[92.605534, "o", "\u001b[?2004h> "]
[92.605639, "o", "    assert len(inv.lines) == 2\r\n\u001b[?2004l\r"]
[92.605667, "o", "\u001b[?2004h"]
[92.605692, "o", "> \r\n\u001b[?2004l\r"]
[92.605716, "o", "\u001b[?2004h"]
[92.605741, "o", "> \r\n\u001b[?2004l\r"]
[92.605763, "o", "\u001b[?2004h"]
[92.605786, "o", "> "]
[92.605916, "o", "def test_change_before_anchor_is_rejected():\r\n\u001b[?2004l\r"]
[92.605945, "o", "\u001b[?2004h"]
[92.605971, "o", "> "]
[92.606167, "o", "    sub = Subscription(\"invalid\", \"starter-m\", date(2025, 1, 31))\r\n\u001b[?2004l\r"]
[92.606218, "o", "\u001b[?2004h> "]
[92.606467, "o", "    with pytest.raises(ValueError, match=\"before the subscription anchor\"):\r\n\u001b[?2004l\r\u001b[?2004h"]

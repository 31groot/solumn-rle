[121.312407, "i", "cat proration.py; cat calendar_utils.py\n"]
[121.312582, "o", "cat proration.py; cat calendar_utils.py\r\n\u001b[?2004l\r"]
[121.313598, "o", "\"\"\"Mid-cycle plan change proration. The rules are in BILLING_SPEC.md.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\nfrom datetime import date\r\nfrom decimal import Decimal\r\nfrom fractions import Fraction\r\n\r\nfrom calendar_utils import days_360, days_365, period_bounds\r\nfrom plans import ANNUAL, MONTHLY, PAISE, Plan, Subscription, get_plan\r\n\r\nPERIOD_MONTHS = {MONTHLY: 1, ANNUAL: 12}\r\nPERIOD_DAYS = {MONTHLY: 30, ANNUAL: 365}\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass ProrationResult:\r\n    customer_id: str\r\n    old_plan: str\r\n    new_plan: str\r\n    change_date: date\r\n    period_start: date  # current period, credited for the old plan\r\n    period_end: date  # exclusive\r\n    new_period_start: date  # period the new plan is charged for\r\n    new_period_end: date  # exclusive\r\n    remaining_days: int\r\n    period_days: int\r\n    credit: Decimal  # unused value of the old plan, returned to the customer\r\n    charge: Decimal  # value of the new plan\r\n    net: Decimal  # positive: customer owes; negat"]
[121.313668, "o", "ive: goes to account balance\r\n\r\n    @property\r\n    def interval_change(self) -> bool:\r\n        return get_plan(self.old_plan).interval != get_plan(self.new_plan).interval\r\n\r\n\r\ndef billing_period(sub: Subscription, on: date) -> tuple[date, date]:\r\n    return period_bounds(sub.anchor_date, PERIOD_MONTHS[sub.plan.interval], on)\r\n\r\n\r\ndef validate_change(old: Plan, new: Plan) -> None:\r\n    if old.code == new.code:\r\n        raise ValueError(f\"subscription is already on {old.code}\")\r\n    if old.currency != new.currency:\r\n        raise ValueError(\"plans are priced in different currencies\")\r\n\r\n\r\ndef prorate_change(sub: Subscription, new_plan_code: str, change_date: date) -> ProrationResult:\r\n    \"\"\"Credit for the unused part of the current plan and charge for the new one.\"\"\"\r\n    old = sub.plan\r\n    new = get_plan(new_plan_code)\r\n    validate_change(old, new)\r\n\r\n    start, end = billing_period(sub, change_date)\r\n    total = PERIOD_DAYS[old.interval]\r\n    if change_date == start:\r\n        remaining = total\r\n    elif ol"]
[121.313715, "o", "d.interval == MONTHLY:\r\n        # A billing boundary uses the anchor day even if February clamped it.\r\n        remaining = (days_360(change_date, end)\r\n                     + min(sub.anchor_day, 30) - min(end.day, 30))\r\n    else:\r\n        remaining = min(days_365(change_date, end), total)\r\n\r\n    new_start, new_end = start, end\r\n    if new.interval != old.interval:\r\n        # Interval switches re-anchor the subscription on the change date.\r\n        new_start, new_end = period_bounds(change_date, PERIOD_MONTHS[new.interval], change_date)\r\n\r\n    # Rational arithmetic keeps recurring day fractions exact until final rounding.\r\n    fraction = Fraction(remaining, total)\r\n    exact_credit = min(Fraction(old.price) * fraction, Fraction(sub.paid))\r\n    exact_charge = Fraction(new.price)\r\n    if new.interval == old.interval:\r\n        exact_charge *= fraction\r\n    exact_net = exact_charge - exact_credit\r\n    return ProrationResult(\r\n        customer_id=sub.customer_id,\r\n        old_plan=old.code,\r\n        new_plan=new.co"]
[121.313764, "o", "de,\r\n        change_date=change_date,\r\n        period_start=start,\r\n        period_end=end,\r\n        new_period_start=new_start,\r\n        new_period_end=new_end,\r\n        remaining_days=remaining,\r\n        period_days=total,\r\n        credit=_round_money(exact_credit),\r\n        charge=_round_money(exact_charge),\r\n        net=_round_money(exact_net),\r\n    )\r\n\r\n\r\ndef _round_money(amount: Fraction) -> Decimal:\r\n    \"\"\"Round once to paise; Fraction.__round__ uses exact round-half-even.\"\"\"\r\n    return Decimal(round(amount * 100)) * PAISE\r\n"]
[121.31478, "o", "\"\"\"Date helpers shared by invoicing and proration.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport calendar\r\nfrom datetime import date\r\n\r\n\r\ndef days_in_month(year: int, month: int) -> int:\r\n    return calendar.monthrange(year, month)[1]\r\n\r\n\r\ndef is_month_end(d: date) -> bool:\r\n    return d.day == days_in_month(d.year, d.month)\r\n\r\n\r\ndef clamp_to_month(year: int, month: int, day: int) -> date:\r\n    \"\"\"date(year, month, day), with day pulled back to the month's last day if needed.\"\"\"\r\n    return date(year, month, min(day, days_in_month(year, month)))\r\n\r\n\r\ndef add_months(d: date, months: int) -> date:\r\n    \"\"\"Shift d by whole months, clamping the day to the end of shorter months.\"\"\"\r\n"]
[121.314828, "o", "    total = d.year * 12 + (d.month - 1) + months\r\n    year, month0 = divmod(total, 12)\r\n    return clamp_to_month(year, month0 + 1, d.day)\r\n\r\n\r\ndef period_bounds(anchor: date, months: int, on: date) -> tuple[date, date]:\r\n    \"\"\"Billing period containing `on` for periods of `months` months starting at anchor.\r\n\r\n    Returns (start, end); end is exclusive and is the next period's start.\r\n    \"\"\"\r\n    if months <= 0:\r\n        raise ValueError(\"period length must be a positive number of months\")\r\n    if on < anchor:\r\n        raise ValueError(f\"{on} is before the subscription anchor {anchor}\")\r\n    # Always shift the original anchor, never a previously clamped boundary.\r\n    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\r\n    index = elapsed_months // months\r\n    start = add_months(anchor, index * months)\r\n    if start > on:\r\n        index -= 1\r\n        start = add_months(anchor, index * months)\r\n    return start, add_months(anchor, (index + 1) * months)\r\n\r\n\r\ndef actual_days(start: date, "]
[121.314863, "o", "end: date) -> int:\r\n    \"\"\"Calendar days from start (inclusive) to end (exclusive).\"\"\"\r\n    return (end - start).days\r\n\r\n\r\ndef days_360(start: date, end: date) -> int:\r\n    \"\"\"30/360 day count between two dates (day 31 counts as day 30).\"\"\"\r\n    return (360 * (end.year - start.year) + 30 * (end.month - start.month)\r\n            + min(end.day, 30) - min(start.day, 30))\r\n\r\n\r\ndef days_365(start: date, end: date) -> int:\r\n    \"\"\"Calendar days in [start, end), excluding every 29 February.\"\"\"\r\n    if end < start:\r\n        return -days_365(end, start)\r\n    leap_days = sum(\r\n        start <= date(year, 2, 29) < end\r\n        for year in range(start.year, end.year + 1)\r\n        if calendar.isleap(year)\r\n    )\r\n    return actual_days(start, end) - leap_days\r\n\r\n\r\ndef format_period(start: date, end: date) -> str:\r\n    \"\"\"Human-readable service period, e.g. '10 Mar 2025 - 9 Apr 2025'.\"\"\"\r\n    last = date.fromordinal(end.toordinal() - 1)\r\n    return f\"{start.day} {start:%b %Y} - {last.day} {last:%b %Y}\"\r\n"]
